<TcPlcObject Version="1.1.0.1">
  <DUT Name="E_LEDs_Mode" Id="{4e6b933a-6fd3-4a47-9b57-fc1433e59111}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE E_LEDs_Mode :
(
    OFF      := 0, // LED completely turned off
    ON       := 1, // LED continuously turned on
    FLASHING := 2  // LED flashing according to the blinker clock
);
END_TYPE]]></Declaration>
  </DUT>
