  <DUT Name="E_MachineState" Id="{ecf8f46a-4bcc-47dc-b028-e5bccf6fe083}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE E_MachineState :
(
	SYSTEM_POWER_UP			:= 0,
	STOPPED					:= 1,
	SYSTEM_INITIALISING		:= 2,
	SYSTEM_READY_TO_START	:= 3,
	SYSTEM_AUTO_CYCLE		:= 4,
	STOPPING				:= 5,
	MANUAL_MODE				:= 6,
	FAULT					:= 7,
	SAFETY					:=99
);
END_TYPE

]]></Declaration>
