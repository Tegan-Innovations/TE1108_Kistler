<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="ST_EL2809" Id="{3ac64aa4-72a2-4288-a236-e7fe613e08f5}">
    <Declaration><![CDATA[TYPE ST_EL2809 :
STRUCT
    sTerminalName       : STRING(80) := 'EL2809 | Channel Digital Output';
    
    // TwinSAFE physical hardware channels (Safe Outputs 1 to 4)
    bOutput             : ARRAY[1..4] OF BOOL;
    
    // Hardware status and diagnostic signals
    bError              : BOOL; // TRUE if a fault is detected (short-circuit, overload, or FSoE error)
    bReady              : BOOL; // TRUE if terminal is active and TwinSAFE communication is OK
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>