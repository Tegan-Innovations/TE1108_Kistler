<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="PRG_SafetyLogic" Id="{c1ae741e-7d84-482a-8ac0-230607928d2d}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM PRG_SafetyLogic
VAR
	bFaultRecoveryEnable  : BOOL := FALSE;
	
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =================================================================================
// SAFETY RESET ACK ERROR
// =================================================================================




// Outside the FAULT state, the recovery permission is not required.
IF GVL_MASTER.stMachineStatus.eMachineState <>
    E_MachineState.FAULT THEN

    bFaultRecoveryEnable := FALSE;


// During FAULT, keep the recovery permission active while
// the operator keeps the Reset button pressed.
ELSIF GVL_MASTER.i_bButtonReset
    AND NOT GVL_MASTER.i_bButtonEmergencyStop
    AND NOT GVL_MASTER.stPuckLocker.bUnexpectedRemovalFault THEN

    bFaultRecoveryEnable := TRUE;

END_IF;


// Update the standard PLC requests sent to TwinSAFE.
M_UpdateStandardSafetyRequests();


// Keep the reset request active while the operator is pressing
// the Reset button and the safety circuit is not yet ready.
GVL_IO.stSafety.bSafetyReset :=
    GVL_MASTER.i_bButtonReset
    AND NOT GVL_IO.stSafety.bSystemSafeOK;
// =================================================================================
// EMERGENCY STOP LOGIC 
// =================================================================================
	//GVL_IO.stSafety.bSafetyReset := GVL_MASTER.i_bButtonReset;

CASE GVL_Master.stMachineStatus.eMachineState OF


    E_MachineState.SYSTEM_POWER_UP:
	GVL_IO.stSafety.bMachineStopped := FALSE;
	GVL_IO.stSafety.bProcessTest := FALSE;
		
    E_MachineState.FAULT:
	GVL_IO.stSafety.bMachineStopped := TRUE;
	GVL_IO.stSafety.bAirSupplyEnabled := FALSE;
	GVL_IO.stSafety.bProcessTest := FALSE;

	E_MachineState.STOPPING:
	GVL_IO.stSafety.bMachineStopped := FALSE;
	GVL_IO.stSafety.bProcessTest := FALSE;
	
	E_MachineState.STOPPED:
	GVL_IO.stSafety.bMachineStopped := TRUE;
	GVL_IO.stSafety.bProcessTest := FALSE;

	E_MachineState.SYSTEM_INITIALISING:
	GVL_IO.stSafety.bMachineStopped := FALSE;
	GVL_IO.stSafety.bAirSupplyEnabled := TRUE;

	E_MachineState.SYSTEM_READY_TO_START:
	GVL_IO.stSafety.bMachineStopped := FALSE;
	GVL_IO.stSafety.bProcessTest := FALSE;
 
	E_MachineState.SYSTEM_AUTO_CYCLE:
    GVL_IO.stSafety.bMachineStopped := FALSE;
	GVL_IO.stSafety.bProcessTest := FALSE;
	
	E_MachineState.MANUAL_MODE:
    GVL_IO.stSafety.bMachineStopped := FALSE;
	GVL_IO.stSafety.bProcessTest := FALSE;



END_CASE


GVL_Master.stMachineStatus.bSystemPowerUp := (GVL_Master.stMachineStatus.eMachineState = E_MachineState.SYSTEM_POWER_UP);
GVL_Master.stMachineStatus.bInitialising  := (GVL_Master.stMachineStatus.eMachineState = E_MachineState.SYSTEM_INITIALISING);
GVL_Master.stMachineStatus.bStopped       := (GVL_Master.stMachineStatus.eMachineState = E_MachineState.STOPPED);
GVL_Master.stMachineStatus.bStopping      := (GVL_Master.stMachineStatus.eMachineState = E_MachineState.STOPPING);
GVL_Master.stMachineStatus.bAutoCycle     := (GVL_Master.stMachineStatus.eMachineState = E_MachineState.SYSTEM_AUTO_CYCLE);
GVL_Master.stMachineStatus.bFault         := (GVL_Master.stMachineStatus.eMachineState = E_MachineState.FAULT);
GVL_Master.stMachineStatus.bReadyToStart  := (GVL_Master.stMachineStatus.eMachineState = E_MachineState.SYSTEM_READY_TO_START);
GVL_Master.stMachineStatus.bManualMode  := (GVL_Master.stMachineStatus.eMachineState = E_MachineState.MANUAL_MODE);




]]></ST>
    </Implementation>
    <Method Name="M_UpdateStandardSafetyRequests" Id="{60095fda-4925-4acd-9935-b3d71e4a2736}">
      <Declaration><![CDATA[METHOD PRIVATE  M_UpdateStandardSafetyRequests
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// The Puck Locker fault remains latched even if the locker mode
// is changed to Disabled. Administrator acknowledgement is required
// before the standard PLC permits the safety system to recover.
//GVL_IO.stSafety.bSafetyRun := NOT GVL_MASTER.stPuckLocker.bUnexpectedRemovalFault;


GVL_IO.stSafety.bSafetyRun :=
    (
        GVL_MASTER.stMachineStatus.eMachineState <>
            E_MachineState.FAULT 
		OR bFaultRecoveryEnable
    )
    AND NOT GVL_MASTER.stPuckLocker.bUnexpectedRemovalFault;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>