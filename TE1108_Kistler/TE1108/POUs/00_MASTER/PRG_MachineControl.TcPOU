<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="PRG_MachineControl" Id="{73cce6c0-0336-454e-b089-fed285c9fc85}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM PRG_MachineControl
VAR
    // =========================================================
    // TIMERS & TRIGGERS
    // =========================================================
	tonSys_Init           				: TON := (PT := T#8S);    // Initialization pulse timer
    tonSys_InitTimeout    				: TON := (PT := T#15S);   // Initialization timeout fault timer    : TON := (PT := T#15S);   // Initialization timeout fault timer
	tonTimeout_testing    				: TON := (PT := T#8S);   // Initialization timeout fault timer
    tonFirstAutoCycle     				: TON := (PT := T#500MS); // Auto cycle start settling timer
	tonStoppingDelay	  				: TON                   ; // Time to finalize process 
    tonSafety             				: TON := (PT := T#10S);   // Safety interlock debounce timer
	tonAutoCycleIdleTimeout 			: TON := (PT := T#2M);
	tonSimulation		  				: ARRAY[1..4] OF TON; //timer for simulations  
	rtKistlerResultDone   				: R_TRIG;
	rtPartPresentReject   				: R_TRIG;
    
    rtFirstAutoCycle      				: R_TRIG; // Detects entry into Auto Cycle
    fbResetTrigger        				: F_TRIG; // Detects HMI Reset button release
	tTwoHandReturnTimeout 				: TON := (PT := T#5S);
	tonAfterKistlerDelay  				: TON;
	
    eProcessCycleState 					: E_ProcessCycle_State := E_ProcessCycle_State.IDLE;
	
	tonGuideCylinderDelay 				: TON;
	tonGuideCylinderRetractDelay 		: TON;
	tGuideCylinderDelay   				: TIME := T#250MS;
	
	bFaultResetRequested 				: BOOL := FALSE;
	
	dtCurrentLocalTime 					: DATE_AND_TIME;
	iDataHistoryNestIndex 				: INT := 0;
	
	
    // =========================================================
    // PROCESS CYCLE CONTROL
    // =========================================================
	bStartProcessCondition 				: BOOL;   // OK to Start checklist condition flag
	bAutoCyclePermissive				: BOOL;
    bKistlerReady          				: BOOL;   // Press healthy and ready feedback flag
    i                      				: INT;    // Loop index counter
    sMachineMessage        				: STRING; // Diagnostics and status message string
	stKistlerInTelegram  				: ST_Kistler_TelegramIn;
	stKistlerOutTelegram 				: ST_Kistler_TelegramOut;
	
    bProcessCycleAllowed   		: BOOL;
    bAutoProcessAllowed    		: BOOL;
    bManualKistlerAllowed  		: BOOL;
	
	bAirInitialised     		: BOOL;
	bNestInitialised    		: BOOL;
	bKistlerInitialised 		: BOOL;
	bMachineInitialised 		: BOOL;
	
	bStopRequested 				: BOOL;
	bStopAllowed   				: BOOL;
	
	bRejectConfirmedForExchange : BOOL;
	bPendingOperatorResultPass  : BOOL;
	bPendingOperatorResultFail  : BOOL;
	
	// =================================================================
    // NEST TABLE INTERNAL CONTROL VARIABLES
    // =================================================================
	eNestState           			: E_NestState := E_NestState.IDLE;
	bSequenceToggle      			: BOOL := FALSE;                   // Toggle flag for manual bench testing
	eCurrentNestPos 	 			: E_NestPosition := E_NestPosition.UNKNOWN;
	eCompletedOperatorExchangeNest 	: E_NestPosition;
	
	// Part-removal control used when the Puck Locker is disabled
	eLastOperatorNestPositionNoLocker : E_NestPosition := E_NestPosition.Unknown;
	bPartRemovalRequiredNoLocker      : BOOL := FALSE;
	
    // HMI PARAMETERS & SAFETY TIMERS
    rHmiTwoHandPresetTime 		: REAL := 250.0; // Time preset from HMI in milliseconds (e.g., 1500.0 ms = 1.5s)
    tTwoHandTargetTime    		: TIME;           // Converted time to be used by the PLC timer
    tTwoHandHoldTimer     		: TON;            // Timer to verify if operator held the buttons long enough
	
	// Timers for pneumatic steps control without sensors
	tSupportRetractDelay 		: TON;  // Time for elevator cylinder to retract down
	tRotatingTableDelay  		: TON;  // Simulated time for index table to complete rotation
	tPortB_ResetDelay    		: TON;  // Pulse time for Port B air relief / mechanism reset
	tSupportExtendDelay  		: TON;  // Time for elevator cylinder to extend back up
	
	eLastTestedNestPos 			: E_NestPosition := E_NestPosition.UNKNOWN;
	bNestNewPositionReady 		: BOOL;

	eOperatorExchangeState : E_OperatorExchangeState := E_OperatorExchangeState.Idle;

	bOperatorExchangeComplete 	 : BOOL;
	bOperatorIndexPermissive   	 : BOOL;
	
	//==========================================================
	//KISTLER COMMAND INTERFACE 
	//==========================================================
	stKistler_CMD          		: ST_Kistler_CMD;    // Commands sent to Kistler press
    stKistler_Status       		: ST_Kistler_Status; // Feedbacks read from Kistler press
	tonKistlerTareYDelay 		: TON;
	
	bKistlerResetPulse  		: BOOL;
    tonKistlerReset     		: TON;
	
	bKistlerRecoveryHomeRequest : BOOL;
	bNestRecoveryHomeRequest	: BOOL;
	uKistlerCurrentValueX 		: U_BytesToReal;
	uKistlerCurrentValueY 		: U_BytesToReal;
	
	uKistlerEO2_XMax 			: U_BytesToReal;
	uKistlerEO2_XMin 			: U_BytesToReal;
	uKistlerEO1_YMax 			: U_BytesToReal;
	uKistlerEO1_YMin 			: U_BytesToReal;

	
	// Maximum values recorded during the current Kistler test
	rKistlerCycleMaxForce    	: REAL := 0.0;
	rKistlerCycleMaxDistance 	: REAL := 0.0;

	

	

	//==========================================================
	//LEDS COMMAND INTERFACE 
	//==========================================================

    // Status memory for each individual LED mode
    eMode_LED_Start    : E_LEDs_Mode := E_LEDs_Mode.OFF;
    eMode_LED_Reset    : E_LEDs_Mode := E_LEDs_Mode.OFF;
	eMode_LED_Pass 	   : E_LEDs_Mode := E_LEDs_Mode.OFF;
    eMode_LED_fail     : E_LEDs_Mode := E_LEDs_Mode.OFF;
    // Hardware digital outputs mapped to the physical LEDs
    q_bLED_Start      AT%Q*    : BOOL; 
    q_bLED_Reset      AT%Q*    : BOOL;
	q_bLED_Pass       AT%Q*    : BOOL;
	q_bLED_Fail       AT%Q*    : BOOL;
    
	// =========================================================
    // PUCK LOCKER
    // =========================================================
	eKistlerNestPosition  		: E_NestPosition;
    eOperatorNestPosition 		: E_NestPosition;
	ePendingPuckDispositionNest : E_NestPosition := E_NestPosition.Unknown;

    iKistlerNestIndex     : INT;
    iOperatorNestIndex    : INT;
	
	bKistlerResultStored : BOOL;
	bPartRemovedConfirmedForExchange : BOOL;
	
	bOperatorPartMustBeRemoved : BOOL;
    bPreviousIndexInPosition   : BOOL;
    rtIndexInPosition          : R_TRIG;
    ftOperatorPartPresent      : F_TRIG;
	
    // =========================================================
    // PERSISTENT DATA & LOGGING
    // =========================================================
    //fbWritePersistent      : FB_WritePersistentData;
	bWriteTrigger          		: BOOL; // Test and simulation sequence trigger
	eCurrentState				: INT;
	
	// =========================================================
    // HMI COMMAND
    // =========================================================
	bHMIManualModeRequest 		: BOOL := FALSE;
	rtHMIManualModeRequest 		: R_TRIG;
	i_bHMIManualModeRequest		: INT;
	fbLocalSystemTime 			: FB_LocalSystemTime;
	bDataHistoryResetActive 	: BOOL := FALSE;
	
	
	E_ProcessCycleState			: INT;
	IDLE						: INT;
	
	// -----------------------------------------------------------------------------
	// Fault reject recovery
	// -----------------------------------------------------------------------------
	rtMachineFault       		: R_TRIG;
	bFaultRejectActive   		: BOOL;
	bFaultRejectPending  		: BOOL;
	eFaultOperatorNest 			: E_NestPosition := E_NestPosition.UNKNOWN;
	


	
		iDataHistoryResetIndex: INT;
END_VAR


]]></Declaration>
    <Implementation>
      <ST><![CDATA[

// =========================================================
// 1. PRE-CONDITION LOGIC
// =========================================================
M_PreExecution();

// Detect the transition into machine FAULT.
rtMachineFault(
    CLK :=
        GVL_MASTER.stMachineStatus.eMachineState =
            E_MachineState.FAULT
);

// Start the internal-part reject recovery only once,
// on the rising edge of the FAULT state.
IF rtMachineFault.Q THEN

    M_StartFaultRejectRecovery();

END_IF

// Generate Kistler commands based on current machine state
// Map Kistler EtherCAT telegram to PLC status structure
M_KistlerConfig_Output();

bStartProcessCondition :=
    GVL_MASTER.stMachineStatus.bSafety
    AND NOT GVL_MASTER.i_bButtonEmergencyStop
    AND NOT GVL_MASTER.stMachineStatus.bFault
    AND NOT stKistler_Status.bError
    AND stKistler_Status.bReady
    AND GVL_MASTER.stPuckLocker.bMachinePermissive;

 // Initialisation conditions
 
 	
	
    bAirInitialised := GVL_MASTER.bAirSupply_Ok;

    bNestInitialised :=
        (eNestState = E_NestState.IDLE)
        AND NOT GVL_MASTER.stNestTable.bNestInMotion
        AND GVL_MASTER.stNestTable.bNestReadySensor
        AND GVL_MASTER.stNestTable.bNestLockedSensor;

    bKistlerInitialised :=
         stKistler_Status.bInPosition
	      AND NOT stKistler_Status.bError;

    bMachineInitialised :=
        bAirInitialised
        AND bNestInitialised
        AND bKistlerInitialised;
		
	GVL_MASTER.bProcessBusy := 
	(eProcessCycleState <> E_ProcessCycle_State.WAIT_NEST_TESTING_READY 
	AND eProcessCycleState <> E_ProcessCycle_State.IDLE )
	
    OR (eNestState <> E_NestState.IDLE AND eNestState <> E_NestState.FAULT AND eNestState <> E_NestState.WAIT_OPERATOR_EXCHANGE)
    OR GVL_MASTER.stNestTable.bNestInMotion
    OR GVL_MASTER.stProcess.bKistlerCycleRequest
    OR GVL_MASTER.stProcess.bReleaseNestRotation
    OR stKistler_Status.bBusy
    OR NOT stKistler_Status.bInPosition
    OR GVL_MASTER.stNestTable.bSupportExtendRequest
    OR GVL_MASTER.stActuators.bGuideCylinderExtendRequest
	OR GVL_MASTER.stNestTable.bSupportExtended;
	
// =========================================================
// TIMEOUT
// =========================================================

	tonTimeout_testing (IN := GVL_MASTER.bProcessBusy);

	// Any process activity resets the accumulated timeout.
	tonAutoCycleIdleTimeout(
		IN :=
			GVL_MASTER.stMachineStatus.eMachineState =
				E_MachineState.SYSTEM_AUTO_CYCLE
			AND NOT GVL_MASTER.bProcessBusy
	);

// =========================================================
// GLOBAL FAULT DETECTION
// =========================================================
// Only technical Kistler errors shall put the machine in FAULT.
// Kistler NOK result is a rejected part, not a machine fault.
// =========================================================

//OR stKistler_Status.bError
IF (
    NOT GVL_MASTER.stMachineStatus.bSafety
    OR GVL_MASTER.i_bButtonEmergencyStop 
)
AND GVL_MASTER.stMachineStatus.eMachineState <> E_MachineState.FAULT THEN

    GVL_MASTER.stMachineStatus.eMachineState := E_MachineState.FAULT;

END_IF

//HMI Command Manual Mode

rtHMIManualModeRequest(CLK := GVL_HMI.i_bHMIManualModeRequest);

IF rtHMIManualModeRequest.Q AND GVL_Master.stMachineStatus.eMachineState = E_MachineState.SYSTEM_READY_TO_START THEN
    bHMIManualModeRequest := TRUE;
    GVL_HMI.i_bHMIManualModeRequest := FALSE;
ELSE
	bHMIManualModeRequest := FALSE;
    GVL_HMI.i_bHMIManualModeRequest := FALSE;
END_IF;


IF NOT GVL_MASTER.i_bButtonStop THEN
    bStopRequested := TRUE;
END_IF


IF GVL_MASTER.stMachineStatus.eMachineState <>
    E_MachineState.FAULT THEN

    bFaultResetRequested := FALSE;
END_IF

// // =========================================================
// 2. MAIN STATE MACHINE (CASE)
// =========================================================


CASE GVL_Master.stMachineStatus.eMachineState OF


    E_MachineState.SYSTEM_POWER_UP:
	    GVL_Master.stMachineStatus.eMachineState := E_MachineState.STOPPING;
		M_ResetProcessCycle();
		
    E_MachineState.FAULT:
 		eMode_LED_Start := E_LEDs_Mode.OFF;
        eMode_LED_Reset := E_LEDs_Mode.FLASHING; // Reset button must flash
		eMode_LED_Fail := E_LEDs_Mode.ON;
		eMode_LED_PASS := E_LEDs_Mode.OFF;
		
		bHMIManualModeRequest := FALSE;
    	//M_ResetProcessCycle();

		// Store the first reset request while TwinSAFE recovers.
		IF GVL_MASTER.i_bButtonReset THEN
			bFaultResetRequested := TRUE;
		END_IF

		IF GVL_MASTER.stMachineStatus.bSafety
			AND NOT GVL_MASTER.i_bButtonEmergencyStop
			AND fbResetTrigger.Q
		THEN
			bKistlerResetPulse := TRUE;
		END_IF;
	
	
		IF bKistlerResetPulse THEN
	
			IF M_ResetProcessCycle() THEN
	
				GVL_MASTER.stMachineStatus.eMachineState :=
					E_MachineState.STOPPING;
	
			END_IF;
	
		END_IF;

// 
//         IF  GVL_MASTER.stMachineStatus.bSafety AND NOT GVL_MASTER.i_bButtonEmergencyStop AND fbResetTrigger.Q THEN
//             GVL_Master.stMachineStatus.eMachineState := E_MachineState.STOPPING;
//         END_IF
		
	E_MachineState.STOPPING:
		eMode_LED_PASS := E_LEDs_Mode.OFF;
		eMode_LED_Fail := E_LEDs_Mode.OFF;
        rtFirstAutoCycle(CLK := FALSE);
        tonStoppingDelay(IN := GVL_Master.stMachineStatus.bStopping, PT := T#2S);
		bStopRequested := FALSE;
		IF tonStoppingDelay.Q THEN
			tonStoppingDelay(IN := FALSE);
        	GVL_Master.stMachineStatus.eMachineState := E_MachineState.STOPPED;
		END_IF
	   
	E_MachineState.STOPPED:
		eMode_LED_Reset := E_LEDs_Mode.FLASHING; // Start button must flash
        eMode_LED_Start := E_LEDs_Mode.OFF;
		eMode_LED_PASS := E_LEDs_Mode.OFF;
		eMode_LED_Fail := E_LEDs_Mode.OFF;
		M_ResetProcessCycle();

		IF fbResetTrigger.Q AND bStartProcessCondition THEN
            GVL_Master.stMachineStatus.eMachineState := E_MachineState.SYSTEM_INITIALISING;
			
        END_IF

		
	E_MachineState.SYSTEM_INITIALISING:
	
		tonSys_Init (IN := GVL_MASTER.stMachineStatus.bInitialising);
		tonSys_InitTimeout (IN := GVL_MASTER.stMachineStatus.bInitialising);
		eLastTestedNestPos := E_NestPosition.UNKNOWN;
		
		IF tonSys_Init.Q 
			AND GVL_IO.stSafety.bSafetyOK 
			AND bStartProcessCondition THEN
			
			IF NOT bKistlerInitialised THEN 
				
				 stKistler_Status.eKistlerState := E_KistlerState.HOMING;
    			 bKistlerRecoveryHomeRequest := TRUE;
				
			ELSIF   stKistler_Status.eKistlerState = E_KistlerState.READY THEN
   				GVL_MASTER.stMachineStatus.eMachineState := E_MachineState.SYSTEM_READY_TO_START;
			END_IF
			
		ELSIF tonSys_InitTimeout.Q THEN
			GVL_MASTER.stMachineStatus.eMachineState := E_MachineState.FAULT;
		
		ELSIF bStopRequested THEN
            GVL_Master.stMachineStatus.eMachineState := E_MachineState.STOPPING;
 		END_IF
// 		
	E_MachineState.SYSTEM_READY_TO_START:
	    
		eMode_LED_Start := E_LEDs_Mode.FLASHING; // Start button must flash
        eMode_LED_Reset := E_LEDs_Mode.OFF;
		eMode_LED_PASS := E_LEDs_Mode.OFF;
		eMode_LED_Fail := E_LEDs_Mode.OFF;
		
		IF bStopRequested THEN
            GVL_Master.stMachineStatus.eMachineState := E_MachineState.STOPPING;
	    		
        ELSIF bHMIManualModeRequest
   			AND GVL_MASTER.stMachineStatus.bSafety
   			AND NOT GVL_MASTER.i_bButtonEmergencyStop THEN
			//bHMIManualModeRequest := FALSE;
			GVL_Master.stMachineStatus.eMachineState := E_MachineState.MANUAL_MODE;
			
        ELSIF GVL_MASTER.i_bButtonStart
    			AND bStartProcessCondition
    			AND (stKistler_Status.eKistlerState = E_KistlerState.READY
        		OR stKistler_Status.eKistlerState = E_KistlerState.HOME_DONE) THEN
            		GVL_Master.stMachineStatus.eMachineState := E_MachineState.SYSTEM_AUTO_CYCLE;
			
		ELSIF  NOT GVL_IO.stSafety.bSafetyOK THEN
			GVL_Master.stMachineStatus.eMachineState := E_MachineState.FAULT;
        END_IF	
 
	E_MachineState.SYSTEM_AUTO_CYCLE:
	 
		// Show the result of the processed part currently
		// waiting at the operator position.
		// -------------------------------------------------------------------------
		// Operator result indication.
		//
		// The LEDs must represent the stored result of the physical nest currently
		// available to the operator.
		//
		// Do not use bPendingOperatorResultPass / Fail here. Those variables are
		// latched for the operator-exchange state machine and may still represent
		// the previous exchange while the table is indexing.
		// -------------------------------------------------------------------------
		eMode_LED_PASS := E_LEDs_Mode.OFF;
		eMode_LED_Fail := E_LEDs_Mode.OFF;
        // The operator nest and its array index must be valid.
		IF eOperatorNestPosition <> E_NestPosition.Unknown THEN
		
			iOperatorNestIndex :=
				TO_INT(eOperatorNestPosition);
		
			IF (iOperatorNestIndex >= 1)
			   AND (iOperatorNestIndex <= 4) THEN
		
		
				// -------------------------------------------------------------
				// FAIL indication.
				//
				// Turn the red LED on as soon as the failed part arrives at the
				// operator position.
				//
				// Keep it on after the part is removed from the nest.
				//
				// Turn it off only after the reject sensor confirms that the
				// failed part was placed in the reject location.
				// -------------------------------------------------------------
				IF GVL_MASTER.astNestProcessResult[
						iOperatorNestIndex
				   ].bResultValid
				   AND GVL_MASTER.astNestProcessResult[
						iOperatorNestIndex
				   ].bFail
				   AND NOT bRejectConfirmedForExchange THEN
		
					eMode_LED_PASS := E_LEDs_Mode.OFF;
					eMode_LED_Fail := E_LEDs_Mode.ON;
		
		
				// -------------------------------------------------------------
				// PASS indication.
				//
				// Turn the green LED on as soon as the passed part arrives at
				// the operator position.
				//
				// Turn it off when the operator removes the part from the nest.
				// No puck condition is involved in the indication.
				// -------------------------------------------------------------
				ELSIF GVL_MASTER.astNestProcessResult[
							iOperatorNestIndex
					  ].bResultValid
					  AND GVL_MASTER.astNestProcessResult[
							iOperatorNestIndex
					  ].bPass
					  AND GVL_MASTER.stSensors.bPartPresent_NEST 
					  AND NOT bPartRemovedConfirmedForExchange THEN
		
					eMode_LED_PASS := E_LEDs_Mode.ON;
					eMode_LED_Fail := E_LEDs_Mode.OFF;
		
				END_IF
		
			END_IF
		
		END_IF
	
		rtFirstAutoCycle(CLK := TRUE);
		tonFirstAutoCycle(IN := rtFirstAutoCycle.Q);
	
		IF bStopRequested
			AND NOT GVL_MASTER.bProcessBusy THEN
	
			GVL_MASTER.stMachineStatus.eMachineState :=
				E_MachineState.STOPPING;
	
		ELSIF GVL_MASTER.stMachineStatus.bFault
			OR NOT bStartProcessCondition
			OR NOT GVL_IO.stSafety.bSafetyOK THEN
	
			GVL_MASTER.stMachineStatus.eMachineState :=
				E_MachineState.FAULT;
	
		ELSIF tonTimeout_testing.Q THEN
	
			GVL_MASTER.stMachineStatus.eMachineState :=
				E_MachineState.FAULT;
		ELSIF tonAutoCycleIdleTimeout.Q THEN

			GVL_MASTER.stMachineStatus.eMachineState :=
				E_MachineState.STOPPING;
	
		END_IF
		
		
		
    E_MachineState.MANUAL_MODE:
		eMode_LED_Start := E_LEDs_Mode.OFF; // Start button must flash
        eMode_LED_Reset := E_LEDs_Mode.OFF;
		eMode_LED_PASS := E_LEDs_Mode.OFF;
		eMode_LED_Fail := E_LEDs_Mode.OFF;
		eLastTestedNestPos := E_NestPosition.UNKNOWN;
   		
		IF NOT GVL_MASTER.stMachineStatus.bSafety
		   OR GVL_MASTER.i_bButtonEmergencyStop THEN
		
			GVL_MASTER.stMachineStatus.eMachineState := E_MachineState.FAULT;
		
		ELSIF  bStopRequested 
			AND NOT GVL_MASTER.bProcessBusy THEN
			GVL_HMI.i_bHMIManualModeRequest				 := FALSE;
    		GVL_HMI.i_bHMIIndexerManualEnable 			 := FALSE;
    		GVL_HMI.i_bHMIKistlerManualEnable 			 := FALSE;
			GVL_MASTER.stMachineStatus.eMachineState := E_MachineState.STOPPING;
		
		END_IF

END_CASE

// =========================================================
// 3. GLOBAL FLAG MAPPING
// =========================================================
GVL_Master.stMachineStatus.bSystemPowerUp := (GVL_Master.stMachineStatus.eMachineState = E_MachineState.SYSTEM_POWER_UP);
GVL_Master.stMachineStatus.bInitialising  := (GVL_Master.stMachineStatus.eMachineState = E_MachineState.SYSTEM_INITIALISING);
GVL_Master.stMachineStatus.bStopped       := (GVL_Master.stMachineStatus.eMachineState = E_MachineState.STOPPED);
GVL_Master.stMachineStatus.bStopping      := (GVL_Master.stMachineStatus.eMachineState = E_MachineState.STOPPING);
GVL_Master.stMachineStatus.bAutoCycle     := (GVL_Master.stMachineStatus.eMachineState = E_MachineState.SYSTEM_AUTO_CYCLE);
GVL_Master.stMachineStatus.bFault         := (GVL_Master.stMachineStatus.eMachineState = E_MachineState.FAULT);
GVL_Master.stMachineStatus.bReadyToStart  := (GVL_Master.stMachineStatus.eMachineState = E_MachineState.SYSTEM_READY_TO_START);
GVL_Master.stMachineStatus.bManualMode    := (GVL_Master.stMachineStatus.eMachineState = E_MachineState.MANUAL_MODE);


// =========================================================
// 5. METHOD POST-EXECUTION ROUTINE
// =========================================================

// Generate base Kistler commands from machine state
M_KistlerControl(
    eCurrentState := GVL_MASTER.stMachineStatus.eMachineState);

// Coordinate Nest and Kistler process sequence
M_ProcessCycle();
M_UpdateMachineMessage();

// Update Puck locker permissives. 
M_UpdatePuckLockerPermissives();

// Kistler internal state machine may request movement/sequence
M_KistlerStateMachine(
    eCurrentState := GVL_MASTER.stMachineStatus.eMachineState);
	
M_SupportControl(
    bExtendRequest  := GVL_MASTER.stNestTable.bSupportExtendRequest,
    bRetractRequest := GVL_MASTER.stNestTable.bSupportRetractRequest
);

M_GuideCylinderControl(
    bExtendRequest := GVL_MASTER.stActuators.bGuideCylinderExtendRequest
);

M_KistlerConfig_Input();

fbLocalSystemTime(
    bEnable := TRUE,
    dwCycle := 1
);

M_UpdateStatisticsAndHistory();

// Update machine status from Kistler status
M_StatusMapping();

M_LEDsButtons();
M_NestTableControl();

M_TerminalInfo();


]]></ST>
    </Implementation>
    <Folder Name="GuideCylinder" Id="{f10faf9c-65dc-4eb4-9dd1-2b0b5aecf204}" />
    <Folder Name="Kistler" Id="{9e17cfcd-c98c-45cb-bd0b-324e8c0aff3a}" />
    <Folder Name="Nest_Table" Id="{b7ca633f-afa1-44ec-8055-793fa5c0679e}" />
    <Folder Name="Pick_Locker" Id="{df051fcd-8c9f-4620-b035-4bdfd7cf7977}" />
    <Folder Name="SupportElevator" Id="{7f702417-a10d-4779-8751-86ff4b21f60e}" />
    <Method Name="M_ClearCompletedOperatorNestResult" Id="{01b8ae27-8d16-43ef-a386-7432c49082ed}" FolderPath="Nest_Table\">
      <Declaration><![CDATA[METHOD PRIVATE M_ClearCompletedOperatorNestResult
VAR
	iCompletedNestIndex : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// The nest associated with the completed exchange must be known.
IF eCompletedOperatorExchangeNest = E_NestPosition.Unknown THEN
    RETURN;
END_IF

iCompletedNestIndex := TO_INT(eCompletedOperatorExchangeNest);

IF (iCompletedNestIndex < 1) OR (iCompletedNestIndex > 4) THEN
    RETURN;
END_IF


// Clear only after the complete operator disposition has finished.
GVL_MASTER.astNestProcessResult[iCompletedNestIndex].bResultValid := FALSE;
GVL_MASTER.astNestProcessResult[iCompletedNestIndex].bPass := FALSE;
GVL_MASTER.astNestProcessResult[iCompletedNestIndex].bFail := FALSE;
GVL_MASTER.astNestProcessResult[iCompletedNestIndex].bDispositionSent := FALSE;

eCompletedOperatorExchangeNest := E_NestPosition.Unknown;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_ClearRemovedOperatorNestResult" Id="{c718cf76-b546-4927-a46e-0e5025b89a81}" FolderPath="Nest_Table\">
      <Declaration><![CDATA[METHOD PRIVATE M_ClearRemovedOperatorNestResult
VAR
	iOperatorNestIndex : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// The operator nest must be known.
IF eOperatorNestPosition = E_NestPosition.Unknown THEN
    RETURN;
END_IF


// E_NestPosition corresponds directly to indexes 1..4.
iOperatorNestIndex := TO_INT(eOperatorNestPosition);

IF (iOperatorNestIndex < 1) OR (iOperatorNestIndex > 4) THEN
    RETURN;
END_IF


// Clear the stored result only when:
//
// 1. The result was already delivered to the Puck Locker.
// 2. The processed part was physically removed from the operator nest.
IF GVL_MASTER.astNestProcessResult[iOperatorNestIndex].bDispositionSent AND GVL_MASTER.astNestTracking[iOperatorNestIndex].bPartRemovedPulse THEN

    GVL_MASTER.astNestProcessResult[iOperatorNestIndex].bResultValid := FALSE;

    GVL_MASTER.astNestProcessResult[iOperatorNestIndex].bPass := FALSE;

    GVL_MASTER.astNestProcessResult[iOperatorNestIndex].bFail := FALSE;

    GVL_MASTER.astNestProcessResult[iOperatorNestIndex].bDispositionSent := FALSE;

END_IF;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_ConfirmPuckLockerDisposition" Id="{10b0db97-52e9-4e62-9b4d-4520c43ca38e}" FolderPath="Pick_Locker\">
      <Declaration><![CDATA[METHOD PRIVATE M_ConfirmPuckLockerDisposition
VAR
	iDispositionNestIndex : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// No disposition is waiting for confirmation.
IF ePendingPuckDispositionNest = E_NestPosition.Unknown THEN
    RETURN;
END_IF


// The Puck Locker has not yet consumed the request.
IF NOT GVL_MASTER.stPuckLocker.bDispositionHandled THEN
    RETURN;
END_IF


// E_NestPosition values correspond directly to indexes 1..4.
iDispositionNestIndex :=
    ePendingPuckDispositionNest;

IF (iDispositionNestIndex < 1) OR (iDispositionNestIndex > 4) THEN

    // Prevent the handshake from remaining blocked by an invalid position.
    ePendingPuckDispositionNest :=
        E_NestPosition.Unknown;
    RETURN;
END_IF


// Mark the result as successfully delivered to the Puck Locker.
GVL_MASTER.astNestProcessResult[iDispositionNestIndex].bDispositionSent := TRUE;


// Release the local handshake.
ePendingPuckDispositionNest := E_NestPosition.Unknown;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_GetCurrentPosition" Id="{5ad458d2-2562-4615-8d3c-a8c74f1cf84a}" FolderPath="Nest_Table\">
      <Declaration><![CDATA[METHOD M_GetCurrentPosition : E_NestPosition
VAR_INST
	iBinaryValue : BYTE;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// 1. Pack the 3 boolean sensors into a single numeric value (Byte) to simplify binary calculation
// Sensor_3 (Bit 2) | Sensor_2 (Bit 1) | Sensor_1 (Bit 0)
iBinaryValue.0 := GVL_MASTER.stNestTable.bNestPos_1_Sensor;
iBinaryValue.1 := GVL_MASTER.stNestTable.bNestPos_2_Sensor;
iBinaryValue.2 := GVL_MASTER.stNestTable.bNestPos_3_Sensor;

// 2. Evaluate the resulting decimal value from the binary combination and return the matching ENUM
CASE iBinaryValue OF
    1: M_GetCurrentPosition := E_NestPosition.POSITION_1; // Binary 001
    2: M_GetCurrentPosition := E_NestPosition.POSITION_2; // Binary 010
    3: M_GetCurrentPosition := E_NestPosition.POSITION_3; // Binary 011
    4: M_GetCurrentPosition := E_NestPosition.POSITION_4; // Binary 100
ELSE
    // Default fallback: If 000 or any unmapped pattern occurs (e.g., 111), the table might be misaligned or in motion
    M_GetCurrentPosition := E_NestPosition.UNKNOWN; 
END_CASE


CASE eCurrentNestPos OF
    E_NestPosition.POSITION_1:
        GVL_HMI.iNestRotationAngle      := 0;
		GVL_HMI.iNestPositionTesting    :=1;

    E_NestPosition.POSITION_2:
        GVL_HMI.iNestRotationAngle 		:= 90;
		GVL_HMI.iNestPositionTesting    :=2;
		
    E_NestPosition.POSITION_3:
        GVL_HMI.iNestRotationAngle 		:= 180;
	    GVL_HMI.iNestPositionTesting    :=3;
		
    E_NestPosition.POSITION_4:
        GVL_HMI.iNestRotationAngle 		:= 270;
		GVL_HMI.iNestPositionTesting    :=4;

ELSE
    GVL_HMI.iNestRotationAngle      := 0;
	GVL_HMI.iNestPositionTesting    := 0;
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_GuideCylinderControl" Id="{104c92f2-fa5c-4064-a20d-a8f4a2c78ac7}" FolderPath="GuideCylinder\">
      <Declaration><![CDATA[METHOD PRIVATE M_GuideCylinderControl
VAR_INPUT
    bExtendRequest : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// =================================================================
// GUIDE CYLINDER CONTROL
// =================================================================
// This method is responsible only for the Guide Cylinder output.
// It does not decide Auto Cycle or Manual Mode.
// The request must come from the Kistler state machine.
//
// Single-solenoid pneumatic cylinder:
// TRUE  -> Extend guide cylinder.
// FALSE -> Retract guide cylinder automatically.

GVL_MASTER.stActuators.qGuideCylinder := bExtendRequest;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_HMIKistlerResult" Id="{5ec231b7-f8ff-4c60-8cb2-2f6710f94bba}" FolderPath="Kistler\">
      <Declaration><![CDATA[METHOD PRIVATE M_HMIKistlerResult : BOOL
VAR_INPUT
    eNestPosition : E_NestPosition;
    bPartOK       : BOOL;
    bPartNOK      : BOOL;
    rForce        : REAL;
    rDistance     : REAL;
	bResetValues  : BOOL;
END_VAR

VAR
    iNestIndex : INT;
END_VAR

]]></Declaration>
      <Implementation>
        <ST><![CDATA[

M_HMIKistlerResult := FALSE;


// =========================================================
// CONVERT NEST POSITION TO ARRAY INDEX
// =========================================================

CASE eNestPosition OF

    E_NestPosition.Position_1:
        iNestIndex := 1;

    E_NestPosition.Position_2:
        iNestIndex := 2;

    E_NestPosition.Position_3:
        iNestIndex := 3;

    E_NestPosition.Position_4:
        iNestIndex := 4;

ELSE
    RETURN;

END_CASE;


// =========================================================
// RESET VALUES BEFORE A NEW TEST
// =========================================================

IF bResetValues THEN

    GVL_HMI.aKistlerNestResult[iNestIndex].rForce := 0.0;
    GVL_HMI.aKistlerNestResult[iNestIndex].rDistance := 0.0;

    GVL_HMI.aKistlerNestResult[iNestIndex].eResult :=
        E_HMIKistlerResult.NONE;

    M_HMIKistlerResult := TRUE;
    RETURN;

END_IF;


// =========================================================
// STORE MAXIMUM TEST VALUES
// =========================================================

IF ABS(rForce) >
   ABS(GVL_HMI.aKistlerNestResult[iNestIndex].rForce) THEN

    GVL_HMI.aKistlerNestResult[iNestIndex].rForce :=
        rForce;

END_IF;


IF ABS(rDistance) >
   ABS(GVL_HMI.aKistlerNestResult[iNestIndex].rDistance) THEN

    GVL_HMI.aKistlerNestResult[iNestIndex].rDistance :=
        rDistance;

END_IF;


// =========================================================
// STORE FINAL RESULT
// =========================================================

IF bPartOK THEN

    GVL_HMI.aKistlerNestResult[iNestIndex].eResult :=
        E_HMIKistlerResult.PASS;

ELSIF bPartNOK THEN

    GVL_HMI.aKistlerNestResult[iNestIndex].eResult :=
        E_HMIKistlerResult.FAIL;

END_IF;


M_HMIKistlerResult := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_IsNestEnabled" Id="{faec0923-f0a4-4b40-99ae-0b504fd30bb5}">
      <Declaration><![CDATA[METHOD M_IsNestEnabled : BOOL
VAR_INPUT
    eNestPos : E_NestPosition;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[

CASE eNestPos OF

    E_NestPosition.Position_1:
        M_IsNestEnabled := GVL_HMI.aNestEnabled[1];

    E_NestPosition.Position_2:
        M_IsNestEnabled := GVL_HMI.aNestEnabled[2];

    E_NestPosition.Position_3:
        M_IsNestEnabled := GVL_HMI.aNestEnabled[3];

    E_NestPosition.Position_4:
        M_IsNestEnabled := GVL_HMI.aNestEnabled[4];

ELSE

    M_IsNestEnabled := FALSE;

END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_KistlerCommandMapping" Id="{5cfa21d9-3cc5-49b3-924c-97638c44a598}" FolderPath="Kistler\">
      <Declaration><![CDATA[METHOD PRIVATE M_KistlerCommandMapping : BOOL
VAR
    i : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
// =================================================================================
// PLC -> KISTLER COMMAND MAPPING
// =================================================================================
// Clear command telegram
FOR i := 0 TO 199 DO
    GVL_KISTLER_IO.aKistlerOut[i] := 0;
END_FOR

// Enable maXYmos access and automatic mode
IF stKistler_CMD.bEnable THEN
    GVL_KISTLER_IO.aKistlerOut[1].3 := TRUE; // Access
    GVL_KISTLER_IO.aKistlerOut[1].4 := TRUE; // Auto
    GVL_KISTLER_IO.aKistlerOut[9].0 := TRUE; // Drive_Enable
END_IF

// Reset / acknowledge maXYmos faults/statistics
IF stKistler_CMD.bReset THEN
    GVL_KISTLER_IO.aKistlerOut[1].0 := TRUE; // Ack_Admin_Glob
    GVL_KISTLER_IO.aKistlerOut[1].1 := TRUE; // Ack_Admin
    GVL_KISTLER_IO.aKistlerOut[1].5 := TRUE; // Start_Reset
END_IF

// Abort / external sequence stop
IF stKistler_CMD.bAbort THEN
    GVL_KISTLER_IO.aKistlerOut[10].3 := TRUE; // Seq_Ext_Stop
END_IF

// Force Measurement Program 1 for first commissioning test
GVL_KISTLER_IO.aKistlerOut[2].0 := TRUE; // MP_01




M_KistlerCommandMapping := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_KistlerConfig_Input" Id="{14c376fa-cf59-47d0-a1ae-92a997aeb833}" FolderPath="Kistler\">
      <Declaration><![CDATA[METHOD PRIVATE M_KistlerConfig_Input : BOOL
VAR
    i : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// =================================================================================
// KISTLER CONFIG INPUT
// PLC -> maXYmos NC input/control telegram
// =================================================================================
// Source:
//     stKistler_CMD
//
// Internal telegram:
//     stKistlerInTelegram
//
// Destination:
//     GVL_KISTLER_IO.aKistlerOut[]
// =================================================================================


// =================================================================================
// CLEAR OUTPUT TELEGRAM
// =================================================================================

FOR i := 0 TO 199 DO
    GVL_KISTLER_IO.aKistlerOut[i] := 0;
END_FOR



// =================================================================================
// HIGH LEVEL COMMANDS -> KISTLER INPUT TELEGRAM STRUCT
// =================================================================================

// -----------------------------------------------------------------------------
// Byte 0 - Measurement commands
// NOTE:
// Byte 0.0 = Measurement START.
// This is NOT the same as Start Sequence.
// Start Sequence is controlled by Byte 9.1 = Run Sequence.
// -----------------------------------------------------------------------------

stKistlerInTelegram.bStart := stKistler_CMD.bStart;
stKistlerInTelegram.bTareY := stKistler_CMD.bTareY;


// -----------------------------------------------------------------------------
// Byte 1 - General control
// -----------------------------------------------------------------------------

stKistlerInTelegram.bAckAdminGlobal := stKistler_CMD.bReset;
stKistlerInTelegram.bAckAdmin       := stKistler_CMD.bReset;
//stKistlerInTelegram.bStatReset      := stKistler_CMD.bReset;
stKistlerInTelegram.bAccess         := stKistler_CMD.bEnable;
stKistlerInTelegram.bAuto           := stKistler_CMD.bEnable;
stKistlerInTelegram.bStatReset       := FALSE;

// -----------------------------------------------------------------------------
// Byte 2 - Measurement program selection
// Byte 2 bits 0..6 = MP selection
// 0 = MP_000
// -----------------------------------------------------------------------------

stKistlerInTelegram.byMeasurementProgram := 0;


// -----------------------------------------------------------------------------
// Byte 9 - Drive / sequence commands
// -----------------------------------------------------------------------------

stKistlerInTelegram.bDriveEnable      := stKistler_CMD.bEnable;
stKistlerInTelegram.bRunSequence      := stKistler_CMD.bRunSequence;
stKistlerInTelegram.bDriveToHomePos   := stKistler_CMD.bDriveToHome;
stKistlerInTelegram.bDriveToRefPos    := stKistler_CMD.bDriveToRef;
stKistlerInTelegram.bContinueFromWait := stKistler_CMD.bContinueFromWait;


// -----------------------------------------------------------------------------
// Byte 10 - External sequence stop request
// -----------------------------------------------------------------------------

stKistlerInTelegram.bSeqExtStopReq := stKistler_CMD.bAbort;


// -----------------------------------------------------------------------------
// Byte 12 - Current sequence selection
// 00 = Main sequence
// 01 = Sub1
// 10 = Sub2
// 11 = Sub3
//
// For current commissioning, always use Main Sequence.
// -----------------------------------------------------------------------------

stKistlerInTelegram.bCurrentSequence0 := FALSE;
stKistlerInTelegram.bCurrentSequence1 := FALSE;


// =================================================================================
// KISTLER INPUT TELEGRAM STRUCT -> OUTPUT BYTES
// =================================================================================

IF stKistlerInTelegram.bDriveToHomePos THEN

    stKistlerInTelegram.bDriveToRefPos := FALSE;
    stKistlerInTelegram.bRunSequence   := FALSE;

ELSIF stKistlerInTelegram.bDriveToRefPos THEN

    stKistlerInTelegram.bDriveToHomePos := FALSE;
    stKistlerInTelegram.bRunSequence    := FALSE;

ELSIF stKistlerInTelegram.bRunSequence THEN

    stKistlerInTelegram.bDriveToHomePos := FALSE;
    stKistlerInTelegram.bDriveToRefPos  := FALSE;

END_IF
// -----------------------------------------------------------------------------
// -----------------------------------------------------------------------------
// Byte 0 - Measurement commands
// Bit 0 = Measurement Start
// Bit 1 = Tare Y
// -----------------------------------------------------------------------------
// -----------------------------------------------------------------------------

GVL_KISTLER_IO.aKistlerOut[0].0 := stKistlerInTelegram.bStart;
GVL_KISTLER_IO.aKistlerOut[0].1 := stKistlerInTelegram.bTareY;


// -----------------------------------------------------------------------------
// Byte 1 - General control
// -----------------------------------------------------------------------------

GVL_KISTLER_IO.aKistlerOut[1].0 := stKistlerInTelegram.bAckAdminGlobal;
GVL_KISTLER_IO.aKistlerOut[1].1 := stKistlerInTelegram.bAckAdmin;
GVL_KISTLER_IO.aKistlerOut[1].3 := stKistlerInTelegram.bAccess;
GVL_KISTLER_IO.aKistlerOut[1].4 := stKistlerInTelegram.bAuto;
GVL_KISTLER_IO.aKistlerOut[1].5 := stKistlerInTelegram.bStatReset;


// -----------------------------------------------------------------------------
// Byte 2 - Measurement program selection
// -----------------------------------------------------------------------------

GVL_KISTLER_IO.aKistlerOut[2] := stKistlerInTelegram.byMeasurementProgram;


// -----------------------------------------------------------------------------
// Byte 9 - Drive / sequence commands
// Bit 0 = Drive Enable
// Bit 1 = Run Sequence / Start Sequence
// Bit 2 = Drive To Home Position
// Bit 3 = Drive To Reference Position
// Bit 6 = Continue From Wait
// -----------------------------------------------------------------------------

GVL_KISTLER_IO.aKistlerOut[9].0 := stKistlerInTelegram.bDriveEnable;
GVL_KISTLER_IO.aKistlerOut[9].1 := stKistlerInTelegram.bRunSequence;
GVL_KISTLER_IO.aKistlerOut[9].2 := stKistlerInTelegram.bDriveToHomePos;
GVL_KISTLER_IO.aKistlerOut[9].3 := stKistlerInTelegram.bDriveToRefPos;
GVL_KISTLER_IO.aKistlerOut[9].6 := stKistlerInTelegram.bContinueFromWait;


// -----------------------------------------------------------------------------
// Byte 10 - External sequence stop request
// Bit 3 = Sequence External Stop Request
// -----------------------------------------------------------------------------

GVL_KISTLER_IO.aKistlerOut[10].3 := stKistlerInTelegram.bSeqExtStopReq;


// -----------------------------------------------------------------------------
// Byte 12 - Current sequence selection
// 00 = Main sequence
// 01 = Sub1
// 10 = Sub2
// 11 = Sub3
// -----------------------------------------------------------------------------

GVL_KISTLER_IO.aKistlerOut[12].0 := stKistlerInTelegram.bCurrentSequence0;
GVL_KISTLER_IO.aKistlerOut[12].1 := stKistlerInTelegram.bCurrentSequence1;


// =================================================================================
// METHOD EXECUTION FEEDBACK
// =================================================================================

M_KistlerConfig_Input := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_KistlerConfig_Output" Id="{8ae5f917-1437-4f6b-8e62-9b5bec1a92a3}" FolderPath="Kistler\">
      <Declaration><![CDATA[METHOD PRIVATE M_KistlerConfig_Output : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// =================================================================================
// INPUT BYTES -> KISTLER OUTPUT TELEGRAM STRUCT
// =================================================================================
// Byte 0 - Mirrored measurement commands
stKistlerOutTelegram.bMirrorStart             := GVL_KISTLER_IO.aKistlerIn[0].0;
stKistlerOutTelegram.bMirrorTareY             := GVL_KISTLER_IO.aKistlerIn[0].1;
stKistlerOutTelegram.bMirrorZeroX             := GVL_KISTLER_IO.aKistlerIn[0].2;
stKistlerOutTelegram.bMirrorSensorTestX       := GVL_KISTLER_IO.aKistlerIn[0].3;
stKistlerOutTelegram.bMirrorSensorTestY       := GVL_KISTLER_IO.aKistlerIn[0].4;
stKistlerOutTelegram.bMirrorMasterMeasurement := GVL_KISTLER_IO.aKistlerIn[0].6;
stKistlerOutTelegram.bMirrorIncZero           := GVL_KISTLER_IO.aKistlerIn[0].7;

// Byte 1 - Mirrored general control
stKistlerOutTelegram.bMirrorAckAdminGlobal := GVL_KISTLER_IO.aKistlerIn[1].0;
stKistlerOutTelegram.bMirrorAckAdmin       := GVL_KISTLER_IO.aKistlerIn[1].1;
stKistlerOutTelegram.bMirrorAccess         := GVL_KISTLER_IO.aKistlerIn[1].3;
stKistlerOutTelegram.bMirrorAuto           := GVL_KISTLER_IO.aKistlerIn[1].4;
stKistlerOutTelegram.bMirrorStatReset      := GVL_KISTLER_IO.aKistlerIn[1].5;
stKistlerOutTelegram.bMirrorStatDisable    := GVL_KISTLER_IO.aKistlerIn[1].6;
stKistlerOutTelegram.bMirrorTareExtendedY  := GVL_KISTLER_IO.aKistlerIn[1].7;

// Byte 2 - Mirrored MP
stKistlerOutTelegram.byMirrorMeasurementProgram := GVL_KISTLER_IO.aKistlerIn[2];

// Byte 3 - Mirrored special commands / reserved
stKistlerOutTelegram.bMirrorResetSNGenerator := GVL_KISTLER_IO.aKistlerIn[3].1;
stKistlerOutTelegram.bMirrorBrakeTestActive  := GVL_KISTLER_IO.aKistlerIn[3].5;
stKistlerOutTelegram.bMirrorExportPVTStatus  := GVL_KISTLER_IO.aKistlerIn[3].6;

// Byte 5 - Reserved
stKistlerOutTelegram.byReserved05 := GVL_KISTLER_IO.aKistlerIn[5];

// Byte 4 - Mirrored configurable inputs
stKistlerOutTelegram.bMirrorInput00 := GVL_KISTLER_IO.aKistlerIn[4].0;
stKistlerOutTelegram.bMirrorInput01 := GVL_KISTLER_IO.aKistlerIn[4].1;
stKistlerOutTelegram.bMirrorInput02 := GVL_KISTLER_IO.aKistlerIn[4].2;
stKistlerOutTelegram.bMirrorInput03 := GVL_KISTLER_IO.aKistlerIn[4].3;
stKistlerOutTelegram.bMirrorInput04 := GVL_KISTLER_IO.aKistlerIn[4].4;
stKistlerOutTelegram.bMirrorInput05 := GVL_KISTLER_IO.aKistlerIn[4].5;
stKistlerOutTelegram.bMirrorInput06 := GVL_KISTLER_IO.aKistlerIn[4].6;
stKistlerOutTelegram.bMirrorInput07 := GVL_KISTLER_IO.aKistlerIn[4].7;

// Byte 6 - General status
stKistlerOutTelegram.bReady    := GVL_KISTLER_IO.aKistlerIn[6].0;
stKistlerOutTelegram.bOkTotal  := GVL_KISTLER_IO.aKistlerIn[6].1;
stKistlerOutTelegram.bNokTotal := GVL_KISTLER_IO.aKistlerIn[6].2;
stKistlerOutTelegram.bWarning  := GVL_KISTLER_IO.aKistlerIn[6].6;
stKistlerOutTelegram.bAlarm    := GVL_KISTLER_IO.aKistlerIn[6].7;

// Byte 9 - Mirrored commands / sequence request
stKistlerOutTelegram.bMirrorDriveEnable    := GVL_KISTLER_IO.aKistlerIn[9].0;
stKistlerOutTelegram.bMirrorRunSequence    := GVL_KISTLER_IO.aKistlerIn[9].1;
stKistlerOutTelegram.bMirrorDriveToHomePos := GVL_KISTLER_IO.aKistlerIn[9].2;
stKistlerOutTelegram.bMirrorDriveToRefPos  := GVL_KISTLER_IO.aKistlerIn[9].3;
stKistlerOutTelegram.bWaitRequest          := GVL_KISTLER_IO.aKistlerIn[9].6;

// Byte 10 - Sequence / drive status
stKistlerOutTelegram.bSequenceStopped := GVL_KISTLER_IO.aKistlerIn[10].0;
stKistlerOutTelegram.bSequenceEnd     := GVL_KISTLER_IO.aKistlerIn[10].1;
//stKistlerOutTelegram.bSequenceError   := GVL_KISTLER_IO.aKistlerIn[10].4;
stKistlerOutTelegram.bSequenceError   := FALSE;
stKistlerOutTelegram.bDriveEnabled    := GVL_KISTLER_IO.aKistlerIn[10].5; // olhar essa 
stKistlerOutTelegram.bHomePosReached  := GVL_KISTLER_IO.aKistlerIn[10].6;
stKistlerOutTelegram.bRefPosReached   := GVL_KISTLER_IO.aKistlerIn[10].7;

// Byte 11 - Servo / safety status
stKistlerOutTelegram.bStandStill       := GVL_KISTLER_IO.aKistlerIn[11].0;
stKistlerOutTelegram.bServoWarning     := GVL_KISTLER_IO.aKistlerIn[11].2;
stKistlerOutTelegram.bServoError       := GVL_KISTLER_IO.aKistlerIn[11].3;
//stKistlerOutTelegram.bServoError       := FALSE;
stKistlerOutTelegram.bSMES_STO         := GVL_KISTLER_IO.aKistlerIn[11].4;
stKistlerOutTelegram.bSMST             := GVL_KISTLER_IO.aKistlerIn[11].5;
stKistlerOutTelegram.bSMM              := GVL_KISTLER_IO.aKistlerIn[11].6;
stKistlerOutTelegram.bUserModeActive   := GVL_KISTLER_IO.aKistlerIn[11].7;

// Byte 19 - Communication status
//stKistlerOutTelegram.bTransmissionFault := GVL_KISTLER_IO.aKistlerIn[19].0;
stKistlerOutTelegram.bTransmissionFault := FALSE;
stKistlerOutTelegram.bAck               := GVL_KISTLER_IO.aKistlerIn[19].1;
stKistlerOutTelegram.bDeviceAvailable   := GVL_KISTLER_IO.aKistlerIn[19].2;

// =================================================================================
// KISTLER OUTPUT TELEGRAM STRUCT -> INTERNAL STATUS
// =================================================================================

// =================================================================================
// INTERNAL STATUS
// =================================================================================

// Kistler is ready from communication/device point of view.
// This does not mean machine is allowed to run.
stKistler_Status.bReady :=
    stKistlerOutTelegram.bDeviceAvailable
    AND NOT stKistlerOutTelegram.bServoError
    AND NOT stKistlerOutTelegram.bTransmissionFault;


// Sequence is running.
// MirrorRunSequence confirms command accepted, and SequenceEnd is still false.
stKistler_Status.bBusy :=
    stKistlerOutTelegram.bMirrorRunSequence
    AND NOT stKistlerOutTelegram.bSequenceEnd
    AND NOT stKistlerOutTelegram.bSequenceStopped;


// Sequence finished, regardless of OK or NOK result.
stKistler_Status.bDone :=
    stKistlerOutTelegram.bSequenceEnd;


// Part result OK.
stKistler_Status.bPartOK :=
    stKistlerOutTelegram.bSequenceEnd
    AND stKistlerOutTelegram.bOkTotal;


// Part result NOK / rejected part.
// Important: this is NOT a technical error.
stKistler_Status.bPartNOK :=
    stKistlerOutTelegram.bSequenceEnd
    AND stKistlerOutTelegram.bNokTotal;


// Technical error only.
// NOK result must not be included here.
stKistler_Status.bError :=
    stKistlerOutTelegram.bServoError
    OR stKistlerOutTelegram.bTransmissionFault
    OR stKistlerOutTelegram.bSequenceError;


// Position status
stKistler_Status.bInPosition :=
    stKistlerOutTelegram.bHomePosReached;



// =================================================================================
// BYTES 20..23 - CURRENT X VALUE
// X = DISTANCE / DISPLACEMENT / TRAVEL
// =================================================================================

uKistlerCurrentValueX.aBytes[0] := GVL_KISTLER_IO.aKistlerIn[20];
uKistlerCurrentValueX.aBytes[1] := GVL_KISTLER_IO.aKistlerIn[21];
uKistlerCurrentValueX.aBytes[2] := GVL_KISTLER_IO.aKistlerIn[22];
uKistlerCurrentValueX.aBytes[3] := GVL_KISTLER_IO.aKistlerIn[23];

stKistlerOutTelegram.rCurrentValueX :=
    uKistlerCurrentValueX.rValue;


// =================================================================================
// BYTES 24..27 - CURRENT Y VALUE
// Y = FORCE
// =================================================================================

uKistlerCurrentValueY.aBytes[0] := GVL_KISTLER_IO.aKistlerIn[24];
uKistlerCurrentValueY.aBytes[1] := GVL_KISTLER_IO.aKistlerIn[25];
uKistlerCurrentValueY.aBytes[2] := GVL_KISTLER_IO.aKistlerIn[26];
uKistlerCurrentValueY.aBytes[3] := GVL_KISTLER_IO.aKistlerIn[27];

stKistlerOutTelegram.rCurrentValueY :=
    uKistlerCurrentValueY.rValue;
	
	
	// =================================================================================
// MAP LIVE VALUES TO INTERNAL KISTLER STATUS
// =================================================================================

stKistler_Status.rLiveDistance :=
    stKistlerOutTelegram.rCurrentValueX;

stKistler_Status.rLiveForce :=
    stKistlerOutTelegram.rCurrentValueY;


// =================================================================================
// OPTIONAL LIVE VALUES FOR HMI
// =================================================================================

GVL_HMI.rKistlerLiveDistance :=
    stKistler_Status.rLiveDistance;

GVL_HMI.rKistlerLiveForce :=
    stKistler_Status.rLiveForce;
	
	// =================================================================================
// EO2 - DISTANCE LIMITS
// =================================================================================

uKistlerEO2_XMax.aBytes[0] := GVL_KISTLER_IO.aKistlerIn[180];
uKistlerEO2_XMax.aBytes[1] := GVL_KISTLER_IO.aKistlerIn[181];
uKistlerEO2_XMax.aBytes[2] := GVL_KISTLER_IO.aKistlerIn[182];
uKistlerEO2_XMax.aBytes[3] := GVL_KISTLER_IO.aKistlerIn[183];

uKistlerEO2_XMin.aBytes[0] := GVL_KISTLER_IO.aKistlerIn[184];
uKistlerEO2_XMin.aBytes[1] := GVL_KISTLER_IO.aKistlerIn[185];
uKistlerEO2_XMin.aBytes[2] := GVL_KISTLER_IO.aKistlerIn[186];
uKistlerEO2_XMin.aBytes[3] := GVL_KISTLER_IO.aKistlerIn[187];

stKistlerOutTelegram.rDistanceMax := uKistlerEO2_XMax.rValue;
stKistlerOutTelegram.rDistanceMin := uKistlerEO2_XMin.rValue;


// =================================================================================
// EO1 - FORCE LIMITS
// =================================================================================

uKistlerEO1_YMax.aBytes[0] := GVL_KISTLER_IO.aKistlerIn[188];
uKistlerEO1_YMax.aBytes[1] := GVL_KISTLER_IO.aKistlerIn[189];
uKistlerEO1_YMax.aBytes[2] := GVL_KISTLER_IO.aKistlerIn[190];
uKistlerEO1_YMax.aBytes[3] := GVL_KISTLER_IO.aKistlerIn[191];

uKistlerEO1_YMin.aBytes[0] := GVL_KISTLER_IO.aKistlerIn[192];
uKistlerEO1_YMin.aBytes[1] := GVL_KISTLER_IO.aKistlerIn[193];
uKistlerEO1_YMin.aBytes[2] := GVL_KISTLER_IO.aKistlerIn[194];
uKistlerEO1_YMin.aBytes[3] := GVL_KISTLER_IO.aKistlerIn[195];

stKistlerOutTelegram.rForceMax := uKistlerEO1_YMax.rValue;
stKistlerOutTelegram.rForceMin := uKistlerEO1_YMin.rValue;
// =================================================================================
// METHOD EXECUTION FEEDBACK
// =================================================================================

M_KistlerConfig_Output := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_KistlerControl" Id="{142f0c7b-5ff7-4bb2-a407-a7b85664501f}" FolderPath="Kistler\">
      <Declaration><![CDATA[METHOD PRIVATE M_KistlerControl : BOOL
VAR_INPUT
    eCurrentState : E_MachineState;
END_VAR

VAR
    bKistlerSafetyEnableOK : BOOL;
END_VAR


]]></Declaration>
      <Implementation>
        <ST><![CDATA[

// =========================================================
// RESET BUTTON DETECTION
// =========================================================

// F_TRIG generates the event when the reset button is released
fbResetTrigger(
    CLK := GVL_MASTER.i_bButtonReset
);


// Perform the complete process reset only in allowed states
IF fbResetTrigger.Q
    AND eCurrentState <> E_MachineState.SYSTEM_AUTO_CYCLE
    AND eCurrentState <> E_MachineState.SYSTEM_READY_TO_START
THEN

    M_ResetProcessCycle();

END_IF;


// =========================================================
// KISTLER RESET / ALARM ACKNOWLEDGEMENT PULSE
// =========================================================

// bKistlerResetPulse is set by M_ResetProcessCycle()
tonKistlerReset(
    IN := bKistlerResetPulse,
    PT := T#500MS
);

// This is the command that is actually sent to the Kistler
stKistler_CMD.bReset := bKistlerResetPulse;


// End the pulse after 500 ms
IF tonKistlerReset.Q THEN

    bKistlerResetPulse := FALSE;

END_IF;


// =========================================================
// ABORT
// =========================================================

// Keep abort active while the machine is faulted
stKistler_CMD.bAbort :=
    (eCurrentState = E_MachineState.FAULT)
    OR
    (eCurrentState = E_MachineState.STOPPING);


// =========================================================
// ENABLE
// =========================================================

stKistler_CMD.bEnable :=
    GVL_MASTER.stMachineStatus.bSafety
    AND GVL_KISTLER_IO.bKistlerSafetyEnableOK
    AND NOT GVL_MASTER.i_bButtonEmergencyStop
    AND NOT GVL_MASTER.stMachineStatus.bFault
    AND
    (
        eCurrentState = E_MachineState.SYSTEM_INITIALISING
        OR eCurrentState = E_MachineState.SYSTEM_READY_TO_START
        OR eCurrentState = E_MachineState.SYSTEM_AUTO_CYCLE
        OR eCurrentState = E_MachineState.STOPPING
        OR
        (
            eCurrentState = E_MachineState.MANUAL_MODE
            AND GVL_HMI.i_bHMIKistlerManualEnable
        )
    );


// =========================================================
// MANUAL MODE
// =========================================================

stKistler_CMD.bManualMode :=
    eCurrentState = E_MachineState.MANUAL_MODE
    AND GVL_HMI.i_bHMIKistlerManualEnable;


// =========================================================
// MOTION / SEQUENCE COMMAND DEFAULTS
// =========================================================

// M_KistlerStateMachine(), called later in the PLC cycle,
// may activate these commands when required.

stKistler_CMD.bStart            := FALSE;
stKistler_CMD.bRunSequence      := FALSE;
stKistler_CMD.bDriveToHome      := FALSE;
stKistler_CMD.bDriveToRef       := FALSE;
stKistler_CMD.bContinueFromWait := FALSE;
stKistler_CMD.bTareY            := FALSE;


// =========================================================
// METHOD EXECUTION FEEDBACK
// =========================================================

M_KistlerControl := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_KistlerStateMachine" Id="{537fbedf-c4eb-4029-b5fd-b3d3431bc3e9}" FolderPath="Kistler\">
      <Declaration><![CDATA[METHOD PRIVATE M_KistlerStateMachine : BOOL

VAR_INPUT
    eCurrentState : E_MachineState;

END_VAR

VAR
    bKistlerEnableAllowed    : BOOL;
    bKistlerAutoCycleAllowed : BOOL;
    bKistlerManualAllowed    : BOOL;
    bKistlerSequenceAllowed  : BOOL;
	

	
	
	Teste 			: BOOL :=TRUE;
END_VAR

VAR_INST
    rTrigTwoHands : R_TRIG; // Edge trigger to detect single press of the two-hand safety signal

END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// =================================================================================
// KISTLER STATE MACHINE
// maXYmos NC logical sequence control
// =================================================================================
// Input:
//     eCurrentState
//     stKistlerOutTelegram
//     stKistler_Status
//
// Output:
//     stKistler_CMD
// =================================================================================


// =================================================================================
// KISTLER OPERATION MODE PERMISSIVES
// =================================================================================

// Kistler may be enabled and stay READY in Ready To Start.
// It may also be enabled during Auto Cycle.
// In Manual Mode, it may be enabled only when the HMI manual enable is active.
bKistlerEnableAllowed :=
    (eCurrentState = E_MachineState.SYSTEM_READY_TO_START)
    OR (eCurrentState = E_MachineState.SYSTEM_AUTO_CYCLE)
	OR (eCurrentState = E_MachineState.SYSTEM_INITIALISING)
    OR (
        (eCurrentState = E_MachineState.MANUAL_MODE)
    );

// Kistler is allowed to run automatically during Auto Cycle.
bKistlerAutoCycleAllowed :=
    (eCurrentState = E_MachineState.SYSTEM_AUTO_CYCLE 
	OR eCurrentState = E_MachineState.SYSTEM_INITIALISING);

// Kistler is allowed to run in Manual Mode only when the HMI manual enable is active.
bKistlerManualAllowed :=
    (eCurrentState = E_MachineState.MANUAL_MODE)
    AND GVL_HMI.i_bHMIKistlerManualEnable;

// Final permissive used by the Kistler sequence.
// Auto Cycle works as before.
// Manual Mode works only when the HMI Kistler manual enable is TRUE.
bKistlerSequenceAllowed :=
    bKistlerAutoCycleAllowed
    OR bKistlerManualAllowed;


// Evaluate positive edge of the safety-certified two-hand control
rTrigTwoHands(CLK := GVL_IO.stSafety.bTwoHandsSafe);
tTwoHandTargetTime := REAL_TO_TIME(rHmiTwoHandPresetTime);   // Convert the HMI float milliseconds value into PLC TIME data type
tTwoHandHoldTimer(IN := GVL_IO.stSafety.bTwoHandsSafe, PT := tTwoHandTargetTime); // Execute the verification timer tied to the physical two-hand safety input





// =================================================================================
// LOCAL / GLOBAL SAFETY AND MACHINE OVERRIDES
// =================================================================================

// Machine stopped, stopping, faulted or Kistler safety not enabled:
// no Kistler movement command is allowed.
IF (eCurrentState = E_MachineState.FAULT)
   OR (eCurrentState = E_MachineState.STOPPING)
   OR (eCurrentState = E_MachineState.STOPPED)
   OR NOT GVL_KISTLER_IO.bKistlerSafetyEnableOK THEN

    stKistler_CMD.bStart := FALSE;              // Byte 0.0 - Measurement Start
    stKistler_CMD.bRunSequence := FALSE;        // Byte 9.1 - Run Sequence
    stKistler_CMD.bDriveToHome := FALSE;        // Byte 9.2 - Drive To Home
    stKistler_CMD.bDriveToRef := FALSE;         // Byte 9.3 - Drive To Reference
    stKistler_CMD.bContinueFromWait := FALSE;   // Byte 9.6 - Continue From Wait
    stKistler_CMD.bTareY := FALSE;              // Byte 0.1 - Tare Y

    stKistler_Status.eKistlerState := E_KistlerState.DISABLED;

    M_KistlerStateMachine := TRUE;
    RETURN;

END_IF;


// Technical Kistler error.
// Important: NOK part result must NOT be treated here as technical error.
// Technical errors are: sequence error, servo error, communication/transmission fault.
IF stKistlerOutTelegram.bSequenceError
   OR stKistlerOutTelegram.bServoError
   OR stKistlerOutTelegram.bTransmissionFault THEN

    stKistler_CMD.bStart := FALSE;
    stKistler_CMD.bRunSequence := FALSE;
    stKistler_CMD.bDriveToHome := FALSE;
    stKistler_CMD.bDriveToRef := FALSE;
    stKistler_CMD.bContinueFromWait := FALSE;
    stKistler_CMD.bTareY := FALSE;

    stKistler_Status.eKistlerState := E_KistlerState.ERROR;
	M_KistlerStateMachine := TRUE;
    RETURN;

END_IF;


// =================================================================================
// ENABLE / READY WITHOUT SEQUENCE
// =================================================================================

// If sequence is not allowed, do not allow Kistler movement commands.
// However, in SYSTEM_READY_TO_START the Kistler can stay enabled and READY.
IF NOT bKistlerSequenceAllowed THEN

    stKistler_CMD.bStart := FALSE;
    stKistler_CMD.bRunSequence := FALSE;
    stKistler_CMD.bDriveToHome := FALSE;
    stKistler_CMD.bDriveToRef := FALSE;
    stKistler_CMD.bContinueFromWait := FALSE;
    stKistler_CMD.bTareY := FALSE;

    // Ready To Start case:
    // Kistler is allowed to be enabled and ready, but no sequence is started.
    IF bKistlerEnableAllowed AND stKistler_CMD.bEnable THEN

        IF stKistler_Status.bError THEN

            stKistler_Status.eKistlerState := E_KistlerState.ERROR;

        ELSE

            IF stKistler_Status.eKistlerState = E_KistlerState.DISABLED THEN
                stKistler_Status.eKistlerState := E_KistlerState.READY;
            END_IF

            IF (stKistler_Status.eKistlerState = E_KistlerState.HOMING)
               OR (stKistler_Status.eKistlerState = E_KistlerState.REFERENCING)
               OR (stKistler_Status.eKistlerState = E_KistlerState.SET_PARAMETERS)
               OR (stKistler_Status.eKistlerState = E_KistlerState.PRESS_READY)
               OR (stKistler_Status.eKistlerState = E_KistlerState.RUN_SEQUENCE)
               OR (stKistler_Status.eKistlerState = E_KistlerState.BUSY) THEN

                stKistler_Status.eKistlerState := E_KistlerState.READY;

            END_IF

        END_IF

    ELSE

        stKistler_Status.eKistlerState := E_KistlerState.DISABLED;

    END_IF

    M_KistlerStateMachine := TRUE;
    RETURN;

END_IF;


// =================================================================================
// KISTLER STATE MACHINE
// =================================================================================

CASE eCurrentState OF

    // =========================================================================
    // AUTO CYCLE OR MANUAL MODE WITH HMI KISTLER ENABLE
    // =========================================================================
    E_MachineState.SYSTEM_AUTO_CYCLE,
	E_MachineState.SYSTEM_INITIALISING,
	E_MachineState.MANUAL_MODE:

        CASE stKistler_Status.eKistlerState OF


            // =========================================================================
            // DISABLED
            // =========================================================================
            E_KistlerState.DISABLED:

                stKistler_CMD.bStart 			:= FALSE;
                stKistler_CMD.bRunSequence 		:= FALSE;
                stKistler_CMD.bDriveToHome 		:= FALSE;
                stKistler_CMD.bDriveToRef 		:= FALSE;
                stKistler_CMD.bContinueFromWait := FALSE;
                stKistler_CMD.bTareY 			:= FALSE;

                IF stKistler_CMD.bEnable THEN
                    stKistler_Status.eKistlerState := E_KistlerState.READY;
                END_IF


            // =========================================================================
            // READY
            // Kistler is enabled and waiting for Auto Cycle or enabled Manual Mode.
            // =========================================================================
            E_KistlerState.READY:

                stKistler_CMD.bStart 			:= FALSE;
                stKistler_CMD.bRunSequence 		:= FALSE;
                stKistler_CMD.bDriveToHome 		:= FALSE;
                stKistler_CMD.bDriveToRef 		:= FALSE;
                stKistler_CMD.bContinueFromWait := FALSE;
                stKistler_CMD.bTareY 			:= FALSE;

                IF stKistler_Status.bError THEN

                    stKistler_Status.eKistlerState := E_KistlerState.ERROR;
					
				ELSIF NOT bKistlerInitialised OR bKistlerRecoveryHomeRequest THEN
					
					stKistler_Status.eKistlerState := E_KistlerState.HOMING;

                ELSIF bKistlerSequenceAllowed
      				AND GVL_MASTER.stProcess.bKistlerCycleRequest THEN

                    // In this project, RefPosReached can be used as initial/home position reference.
                    // If both Home and Ref are false, request homing using DriveToRef.
                    IF NOT stKistlerOutTelegram.bHomePosReached
                       AND NOT stKistlerOutTelegram.bRefPosReached THEN
					   
                        stKistler_Status.eKistlerState := E_KistlerState.HOMING;
	
                    ELSE
						
                        stKistler_Status.eKistlerState := E_KistlerState.SET_PARAMETERS;
						
                    END_IF

               END_IF


            // =========================================================================
            // HOMING
            // Based on reference project TE1096:
            // GOTO_HOME_POS uses DriveToRef command and waits for HomePosReached/RefPosReached.
            // =========================================================================
            E_KistlerState.HOMING:

                stKistler_CMD.bStart 				:= FALSE;
                stKistler_CMD.bRunSequence 			:= FALSE;
                //stKistler_CMD.bDriveToHome 			:= FALSE;
                stKistler_CMD.bContinueFromWait 	:= FALSE;
                stKistler_CMD.bTareY 				:= FALSE;
				
				IF stKistler_CMD.bDriveToRef THEN

    				stKistler_CMD.bDriveToRef := FALSE;

				END_IF;

                // Use DriveToRef for initial/home movement.
                stKistler_CMD.bDriveToRef := TRUE;
				
				IF stKistler_Status.bInPosition 
					AND eCurrentState = E_MachineState.SYSTEM_INITIALISING THEN

    				bKistlerRecoveryHomeRequest := FALSE;
					

				END_IF;

                IF stKistler_Status.bError THEN

                    stKistler_CMD.bDriveToRef := FALSE;
                    stKistler_Status.eKistlerState := E_KistlerState.ERROR;

                ELSIF stKistler_Status.bInPosition 
					OR stKistlerOutTelegram.bHomePosReached
                    OR stKistlerOutTelegram.bRefPosReached THEN

                    stKistler_CMD.bDriveToRef := FALSE;
                    stKistler_Status.eKistlerState := E_KistlerState.HOME_DONE;

                END_IF


            // =========================================================================
            // HOME_DONE
            // Home/reference reached. Next step: prepare parameters.
            // =========================================================================
            E_KistlerState.HOME_DONE:

                stKistler_CMD.bStart := FALSE;
                stKistler_CMD.bRunSequence := FALSE;
                stKistler_CMD.bDriveToHome := FALSE;
                stKistler_CMD.bDriveToRef := FALSE;
                stKistler_CMD.bContinueFromWait := FALSE;
                stKistler_CMD.bTareY := FALSE;

                IF stKistler_Status.bError THEN

                    stKistler_Status.eKistlerState := E_KistlerState.ERROR;

                ELSIF bKistlerSequenceAllowed
     				 AND GVL_MASTER.stProcess.bKistlerCycleRequest THEN

    				stKistler_Status.eKistlerState := E_KistlerState.SET_PARAMETERS;

				ELSE

   					stKistler_Status.eKistlerState := E_KistlerState.READY;

				END_IF


            // =========================================================================
            // SET_PARAMETERS
            // Prepare maXYmos before running sequence.
            // Based on reference project: Tare Y before press cycle.
            // =========================================================================
			E_KistlerState.SET_PARAMETERS:

				stKistler_CMD.bStart := FALSE;
				stKistler_CMD.bRunSequence := FALSE;
				stKistler_CMD.bDriveToHome := FALSE;
				stKistler_CMD.bDriveToRef := FALSE;
				stKistler_CMD.bContinueFromWait := FALSE;
			
				stKistler_CMD.bTareY := TRUE;
			
				tonKistlerTareYDelay(
					IN := stKistlerOutTelegram.bMirrorTareY,
					PT := T#500MS
				);
			
				IF stKistler_Status.bError THEN
			
					stKistler_CMD.bTareY := FALSE;
			
					tonKistlerTareYDelay(IN := FALSE);
					tonGuideCylinderDelay(IN := FALSE);
			
					GVL_MASTER.stActuators.bGuideCylinderExtendRequest := FALSE;
			
					GVL_MASTER.stNestTable.bSupportExtendRequest := FALSE;
					GVL_MASTER.stNestTable.bSupportRetractRequest := TRUE;
			
					stKistler_Status.eKistlerState := E_KistlerState.ERROR;
			
				ELSIF tonKistlerTareYDelay.Q THEN
			
					IF GVL_MASTER.stNestTable.bNestReadySensor
						AND GVL_MASTER.stNestTable.bNestLockedSensor
						AND NOT GVL_MASTER.stNestTable.bNestInMotion
						AND eCurrentNestPos <> E_NestPosition.Unknown THEN
			
						GVL_MASTER.stNestTable.bSupportExtendRequest := TRUE;
						GVL_MASTER.stNestTable.bSupportRetractRequest := FALSE;
			
						IF GVL_MASTER.stNestTable.bSupportExtended THEN
			
							tonGuideCylinderDelay(
								IN := TRUE,
								PT := tGuideCylinderDelay 
							);
			
							IF tonGuideCylinderDelay.Q THEN
			
								GVL_MASTER.stActuators.bGuideCylinderExtendRequest := TRUE;
			
								stKistler_CMD.bTareY := FALSE;
			
								tonKistlerTareYDelay(IN := FALSE);
								tonGuideCylinderDelay(IN := FALSE);
			
								stKistler_Status.eKistlerState := E_KistlerState.PRESS_READY;
			
							ELSE
			
								GVL_MASTER.stActuators.bGuideCylinderExtendRequest := FALSE;
			
							END_IF
			
						ELSE
			
							tonGuideCylinderDelay(IN := FALSE);
							GVL_MASTER.stActuators.bGuideCylinderExtendRequest := FALSE;
			
						END_IF
			
					ELSE
			
						tonGuideCylinderDelay(IN := FALSE);
			
						GVL_MASTER.stActuators.bGuideCylinderExtendRequest := FALSE;
			
						GVL_MASTER.stNestTable.bSupportExtendRequest := FALSE;
						GVL_MASTER.stNestTable.bSupportRetractRequest := TRUE;
			
					END_IF
			
				ELSE
			
					tonGuideCylinderDelay(IN := FALSE);
					GVL_MASTER.stActuators.bGuideCylinderExtendRequest := FALSE;
			
				END_IF
            // =========================================================================
            // PRESS_READY
            // Preparation done. Next step: run sequence.
            // =========================================================================
            E_KistlerState.PRESS_READY:

                tonKistlerTareYDelay(IN := FALSE);

                stKistler_CMD.bStart := FALSE;
                stKistler_CMD.bRunSequence := FALSE;
                stKistler_CMD.bDriveToHome := FALSE;
                stKistler_CMD.bDriveToRef := FALSE;
                stKistler_CMD.bContinueFromWait := FALSE;
                stKistler_CMD.bTareY := FALSE;
				
	
                IF stKistler_Status.bError THEN

                    stKistler_Status.eKistlerState := E_KistlerState.ERROR;

                ELSIF bKistlerSequenceAllowed
      				AND GVL_MASTER.stProcess.bKistlerCycleRequest THEN
					GVL_MASTER.stActuators.bGuideCylinderExtendRequest := TRUE;
					stKistler_Status.eKistlerState := E_KistlerState.RUN_SEQUENCE;
			
				ELSE
			
					stKistler_Status.eKistlerState := E_KistlerState.READY;
			
				END_IF


            // =========================================================================
            // REFERENCING
            // Optional state. Currently not used in normal flow.
            // =========================================================================
            E_KistlerState.REFERENCING:

                stKistler_CMD.bStart := FALSE;
                stKistler_CMD.bRunSequence := FALSE;
                stKistler_CMD.bDriveToHome := FALSE;
                stKistler_CMD.bContinueFromWait := FALSE;
                stKistler_CMD.bTareY := FALSE;

                stKistler_CMD.bDriveToRef := TRUE;

                IF stKistler_Status.bError THEN

                    stKistler_CMD.bDriveToRef := FALSE;
                    stKistler_Status.eKistlerState := E_KistlerState.ERROR;

                ELSIF stKistlerOutTelegram.bRefPosReached THEN

                    stKistler_CMD.bDriveToRef := FALSE;
                    stKistler_Status.eKistlerState := E_KistlerState.REF_DONE;

                END_IF


            // =========================================================================
            // REF_DONE
            // Optional state. Currently not used in normal flow.
            // =========================================================================
            E_KistlerState.REF_DONE:

                stKistler_CMD.bStart := FALSE;
                stKistler_CMD.bRunSequence := FALSE;
                stKistler_CMD.bDriveToHome := FALSE;
                stKistler_CMD.bDriveToRef := FALSE;
                stKistler_CMD.bContinueFromWait := FALSE;
                stKistler_CMD.bTareY := FALSE;

                IF stKistler_Status.bError THEN

                    stKistler_Status.eKistlerState := E_KistlerState.ERROR;

                ELSIF bKistlerSequenceAllowed THEN

                    stKistler_Status.eKistlerState := E_KistlerState.SET_PARAMETERS;

                END_IF


            // =========================================================================
            // RUN_SEQUENCE
            // Command: Start Sequence through RUN-SEQUENCE bit.
            //
            // Important:
            // Byte 9.1 RunSequence = Start Sequence
            // Byte 0.0 Start       = Measurement Start, not sequence start.
            // =========================================================================
			 E_KistlerState.RUN_SEQUENCE:
			
				stKistler_CMD.bStart := FALSE; // Do not use Measurement Start here
				stKistler_CMD.bDriveToHome := FALSE;
				stKistler_CMD.bDriveToRef := FALSE;
				stKistler_CMD.bContinueFromWait := FALSE;
				stKistler_CMD.bTareY := FALSE;
				
				GVL_MASTER.stNestTable.bSupportExtendRequest := TRUE;
				GVL_MASTER.stNestTable.bSupportRetractRequest := FALSE;
				
				GVL_MASTER.stActuators.bGuideCylinderExtendRequest := TRUE;
			
				IF stKistler_Status.bError THEN
			
					stKistler_CMD.bRunSequence := FALSE;
					stKistler_Status.eKistlerState := E_KistlerState.ERROR;
			
				ELSE
			
					// Keep sequence command active until Kistler reacts
					stKistler_CMD.bRunSequence := TRUE;
			
					// If Kistler reports Busy, go to BUSY state
					IF stKistler_Status.bBusy THEN
			
						stKistler_Status.eKistlerState := E_KistlerState.BUSY;
			
					END_IF
			
				END_IF


            // =========================================================================
            // BUSY
            // Sequence is running.
            // Keep RunSequence active during Auto Cycle or enabled Manual Mode.
            // Handle WAIT request if the MP contains WAIT element.
            // =========================================================================
            E_KistlerState.BUSY:

                IF bKistlerSequenceAllowed
   					AND GVL_MASTER.stProcess.bKistlerCycleRequest THEN

				    stKistler_CMD.bStart := FALSE;
					stKistler_CMD.bRunSequence := TRUE;
					stKistler_CMD.bDriveToHome := FALSE;
					stKistler_CMD.bDriveToRef := FALSE;
					stKistler_CMD.bContinueFromWait := FALSE;
					stKistler_CMD.bTareY := FALSE;

                    // Process WAIT handling
                    IF stKistlerOutTelegram.bWaitRequest THEN
                        stKistler_CMD.bContinueFromWait := TRUE;
                    ELSE
                        stKistler_CMD.bContinueFromWait := FALSE;
                    END_IF

                ELSE

                    stKistler_CMD.bRunSequence := FALSE;
                    stKistler_CMD.bDriveToHome := FALSE;
                    stKistler_CMD.bDriveToRef := FALSE;
                    stKistler_CMD.bStart := FALSE;
                    stKistler_CMD.bContinueFromWait := FALSE;
                    stKistler_CMD.bTareY := FALSE;

                    stKistler_Status.eKistlerState := E_KistlerState.READY;

                END_IF

                IF stKistler_Status.bError THEN

                    stKistler_CMD.bRunSequence := FALSE;
                    stKistler_CMD.bDriveToHome := FALSE;
                    stKistler_CMD.bDriveToRef := FALSE;
                    stKistler_CMD.bStart := FALSE;
                    stKistler_CMD.bContinueFromWait := FALSE;
                    stKistler_CMD.bTareY := FALSE;

                    stKistler_Status.eKistlerState := E_KistlerState.ERROR;

                ELSIF stKistlerOutTelegram.bSequenceEnd THEN

                    stKistler_CMD.bRunSequence := FALSE;
                    stKistler_CMD.bDriveToHome := FALSE;
                    stKistler_CMD.bDriveToRef := FALSE;
                    stKistler_CMD.bStart := FALSE;
                    stKistler_CMD.bContinueFromWait := FALSE;
                    stKistler_CMD.bTareY := FALSE;

                    stKistler_Status.eKistlerState := E_KistlerState.DONE;

                ELSIF NOT stKistler_Status.bBusy THEN

                    stKistler_CMD.bContinueFromWait := FALSE;
                    stKistler_CMD.bTareY := FALSE;
                    stKistler_Status.eKistlerState := E_KistlerState.RUN_SEQUENCE;

                END_IF


            // =========================================================================
            // DONE
            // Sequence finished.
            // Result can be OK or NOK.
            // NOK is not a technical error here.
            // =========================================================================
            E_KistlerState.DONE:

				stKistler_CMD.bStart := FALSE;
				stKistler_CMD.bRunSequence := FALSE;
				stKistler_CMD.bDriveToHome := FALSE;
				stKistler_CMD.bDriveToRef := FALSE;
				stKistler_CMD.bContinueFromWait := FALSE;
				stKistler_CMD.bTareY := FALSE;
			
						
				GVL_MASTER.stActuators.bGuideCylinderExtendRequest := FALSE;

				IF stKistler_Status.bError THEN
					tonGuideCylinderRetractDelay(IN := FALSE);
					stKistler_Status.eKistlerState := E_KistlerState.ERROR;
				END_IF
				
				tonGuideCylinderDelay(
					IN := TRUE,
					PT := tGuideCylinderDelay 
				);
				
				IF tonGuideCylinderDelay.Q THEN

					GVL_MASTER.stNestTable.bSupportExtendRequest := FALSE;
					GVL_MASTER.stNestTable.bSupportRetractRequest := TRUE;
				
					IF NOT GVL_MASTER.stProcess.bKistlerCycleRequest
						AND NOT GVL_MASTER.stProcess.bNestTestingReady
						AND NOT GVL_MASTER.stProcess.bReleaseNestRotation THEN
				
						tonGuideCylinderRetractDelay(IN := FALSE);
				
						IF stKistler_CMD.bEnable THEN
								stKistler_Status.eKistlerState := E_KistlerState.READY;
						ELSE
								stKistler_Status.eKistlerState := E_KistlerState.DISABLED;
						END_IF
				
					END_IF
				
				END_IF

            // =========================================================================
            // ERROR
            // Technical error state.
            // Commands are disabled until error clears and reset/enable condition returns.
            // =========================================================================
            E_KistlerState.ERROR:

                stKistler_CMD.bStart := FALSE;
                stKistler_CMD.bRunSequence := FALSE;
                stKistler_CMD.bDriveToHome := FALSE;
                stKistler_CMD.bDriveToRef := FALSE;
                stKistler_CMD.bContinueFromWait := FALSE;
                stKistler_CMD.bTareY := FALSE;
				
				GVL_MASTER.stNestTable.bSupportExtendRequest  := FALSE;
				GVL_MASTER.stNestTable.bSupportRetractRequest := TRUE;

                IF NOT stKistler_Status.bError THEN

                    IF stKistler_CMD.bEnable THEN
                        stKistler_Status.eKistlerState := E_KistlerState.READY;
                    ELSE
                        stKistler_Status.eKistlerState := E_KistlerState.DISABLED;
                    END_IF

                END_IF

        END_CASE;



    // =========================================================================
    // MACHINE FAULT
    // =========================================================================
    E_MachineState.FAULT:

        stKistler_CMD.bStart 							:= FALSE;
        stKistler_CMD.bRunSequence 						:= FALSE;
        stKistler_CMD.bDriveToHome 						:= FALSE;
        stKistler_CMD.bDriveToRef 						:= FALSE;
        stKistler_CMD.bContinueFromWait 				:= FALSE;
        stKistler_CMD.bTareY 							:= FALSE;
		GVL_MASTER.stNestTable.bSupportExtendRequest  	:= FALSE;
		GVL_MASTER.stNestTable.bSupportRetractRequest 	:= TRUE;

        IF stKistler_Status.eKistlerState <> E_KistlerState.DISABLED THEN
            stKistler_Status.eKistlerState := E_KistlerState.ERROR;
        END_IF


    // =========================================================================
    // OTHER MACHINE STATES
    // =========================================================================
		ELSE
	
			stKistler_CMD.bStart 			:= FALSE;
			stKistler_CMD.bRunSequence 		:= FALSE;
			stKistler_CMD.bDriveToHome 		:= FALSE;
			stKistler_CMD.bDriveToRef 		:= FALSE;
			stKistler_CMD.bContinueFromWait := FALSE;
			stKistler_CMD.bTareY 			:= FALSE;

END_CASE;

// =================================================================================
// METHOD EXECUTION FEEDBACK
// =================================================================================

M_KistlerStateMachine := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_LEDsButtons" Id="{a6680c49-408d-47a5-bfa3-499d1bfac7ad}">
      <Declaration><![CDATA[METHOD M_LEDsButtons : BOOL
VAR_INST
    // Static-like variables inside the method (Instantiated with the PRG)
    fbBlinker         : TON;
    bBlinkerPulse     : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// =================================================================
// 1. INTERNAL BLINKER GENERATOR
// =================================================================
fbBlinker(IN := NOT fbBlinker.Q, PT := T#500MS);
IF fbBlinker.Q THEN
    bBlinkerPulse := NOT bBlinkerPulse;
END_IF;

// =================================================================
// 2. PROCESS START LED HARDWARE OUTPUT
// =================================================================
CASE PRG_MachineControl.eMode_LED_Start OF
    E_LEDs_Mode.ON:
        PRG_MachineControl.q_bLED_Start := TRUE;
        
    E_LEDs_Mode.FLASHING:
        PRG_MachineControl.q_bLED_Start := bBlinkerPulse;
        
    E_LEDs_Mode.OFF:
        PRG_MachineControl.q_bLED_Start := FALSE;
END_CASE;

// =================================================================
// 3. PROCESS RESET LED HARDWARE OUTPUT
// =================================================================
CASE PRG_MachineControl.eMode_LED_Reset OF
    E_LEDs_Mode.ON:
        PRG_MachineControl.q_bLED_Reset := TRUE;
        
    E_LEDs_Mode.FLASHING:
        PRG_MachineControl.q_bLED_Reset := bBlinkerPulse;
        
    E_LEDs_Mode.OFF:
        PRG_MachineControl.q_bLED_Reset := FALSE;
END_CASE;
// =================================================================
// 4. PROCESS LED PASS HARDWARE OUTPUT
// =================================================================
CASE PRG_MachineControl.eMode_LED_Pass OF
    E_LEDs_Mode.ON:
        PRG_MachineControl.q_bLED_Pass := TRUE;
        
    E_LEDs_Mode.FLASHING:
        PRG_MachineControl.q_bLED_Pass := bBlinkerPulse;
        
    E_LEDs_Mode.OFF:
        PRG_MachineControl.q_bLED_Pass := FALSE;
END_CASE;

// =================================================================
// 4. PROCESS LED FAIL HARDWARE OUTPUT
// =================================================================
CASE PRG_MachineControl.eMode_LED_Fail OF
    E_LEDs_Mode.ON:
        PRG_MachineControl.q_bLED_Fail := TRUE;
        
    E_LEDs_Mode.FLASHING:
        PRG_MachineControl.q_bLED_Fail := bBlinkerPulse;
        
    E_LEDs_Mode.OFF:
        PRG_MachineControl.q_bLED_Fail := FALSE;
END_CASE;

// =================================================================
// 5. INTERNAL MACHINE LIGHT
// =================================================================
GVL_IO.stSafety.bMainDoorfeedback := GVL_IO.stTerm4_EL1918.iEL1918_Ch6;
GVL_IO.qInternalLight := NOT GVL_IO.stSafety.bMainDoorfeedback;


M_LEDsButtons := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_NestTableControl" Id="{73045679-2a70-4e2a-a7bb-96539b2fce6a}" FolderPath="Nest_Table\">
      <Declaration><![CDATA[METHOD M_NestTableControl
VAR_INST
    rTrigTwoHands 				: R_TRIG; // Edge trigger to detect single press of the two-hand safety signal
	
	bNestAutoCycleAllowed 		: BOOL;
	bNestManualAllowed    		: BOOL;
	bNestSequenceAllowed  		: BOOL;
	
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
// =================================================================
// STATE PERMISSIONS
// =================================================================

bNestAutoCycleAllowed := GVL_MASTER.stMachineStatus.eMachineState = E_MachineState.SYSTEM_AUTO_CYCLE;

bNestManualAllowed := GVL_MASTER.stMachineStatus.eMachineState = E_MachineState.MANUAL_MODE AND GVL_HMI.i_bHMIIndexerManualEnable;

bNestSequenceAllowed := bNestAutoCycleAllowed OR bNestManualAllowed;

// =================================================================
// Puck Locker fault interlock.
//
// Only automatic production depends on the Puck Locker.
//
// In Manual Mode, the machine must behave exactly as before the
// Puck Locker feature existed.
// =================================================================
IF GVL_MASTER.stMachineStatus.eMachineState = E_MachineState.SYSTEM_AUTO_CYCLE THEN


    IF GVL_MASTER.stPuckLocker.bUnexpectedRemovalFault
       OR GVL_MASTER.stPuckLocker.bPuckSensorMismatch
       OR GVL_MASTER.stPuckLocker.eState =
            E_PuckLockerState.UnexpectedPuckRemovalFault THEN

        GVL_MASTER.stNestTable.qNestRotatePortA := FALSE;
        GVL_MASTER.stNestTable.qNestRotatePortB := FALSE;
        GVL_MASTER.stNestTable.bNestInMotion    := FALSE;

        GVL_MASTER.stProcess.bNestTestingReady     := FALSE;
        GVL_MASTER.stProcess.bReleaseNestRotation  := FALSE;

        eNestState := E_NestState.FAULT;


        RETURN;

    END_IF
	
END_IF

IF NOT bNestSequenceAllowed
   AND GVL_MASTER.stMachineStatus.eMachineState <>
       E_MachineState.FAULT THEN

    GVL_MASTER.stNestTable.qNestRotatePortA := FALSE;
    GVL_MASTER.stNestTable.qNestRotatePortB := FALSE;
    GVL_MASTER.stNestTable.bNestInMotion 	:= FALSE;
    GVL_MASTER.stProcess.bNestTestingReady 	:= FALSE;

    eNestState := E_NestState.IDLE;
    RETURN;

END_IF

// =================================================================
// 1. EMERGENCY RESET AND GLOBAL INTERLOCK PROCESSING
// =================================================================
// Global asynchronous reset: Forces the system to IDLE and drops all outputs immediately
IF fbResetTrigger.Q 
	AND NOT GVL_Master.stMachineStatus.bAutoCycle
	AND NOT GVL_Master.stMachineStatus.bReadyToStart THEN
	
    eNestState                              		:= E_NestState.IDLE;
    bSequenceToggle                         		:= FALSE; // Always restart from rotation step after reset
    GVL_MASTER.stNestTable.bNestStartCycle  		:= FALSE;
    GVL_MASTER.stNestTable.bNestInMotion    		:= FALSE;
    GVL_MASTER.stNestTable.qNestRotatePortA 		:= FALSE;
    GVL_MASTER.stNestTable.qNestRotatePortB 		:= FALSE;
    GVL_MASTER.stNestTable.bSupportExtendRequest    := FALSE;
    GVL_MASTER.stNestTable.bSupportRetractRequest   := TRUE;  // Safe home posture for elevator

    RETURN; // Abort remaining logic execution for this cycle
END_IF

// Global Safety Interlock: Force fault state immediately if air/safety is lost
IF NOT GVL_IO.stSafety.bSafetyOK AND GVL_Master.stMachineStatus.bFault THEN
    eNestState := E_NestState.FAULT;
END_IF

//eCurrentNestPos := M_GetCurrentPosition();

// =================================================================
// 2. INPUT SIGNAL PROCESSING (TRIGGERS)
// =================================================================
// Evaluate positive edge of the safety-certified two-hand control
rTrigTwoHands(CLK := GVL_IO.stSafety.bTwoHandsSafe);
tTwoHandTargetTime := REAL_TO_TIME(rHmiTwoHandPresetTime);   // Convert the HMI float milliseconds value into PLC TIME data type
tTwoHandHoldTimer(IN := GVL_IO.stSafety.bTwoHandsSafe, PT := tTwoHandTargetTime); // Execute the verification timer tied to the physical two-hand safety input

// Trigger processing to allow automated cycle start from IDLE state
// IF rTrigTwoHands.Q AND GVL_MASTER.bStations_Home AND GVL_IO.stSafety.bSafetyOK AND (eNestState = E_NestState.IDLE) THEN
//      IF GVL_MASTER.stMachineStatus.bAutoCycle THEN
//          GVL_MASTER.stNestTable.bNestInMotion := TRUE;
//          eNestState                           := E_NestState.ROTATING_TABLE; // Start the automated cycle directly at rotation step
//      END_IF
// END_IF

// =================================================================
// 3. TIMERS EXECUTION (CYCLIC COUPLING TO MAIN PROGRAM INSTANCES)
// =================================================================
// Enchained timers execution pattern to generate an automated timeline for the TESTING state
tRotatingTableDelay(IN  := (eNestState = E_NestState.ROTATING_TABLE), PT := T#500MS);
tPortB_ResetDelay(IN    := (eNestState = E_NestState.STOP_TABLE), PT := T#1S);

// TESTING TIMELINE: 
// 1. Initial 100ms settling delay starts when entering TESTING state
tSupportRetractDelay(IN := (eNestState = E_NestState.TESTING), PT := T#100MS);
// 2. 2-Second lift holding duration executes after the initial pause finishes
tSupportExtendDelay(IN  := (eNestState = E_NestState.TESTING) AND tSupportRetractDelay.Q, PT := T#200MS);

// Two-hand return timeout.
// If the operator does not press the two-hand control again within 1 second,
// the sequence goes to FAULT.
tTwoHandReturnTimeout(IN := (eNestState = E_NestState.WRONG_POSITION),PT := T#5S);

// =================================================================
// 4. NEST TABLE STATE MACHINE CONTROL (WITH INTERNAL INTERLOCKS)
// =================================================================
CASE GVL_Master.stMachineStatus.eMachineState OF    
    
    E_MachineState.SYSTEM_AUTO_CYCLE,
	E_MachineState.MANUAL_MODE:
        
        CASE eNestState OF
        
            E_NestState.IDLE:

				GVL_MASTER.stNestTable.qNestRotatePortA := FALSE;
				GVL_MASTER.stNestTable.qNestRotatePortB := FALSE;
				GVL_MASTER.stNestTable.bNestInMotion    := FALSE;
				GVL_MASTER.stProcess.bNestTestingReady  := FALSE;
			//
				IF GVL_IO.stSafety.bSafetyOK
				   AND rTrigTwoHands.Q
				   AND GVL_MASTER.bStations_Home
				   AND GVL_MASTER.stNestTable.bSupportRetracted
				   AND bNestSequenceAllowed
				   AND (GVL_MASTER.stMachineStatus.eMachineState = E_MachineState.MANUAL_MODE
						OR GVL_MASTER.stPuckLocker.bIndexPermissive)
				   AND stKistler_Status.bInPosition
				   AND NOT stKistler_Status.bBusy THEN
				
					GVL_MASTER.stNestTable.bNestInMotion := TRUE;
					eNestState := E_NestState.ROTATING_TABLE;
				
				END_IF
        
            E_NestState.ROTATING_TABLE: // State 2: ROTATING TABLE

				GVL_MASTER.stNestTable.bNestInMotion      := TRUE;
				GVL_MASTER.stProcess.bNestTestingReady    := FALSE;
				GVL_MASTER.stNestTable.bSupportExtendRequest := FALSE;
			    GVL_MASTER.stNestTable.bSupportRetractRequest := TRUE;
			
				IF NOT GVL_IO.stSafety.bSafetyOK THEN
			
					GVL_MASTER.stNestTable.qNestRotatePortA := FALSE;
					GVL_MASTER.stNestTable.qNestRotatePortB := FALSE;
					eNestState := E_NestState.FAULT;
			
				ELSIF NOT GVL_IO.stSafety.bTwoHandsSafe
					  AND NOT tTwoHandHoldTimer.Q THEN
			
					GVL_MASTER.stNestTable.qNestRotatePortA := FALSE;
					GVL_MASTER.stNestTable.qNestRotatePortB := FALSE;
					eNestState := E_NestState.WRONG_POSITION;
			
				ELSIF NOT bNestSequenceAllowed THEN
			
					GVL_MASTER.stNestTable.qNestRotatePortA := FALSE;
					GVL_MASTER.stNestTable.qNestRotatePortB := FALSE;
					eNestState := E_NestState.IDLE;
			
				ELSIF GVL_MASTER.stNestTable.bSupportRetracted 
					AND NOT stKistler_Status.bBusy 
					AND NOT GVL_MASTER.stActuators.bGuideCylinderExtendRequest
					AND stKistler_Status.bInPosition
					AND NOT GVL_MASTER.stProcess.bKistlerCycleRequest THEN
			
					GVL_MASTER.stNestTable.qNestRotatePortA := TRUE;
					GVL_MASTER.stNestTable.qNestRotatePortB := FALSE;
			
					IF tRotatingTableDelay.Q
					   AND GVL_MASTER.stNestTable.bNestCompletedSensor THEN
			
						eNestState := E_NestState.STOP_TABLE;
			
					END_IF
			
				ELSE
					// Support is not retracted. Do not rotate.
					GVL_MASTER.stNestTable.qNestRotatePortA := FALSE;
					GVL_MASTER.stNestTable.qNestRotatePortB := FALSE;
			
				END_IF
        
            E_NestState.STOP_TABLE: // State 3: STOP TABLE

				GVL_MASTER.stProcess.bNestTestingReady := FALSE;
			
				GVL_MASTER.stNestTable.qNestRotatePortA := FALSE;
				GVL_MASTER.stNestTable.qNestRotatePortB := TRUE;
			
				IF NOT GVL_IO.stSafety.bSafetyOK THEN
			
					GVL_MASTER.stNestTable.qNestRotatePortA := FALSE;
					GVL_MASTER.stNestTable.qNestRotatePortB := FALSE;
					eNestState := E_NestState.FAULT;
			
				ELSIF NOT bNestSequenceAllowed THEN
			
					GVL_MASTER.stNestTable.qNestRotatePortA := FALSE;
					GVL_MASTER.stNestTable.qNestRotatePortB := FALSE;
					GVL_MASTER.stNestTable.bNestInMotion    := FALSE;
					eNestState := E_NestState.IDLE;
			
				ELSIF tPortB_ResetDelay.Q
					  AND GVL_MASTER.stNestTable.bNestReadySensor
					  AND GVL_MASTER.stNestTable.bNestLockedSensor THEN
			
					GVL_MASTER.stNestTable.bNestInMotion    := FALSE;
					GVL_MASTER.stNestTable.qNestRotatePortB := FALSE;
					eNestState := E_NestState.TESTING;
			
				END_IF
        
			E_NestState.TESTING: // State 4: TESTING / Kistler test position
			
				GVL_MASTER.stNestTable.qNestRotatePortA := FALSE;
				GVL_MASTER.stNestTable.qNestRotatePortB := FALSE;
				GVL_MASTER.stNestTable.bNestInMotion := FALSE;
			
			
				IF NOT GVL_IO.stSafety.bSafetyOK THEN
			
					GVL_MASTER.stProcess.bNestTestingReady := FALSE;
					eNestState := E_NestState.FAULT;
			
			
				ELSIF NOT bNestSequenceAllowed THEN
			
					GVL_MASTER.stProcess.bNestTestingReady := FALSE;
					eNestState := E_NestState.IDLE;
			
			
				ELSIF NOT GVL_MASTER.stNestTable.bNestReadySensor
					  OR NOT GVL_MASTER.stNestTable.bNestLockedSensor
					  OR eCurrentNestPos = E_NestPosition.Unknown THEN
			
					GVL_MASTER.stProcess.bNestTestingReady := FALSE;
					eNestState := E_NestState.FAULT;
					
			
			
				ELSE
			
					// Table is stopped and safely positioned for the Kistler process.
					GVL_MASTER.stProcess.bNestTestingReady := TRUE;
			
			
					// The Process Cycle has completed the Kistler operation
					// and is requesting the nest to leave the testing phase.
					IF GVL_MASTER.stProcess.bReleaseNestRotation THEN
			
						GVL_MASTER.stProcess.bNestTestingReady := FALSE;
						GVL_MASTER.stProcess.bReleaseNestRotation := FALSE;
			
						// Do not rotate yet. First wait for the operator exchange.
						eNestState := E_NestState.WAIT_OPERATOR_EXCHANGE;
			
					END_IF
			
				END_IF
				
			E_NestState.WAIT_OPERATOR_EXCHANGE:

				// The Kistler test is finished.
				// Keep the table stationary while the operator completes:
				// - processed-part removal;
				// - puck exchange when required;
				// - new puck locking;
				// - new-part loading.
			
				GVL_MASTER.stNestTable.qNestRotatePortA := FALSE;
				GVL_MASTER.stNestTable.qNestRotatePortB := FALSE;
				GVL_MASTER.stNestTable.bNestInMotion 	:= FALSE;
			
				GVL_MASTER.stProcess.bNestTestingReady 		:= FALSE;
				GVL_MASTER.stProcess.bReleaseNestRotation 	:= FALSE;
			
			
				IF NOT GVL_IO.stSafety.bSafetyOK THEN
			
					eNestState := E_NestState.FAULT;
			
			
				ELSIF NOT bNestSequenceAllowed THEN
			
					eNestState := E_NestState.IDLE;
			
			
				ELSIF NOT GVL_MASTER.stNestTable.bNestReadySensor
					  OR NOT GVL_MASTER.stNestTable.bNestLockedSensor
					  OR eCurrentNestPos = E_NestPosition.Unknown THEN
			
					eNestState := E_NestState.FAULT;
			
			
				ELSIF   (GVL_MASTER.stMachineStatus.eMachineState = E_MachineState.MANUAL_MODE
						OR GVL_MASTER.stPuckLocker.bIndexPermissive) THEN
			
					// Operator exchange completed.
					// Return to IDLE, where the existing two-hand logic
					// can start the next pneumatic index.
					eNestState := E_NestState.IDLE;
			
				END_IF
			
				
				
			E_NestState.WRONG_POSITION: // State 99: WRONG_POSITION (Emergency Stop or Air Loss)

				GVL_MASTER.stNestTable.qNestRotatePortA := FALSE;
				GVL_MASTER.stNestTable.qNestRotatePortB := TRUE;
				GVL_MASTER.stNestTable.bNestInMotion    := TRUE;
			
				GVL_MASTER.stProcess.bNestTestingReady  := FALSE;
			
				IF tTwoHandReturnTimeout.Q THEN
			
					GVL_MASTER.stNestTable.qNestRotatePortA := FALSE;
					GVL_MASTER.stNestTable.qNestRotatePortB := FALSE;
					GVL_MASTER.stNestTable.bNestInMotion    := FALSE;
			
					eNestState := E_NestState.FAULT;
			
				ELSIF rTrigTwoHands.Q
					  AND GVL_IO.stSafety.bSafetyOK
					  AND bNestSequenceAllowed
					  AND GVL_MASTER.stNestTable.bSupportRetracted THEN
			
					GVL_MASTER.stNestTable.qNestRotatePortA := TRUE;
					GVL_MASTER.stNestTable.qNestRotatePortB := FALSE;
			
					eNestState := E_NestState.ROTATING_TABLE;
			
				ELSIF GVL_IO.stSafety.bSafetyOK
					  AND NOT GVL_MASTER.stMachineStatus.bFault
					  AND GVL_MASTER.stNestTable.bNestReadySensor
					  AND eCurrentNestPos <> E_NestPosition.Unknown THEN
			
					GVL_MASTER.stNestTable.qNestRotatePortA := FALSE;
					GVL_MASTER.stNestTable.qNestRotatePortB := FALSE;
					GVL_MASTER.stNestTable.bNestInMotion    := FALSE;
			
					eNestState := E_NestState.STOP_TABLE;
			
				END_IF
				
            E_NestState.FAULT:

					GVL_MASTER.stNestTable.qNestRotatePortA := FALSE;
					GVL_MASTER.stNestTable.qNestRotatePortB := FALSE;
					GVL_MASTER.stNestTable.bNestInMotion    := FALSE;
				
					GVL_MASTER.stProcess.bNestTestingReady  := FALSE;
					GVL_MASTER.stProcess.bReleaseNestRotation := FALSE;
				
					GVL_MASTER.stNestTable.bSupportExtendRequest  := FALSE;
					GVL_MASTER.stNestTable.bSupportRetractRequest := TRUE;
				
					GVL_MASTER.stMachineStatus.eMachineState := E_MachineState.FAULT;

        END_CASE

    // =================================================================
    // FAULT 
    // =================================================================
	
	E_MachineState.FAULT:
	
	 				GVL_MASTER.stNestTable.qNestRotatePortA := FALSE;
					GVL_MASTER.stNestTable.qNestRotatePortB := FALSE;
					GVL_MASTER.stNestTable.bNestInMotion    := FALSE;
				
					GVL_MASTER.stProcess.bNestTestingReady  := FALSE;
					GVL_MASTER.stProcess.bReleaseNestRotation := FALSE;
				
					GVL_MASTER.stNestTable.bSupportExtendRequest  := FALSE;
					GVL_MASTER.stNestTable.bSupportRetractRequest := TRUE;

	    IF GVL_IO.stSafety.bSafetyOK AND NOT GVL_Master.stMachineStatus.bFault THEN
        	eNestState := E_NestState.IDLE;
        END_IF

	

		
	END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_OperatorExchangeControl" Id="{531cdfdc-4414-409e-a0f2-21c7605d741a}" FolderPath="Nest_Table\">
      <Declaration><![CDATA[METHOD PRIVATE M_OperatorExchangeControl
VAR
	iOperatorNestIndex 	: INT;
    bOperatorResultPass : BOOL;
    bOperatorResultFail : BOOL;
	bOperatorResultValid : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// ============================================================================
// MERGED OPERATOR EXCHANGE CONTROL
//
// Base:
//     - Immediate retention of one-scan removal and reject pulses.
//     - Complete enabled/disabled Puck Locker behavior.
//     - Recovery if the Puck Locker mode changes during an exchange.
//
// Merge adjustments:
//     - Permit a pending PASS or FAIL result to be handled while another nest
//       is in TESTING.
//     - Prevent WaitingForPartLoading from blocking when the locker is disabled.
// ============================================================================
// Default value prevents stale index permission.
bOperatorExchangeComplete := FALSE;


// -----------------------------------------------------------------------------
// Validate the nest currently accessible to the operator.
// -----------------------------------------------------------------------------
IF eOperatorNestPosition = E_NestPosition.Unknown THEN
    RETURN;
END_IF


iOperatorNestIndex := TO_INT(eOperatorNestPosition);

IF (iOperatorNestIndex < 1) OR (iOperatorNestIndex > 4) THEN
    RETURN;
END_IF


// -----------------------------------------------------------------------------
// Result associated with the nest currently accessible to the operator.
// -----------------------------------------------------------------------------
bOperatorResultValid :=
    GVL_MASTER.astNestProcessResult[
        iOperatorNestIndex
    ].bResultValid;


bOperatorResultPass :=
    GVL_MASTER.astNestProcessResult[
        iOperatorNestIndex
    ].bResultValid
    AND
    GVL_MASTER.astNestProcessResult[
        iOperatorNestIndex
    ].bPass;


bOperatorResultFail :=
    GVL_MASTER.astNestProcessResult[
        iOperatorNestIndex
    ].bResultValid
    AND
    GVL_MASTER.astNestProcessResult[
        iOperatorNestIndex
    ].bFail;

// -----------------------------------------------------------------------------
// Retain operator actions even while the Kistler is processing another nest.
//
// Both the nest removal pulse and the reject sensor pulse last only one PLC
// scan. They must therefore be retained immediately and not only when the
// exchange state machine reaches the corresponding waiting state.
// -----------------------------------------------------------------------------

// A processed part was removed from the operator nest.
IF (
        bOperatorResultValid
        OR bPendingOperatorResultPass
        OR bPendingOperatorResultFail
   )
   AND GVL_MASTER.astNestTracking[
        iOperatorNestIndex
   ].bPartRemovedPulse THEN

    bPartRemovedConfirmedForExchange := TRUE;

END_IF


// -----------------------------------------------------------------------------
// A new part was loaded into the operator nest.
//
// The previous part result may remain latched in the exchange state machine,
// but the newly loaded physical part has not yet been tested.
//
// Clear only the HMI measurement/result so the new part is displayed as NONE.
// -----------------------------------------------------------------------------
IF GVL_MASTER.astNestTracking[
        iOperatorNestIndex
   ].bPartLoadedPulse THEN

    // Preserve the disposition of the removed part before clearing
    // the visual result for the newly loaded part.
    IF bOperatorResultValid THEN

        bPendingOperatorResultPass :=
            bOperatorResultPass;

        bPendingOperatorResultFail :=
            bOperatorResultFail;

    END_IF

    // The newly loaded part has not been tested yet.
    // Display NONE without losing the pending disposition above.
    M_HMIKistlerResult(
        eNestPosition := eOperatorNestPosition,
        bPartOK       := FALSE,
        bPartNOK      := FALSE,
        rForce        := 0.0,
        rDistance     := 0.0,
        bResetValues  := TRUE
    );

END_IF


// Reject confirmation is only valid after the failed part
// has been removed from the operator nest.
//
// Required order:
// 1. Remove the failed part from the nest.
// 2. Place the failed part at the reject sensor.
// 3. Complete the operator exchange.
IF (
        bOperatorResultFail
        OR bPendingOperatorResultFail
   )
   AND bPartRemovedConfirmedForExchange
   AND rtPartPresentReject.Q THEN

    bRejectConfirmedForExchange := TRUE;

END_IF


// ============================================================================
// Operator exchange sequence
// ============================================================================
CASE eOperatorExchangeState OF


    // ========================================================================
    E_OperatorExchangeState.Idle:
    // ========================================================================

        bOperatorExchangeComplete := FALSE;

        // Preserve the physical nest associated with this exchange.
        eCompletedOperatorExchangeNest :=
            eOperatorNestPosition;


        // --------------------------------------------------------------------
        // Case 1:
        // A tested result is pending at the operator nest.
        //
        // The processed part must be handled before the table may index.
        // --------------------------------------------------------------------
        IF
			(
				(
					eNestState = E_NestState.IDLE
					OR
					eNestState = E_NestState.WAIT_OPERATOR_EXCHANGE
					OR
					eNestState = E_NestState.TESTING
				)
				AND NOT GVL_MASTER.stNestTable.bNestInMotion
				AND GVL_MASTER.stNestTable.bNestReadySensor
				AND GVL_MASTER.stNestTable.bNestLockedSensor
				AND bOperatorResultValid
			)
			THEN

            // Latch the result for the entire operator exchange.
            //
            // Do not reset these variables every PLC cycle.
            bPendingOperatorResultPass :=
                bOperatorResultPass;

            bPendingOperatorResultFail :=
                bOperatorResultFail;

           bRejectConfirmedForExchange := FALSE;


			// -------------------------------------------------------------
			// The processed part may already have been removed while another
			// nest was being tested.
			//
			// If the operator already loaded a new part, the physical sensor
			// will be ON again. Therefore, the retained removal event must
			// take priority over the current sensor state.
			// -------------------------------------------------------------
			IF bPartRemovedConfirmedForExchange THEN
			
				// ---------------------------------------------------------
				// PASS result.
				// ---------------------------------------------------------
				IF bOperatorResultPass THEN
			
					IF GVL_HMI.stPuckLocker.eMode =
						E_PuckLockerMode.Disabled THEN
			
						eOperatorExchangeState :=
							E_OperatorExchangeState.ExchangeComplete;
			
					ELSE
			
						eOperatorExchangeState :=
							E_OperatorExchangeState.WaitingForPuckRemoval;
			
					END_IF
			
			
				// ---------------------------------------------------------
				// FAIL result.
				// ---------------------------------------------------------
				ELSIF bOperatorResultFail THEN
			
					eOperatorExchangeState :=
						E_OperatorExchangeState.WaitingForRejectConfirmation;
			
				END_IF
			
			
			// -------------------------------------------------------------
			// No removal event was retained and the processed part is still
			// physically present.
			//
			// Wait for the operator to remove it.
			// -------------------------------------------------------------
			ELSIF GVL_MASTER.stSensors.bPartPresent_NEST THEN
			
				eOperatorExchangeState :=
					E_OperatorExchangeState.WaitingForPartRemoval;
			
			
			// -------------------------------------------------------------
			// The part is already absent, for example after fault recovery
			// or machine restart.
			// -------------------------------------------------------------
			ELSE
			


				bPartRemovedConfirmedForExchange := TRUE;
			
				// ---------------------------------------------------------
				// PASS result.
				// ---------------------------------------------------------
				IF bOperatorResultPass THEN
			
					IF GVL_HMI.stPuckLocker.eMode =
						E_PuckLockerMode.Disabled THEN
			
						eOperatorExchangeState :=
							E_OperatorExchangeState.ExchangeComplete;
			
					ELSE
			
						eOperatorExchangeState :=
							E_OperatorExchangeState.WaitingForPuckRemoval;
			
					END_IF
			
			
				// ---------------------------------------------------------
				// FAIL result.
				// ---------------------------------------------------------
				ELSIF bOperatorResultFail THEN
			
					eOperatorExchangeState :=
						E_OperatorExchangeState.WaitingForRejectConfirmation;
			
				END_IF
			
			END_IF


        // --------------------------------------------------------------------
        // Case 2:
        // No tested result is pending.
        //
        // Enabled:
        //     Require a present and locked puck.
        //
        // Disabled:
        //     Ignore only the physical puck conditions.
        // --------------------------------------------------------------------
        ELSIF (
                eNestState = E_NestState.IDLE
                OR
                eNestState = E_NestState.WAIT_OPERATOR_EXCHANGE
              )
              AND NOT GVL_MASTER.stNestTable.bNestInMotion
              AND GVL_MASTER.stNestTable.bNestReadySensor
			  AND NOT bPendingOperatorResultPass
			  AND NOT bPendingOperatorResultFail
              AND GVL_MASTER.stNestTable.bNestLockedSensor
              AND NOT bOperatorResultValid
              AND (
                    GVL_HMI.stPuckLocker.eMode =
                        E_PuckLockerMode.Disabled

                    OR
                    (
                        GVL_MASTER.stPuckLocker.bPuckDetected
                        AND
                        GVL_MASTER.stPuckLocker.bPuckLocked
                        AND
                        GVL_MASTER.stPuckLocker.eState =
                            E_PuckLockerState.Locked
                    )
              ) THEN

            bPendingOperatorResultPass := FALSE;
            bPendingOperatorResultFail := FALSE;

            bPartRemovedConfirmedForExchange := FALSE;
            bRejectConfirmedForExchange := FALSE;

            eOperatorExchangeState :=
                E_OperatorExchangeState.ExchangeComplete;

        END_IF


    // ========================================================================
    E_OperatorExchangeState.WaitingForPartRemoval:
    // ========================================================================

        bOperatorExchangeComplete := FALSE;


        // This state is entered only when a processed part was confirmed
        // present in the operator nest.
        //
        // Therefore, the part has been removed when the physical sensor
        // becomes FALSE.
        IF bPartRemovedConfirmedForExchange
   			OR NOT GVL_MASTER.stSensors.bPartPresent_NEST THEN

            bPartRemovedConfirmedForExchange := TRUE;


            // -------------------------------------------------------------
            // PASS result.
            // -------------------------------------------------------------
            IF bPendingOperatorResultPass THEN

                // With the Puck Locker disabled, removal of the good part
                // completes the operator exchange.
                IF GVL_HMI.stPuckLocker.eMode =
                    E_PuckLockerMode.Disabled THEN

                    bPartRemovedConfirmedForExchange := FALSE;

                    eOperatorExchangeState :=
                        E_OperatorExchangeState.ExchangeComplete;

                ELSE

                    // Original enabled Puck Locker sequence.
                    eOperatorExchangeState :=
                        E_OperatorExchangeState.WaitingForPuckRemoval;

                END_IF


            // -------------------------------------------------------------
            // FAIL result.
            // -------------------------------------------------------------
            ELSIF bPendingOperatorResultFail THEN

                // The rejected part must be placed at the reject sensor.
                eOperatorExchangeState :=
                    E_OperatorExchangeState.WaitingForRejectConfirmation;

            END_IF

        END_IF


    // ========================================================================
    E_OperatorExchangeState.WaitingForPuckRemoval:
    // ========================================================================

        bOperatorExchangeComplete := FALSE;


        // Recovery protection:
        //
        // If the Puck Locker is disabled while the sequence is already in
        // this state, no puck removal must be awaited.
        IF GVL_HMI.stPuckLocker.eMode =
            E_PuckLockerMode.Disabled THEN

            bPartRemovedConfirmedForExchange := FALSE;

            eOperatorExchangeState :=
                E_OperatorExchangeState.ExchangeComplete;

        ELSE

            // Once the locker accepts the release request,
            // the part-removal handshake is no longer needed.
            IF GVL_MASTER.stPuckLocker.eState =
                E_PuckLockerState.ReleasingPuck THEN

                bPartRemovedConfirmedForExchange := FALSE;

            END_IF


            // Advance when the old puck is physically gone.
            //
            // Do not require the locker to remain in ReleasingPuck.
            IF NOT GVL_MASTER.stPuckLocker.bPuckDetected THEN

                eOperatorExchangeState :=
                    E_OperatorExchangeState.WaitingForNewPuck;

            END_IF

        END_IF


    // ========================================================================
    E_OperatorExchangeState.WaitingForRejectConfirmation:
    // ========================================================================

        bOperatorExchangeComplete := FALSE;


        // Latch the reject-bin sensor pulse.
        IF rtPartPresentReject.Q THEN

            bRejectConfirmedForExchange := TRUE;

        END_IF


        // Complete the rejected-part exchange when:
        //
        // 1. The rejected part has been confirmed at the reject sensor.
        // 2. The part is no longer present in the operator nest.
        // 3. The Puck Locker is disabled, or the puck remains present
        //    and locked.
        IF bRejectConfirmedForExchange
			   AND bPartRemovedConfirmedForExchange
			   AND
			   (
                GVL_HMI.stPuckLocker.eMode =
                    E_PuckLockerMode.Disabled

                OR
                (
                    GVL_MASTER.stPuckLocker.bPuckDetected
                    AND
                    GVL_MASTER.stPuckLocker.bPuckLocked
                    AND
                    GVL_MASTER.stPuckLocker.eState =
                        E_PuckLockerState.Locked
                )
           ) THEN

            bPartRemovedConfirmedForExchange := FALSE;

            eOperatorExchangeState :=
                E_OperatorExchangeState.ExchangeComplete;

        END_IF


    // ========================================================================
    E_OperatorExchangeState.WaitingForNewPuck:
    // ========================================================================


        bOperatorExchangeComplete := FALSE;


        // Recovery protection:
        //
        // A replacement puck is not required when the locker is disabled.
        IF GVL_HMI.stPuckLocker.eMode =
            E_PuckLockerMode.Disabled THEN

            eOperatorExchangeState :=
                E_OperatorExchangeState.ExchangeComplete;


        // Original enabled Puck Locker sequence.
        ELSIF GVL_MASTER.stPuckLocker.bPuckDetected THEN

            eOperatorExchangeState :=
                E_OperatorExchangeState.WaitingForPuckLocked;

        END_IF


    // ========================================================================
    E_OperatorExchangeState.WaitingForPuckLocked:
    // ========================================================================

        bOperatorExchangeComplete := FALSE;


        // Recovery protection:
        //
        // Physical puck locking is not required when the locker is disabled.
        IF GVL_HMI.stPuckLocker.eMode =
            E_PuckLockerMode.Disabled THEN

            eOperatorExchangeState :=
                E_OperatorExchangeState.ExchangeComplete;


        // Original enabled Puck Locker sequence.
        ELSIF GVL_MASTER.stPuckLocker.bPuckDetected
           AND GVL_MASTER.stPuckLocker.bPuckLocked
           AND GVL_MASTER.stPuckLocker.eState =
                E_PuckLockerState.Locked THEN

            // Loading a new part remains optional.
            eOperatorExchangeState :=
                E_OperatorExchangeState.ExchangeComplete;

        END_IF


    // ========================================================================
    E_OperatorExchangeState.WaitingForPartLoading:
    // ========================================================================

        bOperatorExchangeComplete := FALSE;


        // Recovery protection:
        //
        // If the Puck Locker is disabled while this legacy state is active,
        // physical puck conditions must no longer block the exchange.
        IF GVL_HMI.stPuckLocker.eMode =
            E_PuckLockerMode.Disabled THEN

            eOperatorExchangeState :=
                E_OperatorExchangeState.ExchangeComplete;


        // Original enabled Puck Locker behavior.
        //
        // Require an actual OFF -> ON transition from the operator nest
        // sensor. The puck must also be present and locked.
        ELSIF GVL_MASTER.astNestTracking[
                iOperatorNestIndex
              ].bPartLoadedPulse
              AND GVL_MASTER.stPuckLocker.bPuckDetected
              AND GVL_MASTER.stPuckLocker.bPuckLocked
              AND GVL_MASTER.stPuckLocker.eState =
                    E_PuckLockerState.Locked THEN

            eOperatorExchangeState := E_OperatorExchangeState.ExchangeComplete;

        END_IF


    // ========================================================================
    E_OperatorExchangeState.ExchangeComplete:
    // ========================================================================

        // Keep the index permission active until the table starts moving.
        bOperatorExchangeComplete := TRUE;


        // The previous result and its disposition are complete.
        M_ClearCompletedOperatorNestResult();


        IF GVL_MASTER.stNestTable.bNestInMotion THEN

            bPendingOperatorResultPass := FALSE;
            bPendingOperatorResultFail := FALSE;

            bPartRemovedConfirmedForExchange := FALSE;
            bRejectConfirmedForExchange := FALSE;

            eOperatorExchangeState :=  E_OperatorExchangeState.WaitingForTableIndexComplete;

        END_IF


    // ========================================================================
    E_OperatorExchangeState.WaitingForTableIndexComplete:
    // ========================================================================

        bOperatorExchangeComplete := TRUE;

        IF eNestState = E_NestState.TESTING
           AND NOT GVL_MASTER.stNestTable.bNestInMotion
           AND GVL_MASTER.stNestTable.bNestReadySensor
           AND GVL_MASTER.stNestTable.bNestLockedSensor
           AND eCurrentNestPos <> E_NestPosition.Unknown THEN

            bOperatorExchangeComplete := FALSE;

            bPendingOperatorResultPass := FALSE;
            bPendingOperatorResultFail := FALSE;

            bPartRemovedConfirmedForExchange := FALSE;
            bRejectConfirmedForExchange := FALSE;

            eOperatorExchangeState :=  E_OperatorExchangeState.Idle;

        END_IF


    // ========================================================================
    ELSE
    // ========================================================================

        bOperatorExchangeComplete := FALSE;

        bPendingOperatorResultPass := FALSE;
        bPendingOperatorResultFail := FALSE;

        bPartRemovedConfirmedForExchange := FALSE;
        bRejectConfirmedForExchange := FALSE;

        eOperatorExchangeState := E_OperatorExchangeState.Idle;

END_CASE

// -----------------------------------------------------------------------------
// Reject popup control.
//
// Show the popup as soon as a failed part arrives at the operator position.
// Keep it visible after the part is removed while reject confirmation is
// still pending.
//
// The popup closes automatically when the reject sensor is confirmed and
// the operator exchange leaves WaitingForRejectConfirmation.
// -----------------------------------------------------------------------------
GVL_HMI.bShowRejectPopup :=
    (
        (
            eOperatorExchangeState =
                E_OperatorExchangeState.WaitingForPartRemoval
        )
        AND bPendingOperatorResultFail
    )
    OR
    (
        eOperatorExchangeState =
            E_OperatorExchangeState.WaitingForRejectConfirmation
    );
]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_PreExecution" Id="{d5c5735d-f733-481f-9f83-00134f7ccc98}">
      <Declaration><![CDATA[METHOD PRIVATE M_PreExecution : BOOL
VAR

END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// =================================================================================
// SYSTEM TIMERS
// =================================================================================
// Update initialization and safety timers on every PLC scan cycle
tonSys_Init(IN := GVL_MASTER.stMachineStatus.bInitialising);
tonSys_InitTimeout(IN := GVL_MASTER.stMachineStatus.bInitialising);

// TwinSAFE circuit stabilization timer (10 seconds)
tonSafety(IN := (GVL_MASTER.stMachineStatus.eMachineState = E_MachineState.SAFETY), PT := T#10S);

// 
//  fbStopTrigger(CLK := GVL_Master.i_bButtonStop);
//  bButtonStop := fbStopTrigger.Q;

// =================================================================================
// HMI MESSAGE CLEARING
// =================================================================================
// Clear old system messages if the machine is not actively in production
// Uses the proper ENUM namespace from your MASTER folder
IF GVL_MASTER.stMachineStatus.eMachineState <> E_MachineState.SYSTEM_AUTO_CYCLE THEN
    sMachineMessage := '';            
END_IF


// =================================================================================
// CRITICAL FAULT INTERLOCK (Watchdog)
// =================================================================================
// If Kistler hardware is NOT ready, force the state machine to FAULT immediately
// Exception: Do not override if the system is currently in SAFETY or POWER_UP
IF NOT GVL_MASTER.bKistlerSystemReady 
    AND GVL_MASTER.stMachineStatus.eMachineState <> E_MachineState.SAFETY 
    AND GVL_MASTER.stMachineStatus.eMachineState <> E_MachineState.SYSTEM_POWER_UP THEN
    
    GVL_MASTER.stMachineStatus.eMachineState := E_MachineState.FAULT;
END_IF


// =================================================================================
// START LEDs BUTTON OFF
// =================================================================================
eMode_LED_Start := E_LEDs_Mode.OFF;
eMode_LED_Reset := E_LEDs_Mode.OFF;

// =================================================================================
// METHOD EXECUTION FEEDBACK (Return True)
// =================================================================================
// Returning TRUE confirms the pre-execution routine completed successfully
M_PreExecution := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_ProcessCycle" Id="{e01c53ef-c471-4f56-958b-74875adab0b2}">
      <Declaration><![CDATA[METHOD M_ProcessCycle : BOOL
VAR
    bControlledStopActive 			: BOOL;
    rTrigTwoHands : R_TRIG;

    bManualIndexerOnly       		: BOOL;
    bManualKistlerOnly       		: BOOL;
    bManualIndexerAndKistler 		: BOOL;
	

    bCurrentNestFaultRejectPending : BOOL;


END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// ============================================================================
// MERGED M_ProcessCycle
// Base: Renan + Thays
// Includes disabled-nest handling, empty-nest result clearing and
// eLastTestedNestPos update for skipped new positions.
// ============================================================================

// Process cycle is allowed during:
//
// 1. Automatic production.
// 2. Manual Mode when the Kistler or indexer manual function is enabled.
bProcessCycleAllowed := ( GVL_MASTER.stMachineStatus.eMachineState = E_MachineState.SYSTEM_AUTO_CYCLE)
    					OR ( GVL_MASTER.stMachineStatus.eMachineState = E_MachineState.MANUAL_MODE
        				AND ( GVL_HMI.i_bHMIKistlerManualEnable OR GVL_HMI.i_bHMIIndexerManualEnable));

bManualIndexerOnly :=
    GVL_HMI.i_bHMIIndexerManualEnable
    AND NOT GVL_HMI.i_bHMIKistlerManualEnable;

bManualKistlerOnly :=
    GVL_HMI.i_bHMIKistlerManualEnable
    AND NOT GVL_HMI.i_bHMIIndexerManualEnable;

bManualIndexerAndKistler :=
    GVL_HMI.i_bHMIIndexerManualEnable
    AND GVL_HMI.i_bHMIKistlerManualEnable;

// -----------------------------------------------------------------------------
// If process execution is not permitted, reset the temporary process states.
//
// Stored nest PASS/FAIL results must not be cleared by M_ResetProcessCycle.
// -----------------------------------------------------------------------------
IF NOT bProcessCycleAllowed THEN

    M_ResetProcessCycle();

    RETURN;

END_IF

// -----------------------------------------------------------------------------
// Common timers and edge detections.
// -----------------------------------------------------------------------------
rTrigTwoHands(
    CLK := GVL_IO.stSafety.bTwoHandsSafe
);

tTwoHandTargetTime :=
    REAL_TO_TIME(rHmiTwoHandPresetTime);

tTwoHandHoldTimer(
    IN := GVL_IO.stSafety.bTwoHandsSafe,
    PT := tTwoHandTargetTime
);

rtPartPresentReject(
    CLK := GVL_MASTER.stSensors.bPartPresent_Reject
);

// ============================================================================
// COMMON POSITION AND TRACKING UPDATE
//
// These methods are required in both Auto and Manual Mode.
// ============================================================================
eCurrentNestPos :=
    M_GetCurrentPosition();

M_UpdateActiveNestPositions();

M_UpdateOperatorNestTracking();


// -----------------------------------------------------------------------------
// Determine safely whether the nest currently at the Kistler still contains
// a valid FAIL result.
//
// The enum is mapped explicitly to indexes 1..4 to prevent an invalid array
// access when the current position is UNKNOWN.
// -----------------------------------------------------------------------------
bCurrentNestFaultRejectPending := FALSE;

CASE eCurrentNestPos OF

    E_NestPosition.Position_1:

        bCurrentNestFaultRejectPending :=
            GVL_MASTER.astNestProcessResult[1].bResultValid
            AND GVL_MASTER.astNestProcessResult[1].bFail;

    E_NestPosition.Position_2:

        bCurrentNestFaultRejectPending :=
            GVL_MASTER.astNestProcessResult[2].bResultValid
            AND GVL_MASTER.astNestProcessResult[2].bFail;

    E_NestPosition.Position_3:

        bCurrentNestFaultRejectPending :=
            GVL_MASTER.astNestProcessResult[3].bResultValid
            AND GVL_MASTER.astNestProcessResult[3].bFail;

    E_NestPosition.Position_4:

        bCurrentNestFaultRejectPending :=
            GVL_MASTER.astNestProcessResult[4].bResultValid
            AND GVL_MASTER.astNestProcessResult[4].bFail;

ELSE

    bCurrentNestFaultRejectPending := FALSE;

END_CASE

// ============================================================================
// AUTOMATIC OPERATOR EXCHANGE
//
// The following methods belong only to automatic production.
//
// They must not:
//
// - send a PASS/FAIL disposition while in Manual Mode;
// - release a puck during Manual Mode;
// - clear a completed nest result during Manual Mode;
// - block manual index movement waiting for part removal;
// - block manual index movement waiting for reject confirmation;
// - block manual index movement waiting for a puck.
// ============================================================================
IF GVL_MASTER.stMachineStatus.eMachineState =
    E_MachineState.SYSTEM_AUTO_CYCLE THEN

    M_UpdatePuckLockerPartRemovalStatus();

    M_ConfirmPuckLockerDisposition();

    M_PuckLockerDisposition();

    M_OperatorExchangeControl();

ELSE

    // Prevent a stale removal confirmation from being sent to the
    // Puck Locker while the machine is operating manually.
    GVL_MASTER.stPuckLocker.bPartRemovedFromNest := FALSE;

END_IF

// -----------------------------------------------------------------------------
// Determine whether the current physical table position is different from
// the most recently processed Kistler position.
// -----------------------------------------------------------------------------
bNestNewPositionReady :=
    (
        eCurrentNestPos <> E_NestPosition.UNKNOWN
    )
    AND
    (
        eCurrentNestPos <> eLastTestedNestPos
    );

// -----------------------------------------------------------------------------
// Capture live Kistler values while an automatic or manual sequence is active.
//
// This does not store PASS/FAIL. It only updates the live maximum values.
// -----------------------------------------------------------------------------

IF GVL_MASTER.stProcess.bKistlerCycleRequest
   AND NOT stKistlerOutTelegram.bSequenceEnd THEN

    M_HMIKistlerResult(
        eNestPosition := eCurrentNestPos,
        bPartOK       := FALSE,
        bPartNOK      := FALSE,
        rForce        := stKistler_Status.rLiveForce,
        rDistance     := stKistler_Status.rLiveDistance,
        bResetValues  := FALSE
    );

END_IF

// ============================================================================
// PROCESS CYCLE COORDINATOR
// ============================================================================
CASE GVL_MASTER.stMachineStatus.eMachineState OF

    // ========================================================================
    // AUTOMATIC CYCLE
    // ========================================================================
    E_MachineState.SYSTEM_AUTO_CYCLE:

        CASE eProcessCycleState OF

            // =================================================================
            E_ProcessCycle_State.IDLE:
            // =================================================================

                GVL_MASTER.stProcess.bKistlerCycleRequest := FALSE;
                GVL_MASTER.stProcess.bKistlerCycleDone    := FALSE;
                GVL_MASTER.stProcess.bKistlerHomeDone     := FALSE;
                GVL_MASTER.stProcess.bReleaseNestRotation := FALSE;

                tonAfterKistlerDelay(IN := FALSE);

                IF bProcessCycleAllowed THEN

                    eProcessCycleState :=
                        E_ProcessCycle_State.WAIT_NEST_TESTING_READY;

                END_IF

                       // =================================================================
            E_ProcessCycle_State.WAIT_NEST_TESTING_READY:
            // =================================================================

                GVL_MASTER.stProcess.bKistlerCycleRequest := FALSE;
                GVL_MASTER.stProcess.bReleaseNestRotation := FALSE;

                tonAfterKistlerDelay(IN := FALSE);

                IF NOT bProcessCycleAllowed THEN

                    eProcessCycleState :=
                        E_ProcessCycle_State.IDLE;

                // -------------------------------------------------------------
                // Invalid table position.
                //
                // Never execute the Kistler if the PLC cannot determine which
                // physical nest is currently at the test station.
                // -------------------------------------------------------------
                ELSIF GVL_MASTER.stProcess.bNestTestingReady
                      AND eNestState = E_NestState.TESTING
                      AND eCurrentNestPos =
                            E_NestPosition.UNKNOWN THEN

                    GVL_MASTER.stProcess.bKistlerCycleRequest := FALSE;
                    GVL_MASTER.stProcess.bReleaseNestRotation := FALSE;
                    GVL_MASTER.stProcess.bKistlerCycleDone    := FALSE;
                    GVL_MASTER.stProcess.bKistlerHomeDone     := FALSE;

                    eProcessCycleState :=
                        E_ProcessCycle_State.FAULT;

                // -------------------------------------------------------------
                // Fault-recovery reject.
                //
                // During fault recovery, a nest containing a valid FAIL result
                // must not be tested again by the Kistler.
                //
                // Preserve the FAIL result so the normal operator exchange and
                // reject confirmation flow can dispose of the part.
                // -------------------------------------------------------------
                ELSIF bFaultRejectActive
                      AND bCurrentNestFaultRejectPending
                      AND GVL_MASTER.stProcess.bNestTestingReady
                      AND eNestState = E_NestState.TESTING
                      AND GVL_MASTER.stNestTable.bNestReadySensor
                      AND GVL_MASTER.stNestTable.bNestLockedSensor
                      AND NOT GVL_MASTER.stNestTable.bNestInMotion
                      AND eCurrentNestPos <>
                            E_NestPosition.UNKNOWN THEN

                    GVL_MASTER.stProcess.bKistlerCycleRequest := FALSE;
                    GVL_MASTER.stProcess.bKistlerCycleDone    := FALSE;
                    GVL_MASTER.stProcess.bKistlerHomeDone     := TRUE;

                    // Keep position tracking synchronized.
                    //eLastTestedNestPos :=
                       // eCurrentNestPos;

                    // Do not clear the stored FAIL result here.
                    GVL_MASTER.stProcess.bReleaseNestRotation :=
                        TRUE;

                    eProcessCycleState :=
                        E_ProcessCycle_State.RELEASE_NEST;

                // -------------------------------------------------------------
                // Same position already processed, or no part at Kistler.
                //
                // Do not execute another Kistler cycle. Release the table.
                // -------------------------------------------------------------
                ELSIF GVL_MASTER.stProcess.bNestTestingReady
                      AND eNestState = E_NestState.TESTING
                      AND GVL_MASTER.stNestTable.bNestReadySensor
                      AND GVL_MASTER.stNestTable.bNestLockedSensor
                      AND NOT GVL_MASTER.stNestTable.bNestInMotion
                      AND eCurrentNestPos <>
                            E_NestPosition.UNKNOWN
                      AND
                      (
                          NOT bNestNewPositionReady
                          OR
                          NOT GVL_MASTER.stSensors.bPartPresent_Kistler
                      ) THEN

                    GVL_MASTER.stProcess.bKistlerCycleRequest := FALSE;
                    GVL_MASTER.stProcess.bKistlerCycleDone    := FALSE;

                    // Kistler side is considered complete because there is
                    // no valid new part to test.
                    GVL_MASTER.stProcess.bKistlerHomeDone :=
                        TRUE;

                    IF bNestNewPositionReady THEN

                        // New position without a part.
                        // Remove any previous HMI measurement result.
                        M_HMIKistlerResult(
                            eNestPosition := eCurrentNestPos,
                            bPartOK       := FALSE,
                            bPartNOK      := FALSE,
                            rForce        := 0.0,
                            rDistance     := 0.0,
                            bResetValues  := TRUE
                        );

                        eLastTestedNestPos :=
                            eCurrentNestPos;

                    END_IF

                    GVL_MASTER.stProcess.bReleaseNestRotation :=
                        TRUE;

                    eProcessCycleState :=
                        E_ProcessCycle_State.RELEASE_NEST;

                // -------------------------------------------------------------
                // New enabled nest containing a part.
                //
                // Execute the Kistler sequence.
                // -------------------------------------------------------------
                ELSIF GVL_MASTER.stProcess.bNestTestingReady
                      AND eNestState = E_NestState.TESTING
                      AND GVL_MASTER.stNestTable.bNestReadySensor
                      AND GVL_MASTER.stNestTable.bNestLockedSensor
                      AND NOT GVL_MASTER.stNestTable.bNestInMotion
                      AND stKistler_Status.eKistlerState =
                            E_KistlerState.READY
                      AND NOT stKistler_Status.bError
                      AND NOT bKistlerRecoveryHomeRequest
                      AND bNestNewPositionReady
                      AND GVL_MASTER.stSensors.bPartPresent_Kistler
                      AND M_IsNestEnabled(eCurrentNestPos) THEN

                    GVL_MASTER.stProcess.bKistlerCycleDone := FALSE;
                    GVL_MASTER.stProcess.bKistlerHomeDone  := FALSE;

                    bKistlerResultStored := FALSE;

                    // Clear previous HMI measurement values before starting
                    // a new test.
                    M_HMIKistlerResult(
                        eNestPosition := eCurrentNestPos,
                        bPartOK       := FALSE,
                        bPartNOK      := FALSE,
                        rForce        := 0.0,
                        rDistance     := 0.0,
                        bResetValues  := TRUE
                    );

                    eProcessCycleState :=
                        E_ProcessCycle_State.REQUEST_KISTLER;

                // -------------------------------------------------------------
                // Nest disabled from HMI.
                //
                // Skip the Kistler test and release the table normally.
                // -------------------------------------------------------------
                ELSIF GVL_MASTER.stProcess.bNestTestingReady
                      AND eNestState = E_NestState.TESTING
                      AND GVL_MASTER.stNestTable.bNestReadySensor
                      AND GVL_MASTER.stNestTable.bNestLockedSensor
                      AND NOT GVL_MASTER.stNestTable.bNestInMotion
                      AND eCurrentNestPos <>
                            E_NestPosition.UNKNOWN
                      AND bNestNewPositionReady
                      AND GVL_MASTER.stSensors.bPartPresent_Kistler
                      AND NOT M_IsNestEnabled(eCurrentNestPos) THEN

                    GVL_MASTER.stProcess.bKistlerCycleRequest := FALSE;
                    GVL_MASTER.stProcess.bKistlerCycleDone    := FALSE;
                    GVL_MASTER.stProcess.bKistlerHomeDone     := TRUE;

                    M_HMIKistlerResult(
                        eNestPosition := eCurrentNestPos,
                        bPartOK       := FALSE,
                        bPartNOK      := FALSE,
                        rForce        := 0.0,
                        rDistance     := 0.0,
                        bResetValues  := TRUE
                    );

                    eLastTestedNestPos :=
                        eCurrentNestPos;

                    GVL_MASTER.stProcess.bReleaseNestRotation :=
                        TRUE;

                    eProcessCycleState :=
                        E_ProcessCycle_State.RELEASE_NEST;

                END_IF

            // =================================================================
            E_ProcessCycle_State.REQUEST_KISTLER:
            // =================================================================

                GVL_MASTER.stProcess.bKistlerCycleRequest := TRUE;

                IF stKistler_Status.bError THEN

                    GVL_MASTER.stProcess.bKistlerCycleRequest :=
                        FALSE;

                    eProcessCycleState :=
                        E_ProcessCycle_State.FAULT;

                ELSIF stKistler_Status.eKistlerState <>
                      E_KistlerState.READY THEN

                    eProcessCycleState :=
                        E_ProcessCycle_State.WAIT_KISTLER_DONE;

                END_IF

            // =================================================================
            E_ProcessCycle_State.WAIT_KISTLER_DONE:
            // =================================================================

                // Keep the request active while the Kistler is executing.
                GVL_MASTER.stProcess.bKistlerCycleRequest := TRUE;

                IF stKistler_Status.bError THEN

                    GVL_MASTER.stProcess.bKistlerCycleRequest :=
                        FALSE;

                    eProcessCycleState :=
                        E_ProcessCycle_State.FAULT;

                ELSIF stKistler_Status.eKistlerState =
                      E_KistlerState.DONE THEN

                    GVL_MASTER.stProcess.bKistlerCycleRequest :=
                        FALSE;

                    GVL_MASTER.stProcess.bKistlerCycleDone :=
                        TRUE;

                    eProcessCycleState :=
                        E_ProcessCycle_State.WAIT_KISTLER_HOME;

                END_IF

            // =================================================================
            E_ProcessCycle_State.WAIT_KISTLER_HOME:
            // =================================================================

                M_StoreKistlerResult();

                GVL_MASTER.stProcess.bKistlerCycleRequest := FALSE;

                IF stKistler_Status.bError THEN

                    eProcessCycleState :=
                        E_ProcessCycle_State.FAULT;

                ELSIF stKistlerOutTelegram.bHomePosReached
                      OR stKistlerOutTelegram.bRefPosReached
                      OR stKistler_Status.bInPosition THEN

                    GVL_MASTER.test :=
                        GVL_MASTER.test + 1;

                    GVL_MASTER.stProcess.bKistlerHomeDone :=
                        TRUE;

                    GVL_MASTER.stProcess.bKistlerCycleDone :=
                        TRUE;

                    // ---------------------------------------------------------
                    // Store the process result.
                    // ---------------------------------------------------------
                    IF stKistler_Status.bPartOK THEN

                        GVL_MASTER.stProcess.bKistlerResultOK :=
                            TRUE;

                        GVL_MASTER.stProcess.bKistlerResultNOK :=
                            FALSE;

                    ELSIF stKistler_Status.bPartNOK THEN

                        GVL_MASTER.stProcess.bKistlerResultOK :=
                            FALSE;

                        GVL_MASTER.stProcess.bKistlerResultNOK :=
                            TRUE;

                    ELSE

                        // Test ended without a valid OK/NOK result.
                        // Preserve the existing behavior.
                        RETURN;

                    END_IF

                    eLastTestedNestPos :=
                        eCurrentNestPos;

                    IF NOT M_HMIKistlerResult(
                        eNestPosition := eCurrentNestPos,
                        bPartOK       := stKistler_Status.bPartOK,
                        bPartNOK      := stKistler_Status.bPartNOK,
                        rForce        := stKistler_Status.rLiveForce,
                        rDistance     := stKistler_Status.rLiveDistance,
                        bResetValues  := FALSE
                    ) THEN

                        RETURN;

                    END_IF

                    eProcessCycleState :=
                        E_ProcessCycle_State.WAIT_AFTER_KISTLER;

                END_IF

            // =================================================================
            E_ProcessCycle_State.WAIT_AFTER_KISTLER:
            // =================================================================

                IF stKistlerOutTelegram.bSequenceEnd
                   AND
                   (
                       stKistlerOutTelegram.bHomePosReached
                       OR
                       stKistlerOutTelegram.bRefPosReached
                       OR
                       stKistler_Status.bInPosition
                   ) THEN

                    GVL_MASTER.stProcess.bReleaseNestRotation :=
                        TRUE;

                    eProcessCycleState :=
                        E_ProcessCycle_State.RELEASE_NEST;

                END_IF

            // =================================================================
            E_ProcessCycle_State.RELEASE_NEST:
            // =================================================================

                // Keep the release request active until NestTableControl
                // consumes it.
                GVL_MASTER.stProcess.bReleaseNestRotation := TRUE;

                IF eNestState <> E_NestState.TESTING
                   OR NOT GVL_MASTER.stProcess.bNestTestingReady THEN

                    GVL_MASTER.stProcess.bReleaseNestRotation :=
                        FALSE;

                    GVL_MASTER.stProcess.bKistlerCycleRequest :=
                        FALSE;

                    GVL_MASTER.stProcess.bKistlerCycleDone :=
                        FALSE;

                    GVL_MASTER.stProcess.bKistlerHomeDone :=
                        FALSE;

                    tonAfterKistlerDelay(IN := FALSE);

                    eProcessCycleState :=
                        E_ProcessCycle_State.WAIT_NEST_TESTING_READY;

                END_IF

            // =================================================================
            E_ProcessCycle_State.FAULT:
            // =================================================================

                GVL_MASTER.stProcess.bKistlerCycleRequest := FALSE;
                GVL_MASTER.stProcess.bReleaseNestRotation := FALSE;

                tonAfterKistlerDelay(IN := FALSE);

                M_ResetProcessCycle();

                GVL_MASTER.stMachineStatus.eMachineState :=
                    E_MachineState.FAULT;

                IF GVL_MASTER.stMachineStatus.bStopped THEN

                    eProcessCycleState :=
                        E_ProcessCycle_State.IDLE;

                END_IF

            // =================================================================
            ELSE
            // =================================================================

                eProcessCycleState :=
                    E_ProcessCycle_State.IDLE;

        END_CASE

    // ========================================================================
    // MANUAL MODE
    // ========================================================================
   // ========================================================================
// MANUAL MODE
// ========================================================================
E_MachineState.MANUAL_MODE:

    CASE eProcessCycleState OF

        // =================================================================
        E_ProcessCycle_State.IDLE:
        // =================================================================

            GVL_MASTER.stProcess.bKistlerCycleRequest := FALSE;
            GVL_MASTER.stProcess.bKistlerCycleDone := FALSE;
            GVL_MASTER.stProcess.bKistlerHomeDone := FALSE;
            GVL_MASTER.stProcess.bReleaseNestRotation := FALSE;

            GVL_MASTER.stProcess.bKistlerResultOK := FALSE;
            GVL_MASTER.stProcess.bKistlerResultNOK := FALSE;

            tonAfterKistlerDelay(IN := FALSE);

            // -------------------------------------------------------------
            // Manual indexer only or indexer + Kistler.
            // Wait until the table reaches the testing position.
            // -------------------------------------------------------------
            IF bManualIndexerOnly
               OR bManualIndexerAndKistler THEN

                eProcessCycleState :=
                    E_ProcessCycle_State.WAIT_NEST_TESTING_READY;

            // -------------------------------------------------------------
            // Manual Kistler only.
            // Prepare a new test and wait for the two-hand rising edge.
            // -------------------------------------------------------------
            ELSIF bManualKistlerOnly
                  AND NOT GVL_MASTER.stProcess.bNestTestingReady
                  AND stKistler_Status.eKistlerState =
                        E_KistlerState.READY
                  AND NOT stKistler_Status.bError
                  AND NOT bKistlerRecoveryHomeRequest THEN

                GVL_MASTER.stProcess.bNestTestingReady := FALSE;

                bKistlerResultStored := FALSE;
                rKistlerCycleMaxForce := 0.0;
                rKistlerCycleMaxDistance := 0.0;

                IF eCurrentNestPos <> E_NestPosition.UNKNOWN THEN

                    M_HMIKistlerResult(
                        eNestPosition := eCurrentNestPos,
                        bPartOK       := FALSE,
                        bPartNOK      := FALSE,
                        rForce        := 0.0,
                        rDistance     := 0.0,
                        bResetValues  := TRUE
                    );

                END_IF

                eProcessCycleState :=
                    E_ProcessCycle_State.REQUEST_KISTLER;

            END_IF


        // =================================================================
        E_ProcessCycle_State.WAIT_NEST_TESTING_READY:
        // =================================================================

            GVL_MASTER.stProcess.bKistlerCycleRequest := FALSE;
            GVL_MASTER.stProcess.bReleaseNestRotation := FALSE;

            tonAfterKistlerDelay(IN := FALSE);

            // Manual indexer operation was disabled.
            IF NOT (
                bManualIndexerOnly
                OR bManualIndexerAndKistler
            ) THEN

                eProcessCycleState :=
                    E_ProcessCycle_State.IDLE;

            // -------------------------------------------------------------
            // Manual indexer + Kistler.
            // Prepare the result storage and start a new Kistler test.
            // -------------------------------------------------------------
            ELSIF GVL_MASTER.stProcess.bNestTestingReady
                  AND eNestState = E_NestState.TESTING
                  AND bManualIndexerAndKistler
                  AND stKistler_Status.eKistlerState =
                        E_KistlerState.READY
                  AND NOT stKistler_Status.bError
                  AND NOT bKistlerRecoveryHomeRequest
                  AND eCurrentNestPos <>
                        E_NestPosition.UNKNOWN THEN

                GVL_MASTER.stProcess.bKistlerCycleDone := FALSE;
                GVL_MASTER.stProcess.bKistlerHomeDone := FALSE;

                bKistlerResultStored := FALSE;
                rKistlerCycleMaxForce := 0.0;
                rKistlerCycleMaxDistance := 0.0;

                M_HMIKistlerResult(
                    eNestPosition := eCurrentNestPos,
                    bPartOK       := FALSE,
                    bPartNOK      := FALSE,
                    rForce        := 0.0,
                    rDistance     := 0.0,
                    bResetValues  := TRUE
                );

                eProcessCycleState :=
                    E_ProcessCycle_State.REQUEST_KISTLER;

            // -------------------------------------------------------------
            // Manual indexer only.
            // Do not execute the Kistler; release the table immediately.
            // -------------------------------------------------------------
            ELSIF GVL_MASTER.stProcess.bNestTestingReady
                  AND eNestState = E_NestState.TESTING
                  AND bManualIndexerOnly THEN

                GVL_MASTER.stProcess.bKistlerCycleRequest := FALSE;
                GVL_MASTER.stProcess.bKistlerHomeDone := TRUE;
                GVL_MASTER.stProcess.bReleaseNestRotation := TRUE;

                eProcessCycleState :=
                    E_ProcessCycle_State.RELEASE_NEST;

            END_IF


        // =================================================================
        E_ProcessCycle_State.REQUEST_KISTLER:
        // =================================================================

            // The Kistler already accepted the request and left READY.
            IF stKistler_Status.eKistlerState <>
                E_KistlerState.READY THEN

                eProcessCycleState :=
                    E_ProcessCycle_State.WAIT_KISTLER_DONE;

            // -------------------------------------------------------------
            // Manual Kistler only.
            // Start only on the two-hand rising edge.
            // -------------------------------------------------------------
            ELSIF bManualKistlerOnly
                  AND GVL_IO.stSafety.bSafetyOK
                  AND rTrigTwoHands.Q
                  AND GVL_MASTER.stNestTable.bNestReadySensor
                  AND GVL_MASTER.stNestTable.bNestLockedSensor
                  AND NOT stKistler_Status.bError
                  AND NOT bKistlerRecoveryHomeRequest THEN

                GVL_MASTER.stProcess.bKistlerCycleRequest := TRUE;

            // -------------------------------------------------------------
            // Manual indexer + Kistler.
            // The table is already positioned and locked.
            // -------------------------------------------------------------
            ELSIF bManualIndexerAndKistler
                  AND GVL_MASTER.stProcess.bNestTestingReady
                  AND eNestState = E_NestState.TESTING
                  AND GVL_MASTER.stNestTable.bNestReadySensor
                  AND GVL_MASTER.stNestTable.bNestLockedSensor
                  AND NOT GVL_MASTER.stNestTable.bNestInMotion
                  AND eCurrentNestPos <>
                        E_NestPosition.UNKNOWN
                  AND bNestNewPositionReady
                  AND NOT stKistler_Status.bError
                  AND NOT bKistlerRecoveryHomeRequest THEN

                GVL_MASTER.stProcess.bKistlerCycleRequest := TRUE;

            ELSIF stKistler_Status.bError THEN

                GVL_MASTER.stProcess.bKistlerCycleRequest := FALSE;

                eProcessCycleState :=
                    E_ProcessCycle_State.FAULT;

            END_IF


        // =================================================================
        E_ProcessCycle_State.WAIT_KISTLER_DONE:
        // =================================================================

            GVL_MASTER.stProcess.bKistlerCycleRequest := TRUE;

            IF stKistler_Status.bError THEN

                GVL_MASTER.stProcess.bKistlerCycleRequest := FALSE;

                eProcessCycleState :=
                    E_ProcessCycle_State.FAULT;

            ELSIF stKistler_Status.eKistlerState =
                  E_KistlerState.DONE THEN

                GVL_MASTER.stProcess.bKistlerCycleRequest := FALSE;
                GVL_MASTER.stProcess.bKistlerCycleDone := TRUE;

                // Finalize the maximum force and distance captured during
                // the manual Kistler sequence.
                M_StoreKistlerResult();

                IF eCurrentNestPos <> E_NestPosition.UNKNOWN THEN

                    M_HMIKistlerResult(
                        eNestPosition := eCurrentNestPos,
                        bPartOK       := stKistler_Status.bPartOK,
                        bPartNOK      := stKistler_Status.bPartNOK,
                        rForce        := rKistlerCycleMaxForce,
                        rDistance     := rKistlerCycleMaxDistance,
                        bResetValues  := FALSE
                    );

                END_IF

                // With the indexer enabled, wait for the Kistler to return
                // home before releasing the table.
                IF bManualIndexerAndKistler THEN

                    eLastTestedNestPos := eCurrentNestPos;

                    eProcessCycleState :=
                        E_ProcessCycle_State.WAIT_KISTLER_HOME;

                // Kistler-only operation finishes without moving the table.
                ELSE

                    eProcessCycleState :=
                        E_ProcessCycle_State.IDLE;

                END_IF

            END_IF


        // =================================================================
        E_ProcessCycle_State.WAIT_KISTLER_HOME:
        // =================================================================

            GVL_MASTER.stProcess.bKistlerCycleRequest := FALSE;

            IF stKistler_Status.bError THEN

                eProcessCycleState :=
                    E_ProcessCycle_State.FAULT;

            ELSIF stKistlerOutTelegram.bHomePosReached
                  OR stKistlerOutTelegram.bRefPosReached
                  OR stKistler_Status.bInPosition THEN

                GVL_MASTER.stProcess.bKistlerHomeDone := TRUE;

                IF bManualIndexerAndKistler THEN

                    eProcessCycleState :=
                        E_ProcessCycle_State.WAIT_AFTER_KISTLER;

                ELSE

                    eProcessCycleState :=
                        E_ProcessCycle_State.IDLE;

                END_IF

            END_IF


        // =================================================================
        E_ProcessCycle_State.WAIT_AFTER_KISTLER:
        // =================================================================

            IF stKistlerOutTelegram.bSequenceEnd
               AND
               (
                   stKistlerOutTelegram.bHomePosReached
                   OR stKistlerOutTelegram.bRefPosReached
                   OR stKistler_Status.bInPosition
               ) THEN

                GVL_MASTER.stProcess.bReleaseNestRotation := TRUE;

                eProcessCycleState :=
                    E_ProcessCycle_State.RELEASE_NEST;

            END_IF


        // =================================================================
        E_ProcessCycle_State.RELEASE_NEST:
        // =================================================================

            GVL_MASTER.stProcess.bReleaseNestRotation := TRUE;

            IF eNestState <> E_NestState.TESTING
               OR NOT GVL_MASTER.stProcess.bNestTestingReady THEN

                GVL_MASTER.stProcess.bReleaseNestRotation := FALSE;
                GVL_MASTER.stProcess.bKistlerCycleRequest := FALSE;
                GVL_MASTER.stProcess.bKistlerCycleDone := FALSE;
                GVL_MASTER.stProcess.bKistlerHomeDone := FALSE;

                tonAfterKistlerDelay(IN := FALSE);

                IF bManualIndexerOnly
                   OR bManualIndexerAndKistler THEN

                    eProcessCycleState :=
                        E_ProcessCycle_State.WAIT_NEST_TESTING_READY;

                ELSE

                    eProcessCycleState :=
                        E_ProcessCycle_State.IDLE;

                END_IF

            END_IF


        // =================================================================
        E_ProcessCycle_State.FAULT:
        // =================================================================

            GVL_MASTER.stProcess.bKistlerCycleRequest := FALSE;
            GVL_MASTER.stProcess.bReleaseNestRotation := FALSE;

            tonAfterKistlerDelay(IN := FALSE);

            M_ResetProcessCycle();

            GVL_MASTER.stMachineStatus.eMachineState :=
                E_MachineState.FAULT;


        // =================================================================
        ELSE
        // =================================================================

            eProcessCycleState :=
                E_ProcessCycle_State.IDLE;

    END_CASE

END_CASE

M_ProcessCycle := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_PuckLockerDisposition" Id="{ad617b9e-72f0-4e71-8779-255d6dead4ac}" FolderPath="Pick_Locker\">
      <Declaration><![CDATA[METHOD PRIVATE M_PuckLockerDisposition
VAR
	iOperatorNestIndex : INT;
    bResultPass        : BOOL;
    bResultFail        : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// -----------------------------------------------------------------------------
// Do not generate dispositions when the Puck Locker is disabled.
// -----------------------------------------------------------------------------
(*IF GVL_HMI.stPuckLocker.eMode = E_PuckLockerMode.Disabled THEN
    RETURN;
END_IF*)


// -----------------------------------------------------------------------------
// The operator nest must be known.
// -----------------------------------------------------------------------------
IF eOperatorNestPosition = E_NestPosition.Unknown THEN
    RETURN;
END_IF


// Process the operator disposition whenever the table is stationary,
// mechanically locked and accessible to the operator.
//
// TESTING:
//     Normal production flow.
//
// WAIT_OPERATOR_EXCHANGE:
//     Normal exchange after a completed test.
//
// IDLE:
//     Recovery flow after FAULT, STOPPED or reinitialisation.
IF (
        eNestState <> E_NestState.IDLE
        AND eNestState <> E_NestState.TESTING
        AND eNestState <> E_NestState.WAIT_OPERATOR_EXCHANGE
   )
   OR GVL_MASTER.stNestTable.bNestInMotion
   OR NOT GVL_MASTER.stNestTable.bNestReadySensor
   OR NOT GVL_MASTER.stNestTable.bNestLockedSensor
   OR eCurrentNestPos = E_NestPosition.Unknown THEN

    RETURN;

END_IF


// -----------------------------------------------------------------------------
// E_NestPosition values correspond directly to array indexes 1..4.
// -----------------------------------------------------------------------------
iOperatorNestIndex := eOperatorNestPosition;

IF (iOperatorNestIndex < 1) OR (iOperatorNestIndex > 4) THEN
    RETURN;
END_IF


// -----------------------------------------------------------------------------
// The nest currently accessible to the operator must contain a valid result.
// -----------------------------------------------------------------------------
IF NOT GVL_MASTER.astNestProcessResult[iOperatorNestIndex].bResultValid THEN
    RETURN;
END_IF


// -----------------------------------------------------------------------------
// Do not process the same nest disposition more than once.
// -----------------------------------------------------------------------------
IF GVL_MASTER.astNestProcessResult[iOperatorNestIndex].bDispositionSent THEN
    RETURN;
END_IF


// -----------------------------------------------------------------------------
// -----------------------------------------------------------------------------
// Copy the result locally for validation and readability.
// -----------------------------------------------------------------------------
bResultPass :=
    GVL_MASTER.astNestProcessResult[iOperatorNestIndex].bPass;

bResultFail :=
    GVL_MASTER.astNestProcessResult[iOperatorNestIndex].bFail;


// -----------------------------------------------------------------------------
// The result must contain exactly one disposition.
//
// Invalid combinations:
//     PASS = FALSE and FAIL = FALSE
//     PASS = TRUE  and FAIL = TRUE
// -----------------------------------------------------------------------------
IF bResultPass = bResultFail THEN
    RETURN;
END_IF


// -----------------------------------------------------------------------------
// PUCK LOCKER DISABLED:
//
// There is no physical locker handshake to perform.
//
// Mark the disposition as delivered internally so that the operator exchange
// sequence can continue using the normal PASS/FAIL result.
//
// FAIL still requires:
//     1. Part removal from the operator nest.
//     2. Confirmation from the reject-bin sensor.
//
// No puck presence or puck locked condition is required.
// -----------------------------------------------------------------------------
IF GVL_HMI.stPuckLocker.eMode = E_PuckLockerMode.Disabled THEN

    GVL_MASTER.astNestProcessResult[
        iOperatorNestIndex
    ].bDispositionSent := TRUE;
    RETURN;
END_IF


// -----------------------------------------------------------------------------
// A previous disposition was already sent and is still waiting for confirmation
// from PRG_PuckLocker.
// -----------------------------------------------------------------------------
IF ePendingPuckDispositionNest <> E_NestPosition.Unknown THEN
    RETURN;
END_IF




// -----------------------------------------------------------------------------
// Do not overwrite a disposition that has not yet been consumed by the locker.
// -----------------------------------------------------------------------------
IF GVL_MASTER.stPuckLocker.bApplyDisposition
   OR GVL_MASTER.stPuckLocker.bDispositionPending THEN

    RETURN;
END_IF


// -----------------------------------------------------------------------------
// PASS:
// Authorise the release of one puck.
// -----------------------------------------------------------------------------
IF bResultPass THEN

    GVL_MASTER.stPuckLocker.nRequestedRelease := 1;
    GVL_MASTER.stPuckLocker.nRequestedRemoval := 0;

    // Store the nest that originated this request so that the confirmation
    // remains associated with the correct nest even if the table moves later.
    ePendingPuckDispositionNest := eOperatorNestPosition;

    // Apply the request only after all associated data has been prepared.
    GVL_MASTER.stPuckLocker.bApplyDisposition := TRUE;

// -----------------------------------------------------------------------------
// FAIL:
// Inform the locker of the rejected result, but do not authorise puck release.
// The puck must remain locked until a future PASS result is received.
// -----------------------------------------------------------------------------
ELSIF bResultFail THEN

    GVL_MASTER.stPuckLocker.nRequestedRelease := 0;
    GVL_MASTER.stPuckLocker.nRequestedRemoval := 1;

    ePendingPuckDispositionNest := eOperatorNestPosition;

    // Apply the request only after all associated data has been prepared.
    GVL_MASTER.stPuckLocker.bApplyDisposition := TRUE;

END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_ResetProcessCycle" Id="{454cd463-1fae-4730-b15d-6fd1047cb008}">
      <Declaration><![CDATA[METHOD PRIVATE M_ResetProcessCycle : BOOL
VAR_INPUT

END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
M_ResetProcessCycle := FALSE;

eProcessCycleState := E_ProcessCycle_State.IDLE;


// =========================================================
// RESET PROCESS FLAGS
// =========================================================

GVL_MASTER.stProcess.bKistlerCycleRequest := FALSE;
GVL_MASTER.stProcess.bKistlerCycleDone := FALSE;
GVL_MASTER.stProcess.bKistlerHomeDone := FALSE;
GVL_MASTER.stProcess.bNestTestingReady := FALSE;
GVL_MASTER.stProcess.bReleaseNestRotation := FALSE;
GVL_MASTER.stProcess.bKistlerResultOK := FALSE;
GVL_MASTER.stProcess.bKistlerResultNOK := FALSE;


// =========================================================
// RESET PROCESS TIMERS
// =========================================================

tonGuideCylinderDelay(IN := FALSE);
tonGuideCylinderRetractDelay(IN := FALSE);
tonAfterKistlerDelay(IN := FALSE);


// =========================================================
// RESET ACTUATOR REQUESTS
// =========================================================

GVL_MASTER.stActuators.bGuideCylinderExtendRequest := FALSE;

GVL_MASTER.stNestTable.bSupportExtendRequest := FALSE;
GVL_MASTER.stNestTable.bSupportRetractRequest := TRUE;


// =========================================================
// RESET HMI MANUAL COMMANDS
// =========================================================

GVL_HMI.i_bHMIManualModeRequest := FALSE;
GVL_HMI.i_bHMIIndexerManualEnable := FALSE;
GVL_HMI.i_bHMIKistlerManualEnable := FALSE;


// =========================================================
// RESET KISTLER SEQUENCE COMMANDS
// =========================================================

stKistler_CMD.bStart := FALSE;
stKistler_CMD.bRunSequence := FALSE;
stKistler_CMD.bDriveToHome := FALSE;
stKistler_CMD.bDriveToRef := FALSE;
stKistler_CMD.bContinueFromWait := FALSE;
stKistler_CMD.bTareY := FALSE;


// =========================================================
// START RESET PULSE
// =========================================================

// Start the pulse only on the first execution
IF NOT bKistlerResetPulse AND NOT tonKistlerReset.Q THEN
    bKistlerResetPulse := TRUE;
END_IF;


// Reset/Acknowledge command sent to the Kistler
stKistler_CMD.bReset := bKistlerResetPulse;


// Do not send Abort at the same time as Reset
stKistler_CMD.bAbort := NOT bKistlerResetPulse;


// =========================================================
// RESET PULSE TIMER
// =========================================================

tonKistlerReset(
    IN := bKistlerResetPulse,
    PT := T#500MS
);


// =========================================================
// RESET ROUTINE COMPLETE
// =========================================================

IF tonKistlerReset.Q THEN

    // End pulse commands
    bKistlerResetPulse := FALSE;

    stKistler_CMD.bReset := FALSE;
    stKistler_CMD.bAbort := FALSE;

    // Reset the timer for the next fault/reset
    tonKistlerReset(IN := FALSE);

    // Request recovery movement on the next initialization
    bKistlerRecoveryHomeRequest := TRUE;

    // Inform caller that the reset routine is complete
    M_ResetProcessCycle := TRUE;

END_IF;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_StartFaultRejectRecovery" Id="{1379298e-0cfb-4338-ae73-185b8119dc5c}">
      <Declaration><![CDATA[METHOD PRIVATE M_StartFaultRejectRecovery
VAR
    iNestIndex : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
// -----------------------------------------------------------------------------
// Start the fault-recovery reject sequence.
//
// The nest that was at the operator position when the fault occurred is
// excluded. The other three physical nests are marked as rejected and will
// later be discarded using the normal operator exchange and reject flow.
// -----------------------------------------------------------------------------

IF eOperatorNestPosition = E_NestPosition.UNKNOWN THEN
    RETURN;
END_IF


// Save the physical nest that was at the operator position.
eFaultOperatorNest := eOperatorNestPosition;


// Mark the other three nests as rejected.
FOR iNestIndex := 1 TO 4 DO

    IF iNestIndex <> TO_INT(eFaultOperatorNest) THEN

        GVL_MASTER.astNestProcessResult[
            iNestIndex
        ].bResultValid := TRUE;

        GVL_MASTER.astNestProcessResult[
            iNestIndex
        ].bPass := FALSE;

        GVL_MASTER.astNestProcessResult[
            iNestIndex
        ].bFail := TRUE;

        GVL_MASTER.astNestProcessResult[
            iNestIndex
        ].bDispositionSent := FALSE;


        // Keep force and distance values for diagnostics.
        // Only change the displayed result.
        GVL_HMI.aKistlerNestResult[
            iNestIndex
        ].eResult := E_HMIKistlerResult.FAIL;

    END_IF

END_FOR


bFaultRejectPending := TRUE;
bFaultRejectActive := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_StatusMapping" Id="{e76387c3-2b6b-4ab8-8e2c-031286cbd112}" FolderPath="Kistler\">
      <Declaration><![CDATA[METHOD PRIVATE M_StatusMapping : BOOL
VAR

tonKistlerWarningFilter	: TON;


END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
// =================================================================================
// KISTLER TO GLOBAL STATUS MAPPING
// =================================================================================
// Link the software/hardware safety loop to the machine status structure
GVL_MASTER.stMachineStatus.bSafety := GVL_IO.stSafety.bSystemSafeOK;

// Map the local Kistler hardware ready flag to our main control variable
bKistlerReady := stKistler_Status.bReady;

// Update the global machine fault status if the Kistler press enters an error state
IF stKistler_Status.bError THEN
	GVL_MASTER.stMachineStatus.bFault := TRUE;
END_IF

// =================================================================================
// HMI / PANEL LAMP SIGNALLING MANAGEMENT
// =================================================================================
// Control the Start Button Lamp feedback based on machine state
IF GVL_MASTER.stMachineStatus.eMachineState = E_MachineState.STOPPED AND bKistlerReady THEN
    GVL_MASTER.bStartButtonLamp := GVL_MASTER.bBlink_1Hz; // Uses standard 1Hz global clock bit
ELSIF GVL_MASTER.stMachineStatus.eMachineState = E_MachineState.SYSTEM_AUTO_CYCLE THEN
    GVL_MASTER.bStartButtonLamp := TRUE;
ELSE
    GVL_MASTER.bStartButtonLamp := FALSE;
END_IF

// =================================================================================
// GLOBAL DIAGNOSTIC MAPPING
// =================================================================================

// Stop request
GVL_MASTER.stDiagnostics.bStopRequested := bStopRequested;

// Machine sequence timeouts
GVL_MASTER.stDiagnostics.bInitialisationTimeout := tonSys_InitTimeout.Q;

GVL_MASTER.stDiagnostics.bProcessTimeout := tonTimeout_testing.Q;

// Main Kistler status
GVL_MASTER.stDiagnostics.bKistlerError := stKistler_Status.bError;

GVL_MASTER.stDiagnostics.bKistlerBusy := stKistler_Status.bBusy;

GVL_MASTER.stDiagnostics.bKistlerNotReady := NOT stKistler_Status.bReady;

// Detailed Kistler telegram diagnostics
GVL_MASTER.stDiagnostics.bKistlerAlarm := stKistlerOutTelegram.bAlarm;

tonKistlerWarningFilter( IN := stKistlerOutTelegram.bWarning, PT := T#3S);
GVL_MASTER.stDiagnostics.bKistlerWarning := tonKistlerWarningFilter.Q;

GVL_MASTER.stDiagnostics.bKistlerSequenceError := stKistlerOutTelegram.bSequenceError;

GVL_MASTER.stDiagnostics.bKistlerServoError := stKistlerOutTelegram.bServoError;

GVL_MASTER.stDiagnostics.bKistlerTransmissionFault := stKistlerOutTelegram.bTransmissionFault;

GVL_MASTER.stDiagnostics.bKistlerDeviceUnavailable := NOT stKistlerOutTelegram.bDeviceAvailable;

// Nest-table diagnostics
GVL_MASTER.stDiagnostics.bNestWrongPosition := eNestState = E_NestState.WRONG_POSITION;


// =================================================================================
// METHOD EXECUTION FEEDBACK (Return True)
// =================================================================================
// Returning TRUE confirms that the status mapping routine executed successfully
M_StatusMapping := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_StoreKistlerResult" Id="{44a9f0cc-607f-440e-a240-216b02f970e5}" FolderPath="Nest_Table\">
      <Declaration><![CDATA[METHOD M_StoreKistlerResult
VAR
	iNestIndex : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF eKistlerNestPosition = E_NestPosition.Unknown THEN
    RETURN;
END_IF;

iNestIndex := eKistlerNestPosition;

IF (iNestIndex < 1) OR (iNestIndex > 4) THEN
    RETURN;
END_IF;

// Prevent writing the same result repeatedly for several PLC scans.
IF bKistlerResultStored THEN
    RETURN;
END_IF;

IF stKistler_Status.bPartOK THEN

    GVL_MASTER.astNestProcessResult[iNestIndex].bResultValid := TRUE;
    GVL_MASTER.astNestProcessResult[iNestIndex].bPass := TRUE;
    GVL_MASTER.astNestProcessResult[iNestIndex].bFail := FALSE;
    GVL_MASTER.astNestProcessResult[iNestIndex].bDispositionSent := FALSE;

    bKistlerResultStored := TRUE;

ELSIF stKistler_Status.bPartNOK THEN

    GVL_MASTER.astNestProcessResult[iNestIndex].bResultValid := TRUE;
    GVL_MASTER.astNestProcessResult[iNestIndex].bPass := FALSE;
    GVL_MASTER.astNestProcessResult[iNestIndex].bFail := TRUE;
    GVL_MASTER.astNestProcessResult[iNestIndex].bDispositionSent := FALSE;

    bKistlerResultStored := TRUE;

END_IF;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_SupportControl" Id="{64d76664-69d4-4214-9755-744a37e12132}" FolderPath="SupportElevator\">
      <Declaration><![CDATA[METHOD M_SupportControl
VAR_INPUT
    bExtendRequest  : BOOL; // Request to lift support
    bRetractRequest : BOOL; // Request to lower support
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// =================================================================
// SUPPORT CYLINDER CONTROL
// =================================================================
// This method is responsible only for the support cylinder outputs.
// It does not decide Auto Cycle or Manual Mode.
// The request must come from M_ProcessCycle, M_NestTableControl,
// or later from the Kistler coordination logic.

// Safety priority: never command both coils at the same time.
IF bExtendRequest AND NOT bRetractRequest THEN

    // Lift support
    GVL_MASTER.stNestTable.qSupportExtend  := TRUE;
    GVL_MASTER.stNestTable.qSupportRetract := FALSE;


ELSIF bRetractRequest AND NOT bExtendRequest THEN

    // Lower support
    GVL_MASTER.stNestTable.qSupportExtend  := FALSE;
    GVL_MASTER.stNestTable.qSupportRetract := TRUE;



ELSE

    // No request or conflicting request:
    // keep both outputs off to avoid fighting the pneumatic valve.
    GVL_MASTER.stNestTable.qSupportExtend  := FALSE;
    GVL_MASTER.stNestTable.qSupportRetract := FALSE;



END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_TerminalInfo" Id="{3b4d5e27-92fa-407f-953a-0393950625d4}">
      <Declaration><![CDATA[METHOD PRIVATE M_TerminalInfo
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[(*
    Updates the diagnostic information for all Beckhoff terminals.

    The terminal state value must already be mapped from the EtherCAT
    terminal diagnostic input to:

        stTerminalInfo.nTerminal_State
*)

GVL_IO.stTerm_Ek1100.stTerminalInfo.fbTerminalInfo(
    nTerminalState         := GVL_IO.stTerm_Ek1100.stTerminalInfo.nTerminal_State,
    sTerminalState         => GVL_IO.stTerm_Ek1100.stTerminalInfo.sTerminalInfo,
    bTerminalOperational   => GVL_IO.stTerm_Ek1100.stTerminalInfo.bTerminalOperational
);

GVL_IO.stTerm2_EL6070.stTerminalInfo.fbTerminalInfo(
    nTerminalState         := GVL_IO.stTerm2_EL6070.stTerminalInfo.nTerminal_State,
    sTerminalState         => GVL_IO.stTerm2_EL6070.stTerminalInfo.sTerminalInfo,
    bTerminalOperational   => GVL_IO.stTerm2_EL6070.stTerminalInfo.bTerminalOperational
);

GVL_IO.stTerm3_EL6910.stTerminalInfo.fbTerminalInfo(
    nTerminalState         := GVL_IO.stTerm3_EL6910.stTerminalInfo.nTerminal_State,
    sTerminalState         => GVL_IO.stTerm3_EL6910.stTerminalInfo.sTerminalInfo,
    bTerminalOperational   => GVL_IO.stTerm3_EL6910.stTerminalInfo.bTerminalOperational
);

GVL_IO.stTerm4_EL1918.stTerminalInfo.fbTerminalInfo(
    nTerminalState         := GVL_IO.stTerm4_EL1918.stTerminalInfo.nTerminal_State,
    sTerminalState         => GVL_IO.stTerm4_EL1918.stTerminalInfo.sTerminalInfo,
    bTerminalOperational   => GVL_IO.stTerm4_EL1918.stTerminalInfo.bTerminalOperational
);

GVL_IO.stTerm5_EL1918.stTerminalInfo.fbTerminalInfo(
    nTerminalState         := GVL_IO.stTerm5_EL1918.stTerminalInfo.nTerminal_State,
    sTerminalState         => GVL_IO.stTerm5_EL1918.stTerminalInfo.sTerminalInfo,
    bTerminalOperational   => GVL_IO.stTerm5_EL1918.stTerminalInfo.bTerminalOperational
);

GVL_IO.stTerm6_EL1918.stTerminalInfo.fbTerminalInfo(
    nTerminalState         := GVL_IO.stTerm6_EL1918.stTerminalInfo.nTerminal_State,
    sTerminalState         => GVL_IO.stTerm6_EL1918.stTerminalInfo.sTerminalInfo,
    bTerminalOperational   => GVL_IO.stTerm6_EL1918.stTerminalInfo.bTerminalOperational
);

GVL_IO.stTerm7_EL2904.stTerminalInfo.fbTerminalInfo(
    nTerminalState         := GVL_IO.stTerm7_EL2904.stTerminalInfo.nTerminal_State,
    sTerminalState         => GVL_IO.stTerm7_EL2904.stTerminalInfo.sTerminalInfo,
    bTerminalOperational   => GVL_IO.stTerm7_EL2904.stTerminalInfo.bTerminalOperational
);

GVL_IO.stTerm8_EL2904.stTerminalInfo.fbTerminalInfo(
    nTerminalState         := GVL_IO.stTerm8_EL2904.stTerminalInfo.nTerminal_State,
    sTerminalState         => GVL_IO.stTerm8_EL2904.stTerminalInfo.sTerminalInfo,
    bTerminalOperational   => GVL_IO.stTerm8_EL2904.stTerminalInfo.bTerminalOperational
);

GVL_IO.stTerm9_EL1809.stTerminalInfo.fbTerminalInfo(
    nTerminalState         := GVL_IO.stTerm9_EL1809.stTerminalInfo.nTerminal_State,
    sTerminalState         => GVL_IO.stTerm9_EL1809.stTerminalInfo.sTerminalInfo,
    bTerminalOperational   => GVL_IO.stTerm9_EL1809.stTerminalInfo.bTerminalOperational
);

GVL_IO.stTerm10_EL1809.stTerminalInfo.fbTerminalInfo(
    nTerminalState         := GVL_IO.stTerm10_EL1809.stTerminalInfo.nTerminal_State,
    sTerminalState         => GVL_IO.stTerm10_EL1809.stTerminalInfo.sTerminalInfo,
    bTerminalOperational   => GVL_IO.stTerm10_EL1809.stTerminalInfo.bTerminalOperational
);

GVL_IO.stTerm11_EL2809.stTerminalInfo.fbTerminalInfo(
    nTerminalState         := GVL_IO.stTerm11_EL2809.stTerminalInfo.nTerminal_State,
    sTerminalState         => GVL_IO.stTerm11_EL2809.stTerminalInfo.sTerminalInfo,
    bTerminalOperational   => GVL_IO.stTerm11_EL2809.stTerminalInfo.bTerminalOperational
);

GVL_IO.stTerm12_EL9410.stTerminalInfo.fbTerminalInfo(
    nTerminalState         := GVL_IO.stTerm12_EL9410.stTerminalInfo.nTerminal_State,
    sTerminalState         => GVL_IO.stTerm12_EL9410.stTerminalInfo.sTerminalInfo,
    bTerminalOperational   => GVL_IO.stTerm12_EL9410.stTerminalInfo.bTerminalOperational
);

GVL_IO.stTerm13_EL2809.stTerminalInfo.fbTerminalInfo(
    nTerminalState         := GVL_IO.stTerm13_EL2809.stTerminalInfo.nTerminal_State,
    sTerminalState         => GVL_IO.stTerm13_EL2809.stTerminalInfo.sTerminalInfo,
    bTerminalOperational   => GVL_IO.stTerm13_EL2809.stTerminalInfo.bTerminalOperational
);

GVL_IO.stTerm14_EL3058.stTerminalInfo.fbTerminalInfo(
    nTerminalState         := GVL_IO.stTerm14_EL3058.stTerminalInfo.nTerminal_State,
    sTerminalState         => GVL_IO.stTerm14_EL3058.stTerminalInfo.sTerminalInfo,
    bTerminalOperational   => GVL_IO.stTerm14_EL3058.stTerminalInfo.bTerminalOperational
);

// -----------------------------------------------------------------------------
// T04 - EL1918 channel mirrors for HMI diagnostics
// -----------------------------------------------------------------------------
GVL_IO.stTerm4_EL1918.iEL1918_Ch1 := GVL_IO.stSafety.bEStopCH1;
GVL_IO.stTerm4_EL1918.iEL1918_Ch2 := GVL_IO.stSafety.bEStopCH2;
GVL_IO.stTerm4_EL1918.iEL1918_Ch3 := GVL_MASTER.i_bButtonReset;

// -----------------------------------------------------------------------------
// T06 - EL1918 channel mirrors for HMI diagnostics
// -----------------------------------------------------------------------------
GVL_IO.stTerm6_EL1918.iEL1918_Ch1 := GVL_IO.stSafety.bDoorFlapLeftCH1;
GVL_IO.stTerm6_EL1918.iEL1918_Ch2 := GVL_IO.stSafety.bDoorFlapLeftCH2;
GVL_IO.stTerm6_EL1918.iEL1918_Ch4 := GVL_IO.stSafety.bDoorFlapRightCH1;
GVL_IO.stTerm6_EL1918.iEL1918_Ch5 := GVL_IO.stSafety.bDoorFlapRightCH2;

// -----------------------------------------------------------------------------
// T07- EL2904 channel mirrors for HMI diagnostics
// -----------------------------------------------------------------------------
GVL_IO.stTerm7_EL2904.qEL2904_Ch1 := GVL_IO.stSafety.bAirSupplyEnabled;
GVL_IO.stTerm7_EL2904.qEL2904_Ch2 := GVL_IO.stSafety.bSafetyReset;
GVL_IO.stTerm7_EL2904.qEL2904_Ch3 := GVL_IO.stSafety.bMainDoorLocked;
GVL_IO.stTerm7_EL2904.qEL2904_Ch4 := FALSE;

// -----------------------------------------------------------------------------
// T08- EL2904 channel mirrors for HMI diagnostics
// -----------------------------------------------------------------------------
GVL_IO.stTerm8_EL2904.qEL2904_Ch1 := GVL_IO.stSafety.bSafetyRelayIndraDrive;
GVL_IO.stTerm8_EL2904.qEL2904_Ch2 := GVL_IO.stSafety.bIndraDriveEStop;
GVL_IO.stTerm8_EL2904.qEL2904_Ch3 := GVL_IO.stSafety.bSafetyRelayEStop;
GVL_IO.stTerm8_EL2904.qEL2904_Ch4 := FALSE;
// -----------------------------------------------------------------------------
// T09 - EL1809 channel mirrors for HMI diagnostics
// -----------------------------------------------------------------------------
GVL_IO.stTerm9_EL1809.iEL1809_Ch1 := GVL_MASTER.i_bButtonStart;
GVL_IO.stTerm9_EL1809.iEL1809_Ch2 := GVL_MASTER.i_bButtonStop;
//GVL_IO.stTerm9_EL1809.iEL1809_Ch3 := ;
//GVL_IO.stTerm9_EL1809.iEL1809_Ch4 := ;
GVL_IO.stTerm9_EL1809.iEL1809_Ch5 := GVL_MASTER.stSensors.bPartPresent_Reject;
GVL_IO.stTerm9_EL1809.iEL1809_Ch6 := GVL_MASTER.stNestTable.bNestPos_1_Sensor;
GVL_IO.stTerm9_EL1809.iEL1809_Ch7 := GVL_MASTER.stNestTable.bNestPos_2_Sensor;
GVL_IO.stTerm9_EL1809.iEL1809_Ch8 := GVL_MASTER.stNestTable.bNestPos_3_Sensor;
GVL_IO.stTerm9_EL1809.iEL1809_Ch9 := GVL_MASTER.stNestTable.bNestCompletedSensor;
GVL_IO.stTerm9_EL1809.iEL1809_Ch10 := GVL_MASTER.stNestTable.bNestLockedSensor;
GVL_IO.stTerm9_EL1809.iEL1809_Ch11 := GVL_MASTER.stNestTable.bNestReadySensor;
GVL_IO.stTerm9_EL1809.iEL1809_Ch12 := GVL_MASTER.stSensors.bPartPresent_NEST;
GVL_IO.stTerm9_EL1809.iEL1809_Ch13 := GVL_MASTER.stSensors.bPartPresent_Kistler;

// -----------------------------------------------------------------------------
// T10 - EL1809 channel mirrors for HMI diagnostics
// -----------------------------------------------------------------------------
GVL_IO.stTerm10_EL1809.iEL1809_Ch1 := GVL_MASTER.stNestTable.bSupportRetracted;
GVL_IO.stTerm10_EL1809.iEL1809_Ch2 := GVL_MASTER.stNestTable.bSupportExtended;
// -----------------------------------------------------------------------------
// T11 - EL12809 channel mirrors for HMI diagnostics
// -----------------------------------------------------------------------------

GVL_IO.stTerm11_EL2809.iEL2809_Ch1 := PRG_MachineControl.q_bLED_Start;
GVL_IO.stTerm11_EL2809.iEL2809_Ch2 := PRG_MachineControl.q_bLED_Reset;
GVL_IO.stTerm11_EL2809.iEL2809_Ch3 := PRG_MachineControl.q_bLED_Fail;
GVL_IO.stTerm11_EL2809.iEL2809_Ch4 := PRG_MachineControl.q_bLED_Pass;
GVL_IO.stTerm11_EL2809.iEL2809_Ch5 := GVL_IO.qInternalLight;
GVL_IO.stTerm11_EL2809.iEL2809_Ch6 := GVL_MASTER.stNestTable.qNestRotatePortB;
GVL_IO.stTerm11_EL2809.iEL2809_Ch7 := GVL_MASTER.stNestTable.qNestRotatePortA;
GVL_IO.stTerm11_EL2809.iEL2809_Ch8 := GVL_MASTER.stNestTable.qSupportExtend;
GVL_IO.stTerm11_EL2809.iEL2809_Ch9 := GVL_MASTER.stNestTable.qSupportRetract;
GVL_IO.stTerm11_EL2809.iEL2809_Ch10 := GVL_MASTER.stActuators.qGuideCylinder;
GVL_IO.stTerm11_EL2809.iEL2809_Ch11 := FALSE;
GVL_IO.stTerm11_EL2809.iEL2809_Ch12 := FALSE;
GVL_IO.stTerm11_EL2809.iEL2809_Ch13 := FALSE;
GVL_IO.stTerm11_EL2809.iEL2809_Ch14 := FALSE;
GVL_IO.stTerm11_EL2809.iEL2809_Ch15 := FALSE;
GVL_IO.stTerm11_EL2809.iEL2809_Ch16 := FALSE;


// -----------------------------------------------------------------------------
// T13 - EL12809 channel mirrors for HMI diagnostics
// -----------------------------------------------------------------------------

GVL_IO.stTerm13_EL2809.iEL2809_Ch9 := GVL_IO.qExternalLight;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_UpdateActiveNestPositions" Id="{a175beaf-3ad8-4d7b-8c4f-5074246f2c65}" FolderPath="Nest_Table\">
      <Declaration><![CDATA[METHOD PRIVATE M_UpdateActiveNestPositions
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[eKistlerNestPosition := eCurrentNestPos;

eOperatorNestPosition := F_GetOppositeNestPosition( eKistlerPosition := eKistlerNestPosition );

IF eKistlerNestPosition <> E_NestPosition.Unknown THEN

    iKistlerNestIndex := TO_INT(eKistlerNestPosition);

ELSE

    iKistlerNestIndex := 0;

END_IF;

IF eOperatorNestPosition <> E_NestPosition.Unknown THEN

    iOperatorNestIndex := TO_INT(eOperatorNestPosition);

ELSE

    iOperatorNestIndex := 0;

END_IF;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_UpdateMachineMessage" Id="{be75d2f8-1d8e-4982-923d-f25114b7d3b4}">
      <Declaration><![CDATA[METHOD PRIVATE M_UpdateMachineMessage
VAR
	bPuckLockerEnabled	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// -----------------------------------------------------------------------------
// Default message.
// -----------------------------------------------------------------------------
sMachineMessage := '';

bPuckLockerEnabled :=
    GVL_HMI.stPuckLocker.eMode <>
        E_PuckLockerMode.Disabled;


// -----------------------------------------------------------------------------
// Machine messages are currently used during Automatic Cycle.
// -----------------------------------------------------------------------------
IF GVL_MASTER.stMachineStatus.eMachineState =
    E_MachineState.SYSTEM_AUTO_CYCLE THEN


    // =========================================================================
    // Highest priority:
    // The table is physically moving.
    // =========================================================================
    IF GVL_MASTER.stNestTable.bNestInMotion THEN

        sMachineMessage :=
            'Table indexing - keep hands clear';


    ELSE

        // =====================================================================
        // Operator-exchange sequence.
        //
        // Messages follow the exact same state machine that controls table
        // permission. This prevents instructions from appearing out of order.
        // =====================================================================
        CASE eOperatorExchangeState OF


            // =================================================================
            E_OperatorExchangeState.Idle:
            // =================================================================

                IF bPuckLockerEnabled THEN

                    // ---------------------------------------------------------
                    // Puck Locker enabled:
                    // first require the puck to be present and locked.
                    // ---------------------------------------------------------
                    IF NOT GVL_MASTER.stPuckLocker.bPuckDetected THEN

                        sMachineMessage :=
                            'Insert puck into locker to continue';

                    ELSIF
                        NOT GVL_MASTER.stPuckLocker.bPuckLocked
                        OR
                        GVL_MASTER.stPuckLocker.eState <>
                            E_PuckLockerState.Locked THEN

                        sMachineMessage :=
                            'Waiting for puck locker to lock puck';

                    ELSIF NOT GVL_MASTER.stSensors.bPartPresent_NEST THEN

                        sMachineMessage :=
                            'Load part into operator nest';

                    ELSE

                        sMachineMessage :=
                            'Machine ready - press two-hand buttons to index';

                    END_IF


                ELSE

                    // ---------------------------------------------------------
                    // Puck Locker disabled:
                    // an empty operator nest is allowed to continue.
                    // ---------------------------------------------------------
                    IF GVL_MASTER.stSensors.bPartPresent_NEST THEN

                        sMachineMessage :=
                            'Part loaded - press two-hand buttons to index';

                    ELSE

                        sMachineMessage :=
                            'Load new part or continue with empty nest';

                    END_IF

                END_IF


            // =================================================================
            E_OperatorExchangeState.WaitingForPartRemoval:
            // =================================================================

                // The processed part must always be removed first.
                IF bPendingOperatorResultFail THEN

                    sMachineMessage :=
                        'Remove failed part from operator nest';

                ELSIF bPendingOperatorResultPass THEN

                    sMachineMessage :=
                        'Remove passed part from operator nest';

                ELSE

                    sMachineMessage :=
                        'Remove processed part from operator nest';

                END_IF


            // =================================================================
            E_OperatorExchangeState.WaitingForRejectConfirmation:
            // =================================================================

                // This state is reached only after removal has been confirmed.
                // Do not show a "confirmed" message here. Once the reject pulse
                // is accepted, the state machine exits this state automatically.
                sMachineMessage :=
                    'Place failed part into reject station';


            // =================================================================
            E_OperatorExchangeState.WaitingForPuckRemoval:
            // =================================================================

                IF bPuckLockerEnabled THEN

                    IF GVL_MASTER.stPuckLocker.bPuckDetected THEN

                        sMachineMessage :=
                            'Remove released puck from locker';

                    ELSE

                        sMachineMessage :=
                            'Insert new puck into locker';

                    END_IF

                ELSE

                    // Recovery protection if the locker is disabled while
                    // this state is still active.
                    sMachineMessage :=
                        'Operator exchange completing';

                END_IF


            // =================================================================
            E_OperatorExchangeState.WaitingForNewPuck:
            // =================================================================

                IF bPuckLockerEnabled THEN

                    sMachineMessage :=
                        'Insert new puck into locker';

                ELSE

                    sMachineMessage :=
                        'Operator exchange completing';

                END_IF


            // =================================================================
            E_OperatorExchangeState.WaitingForPuckLocked:
            // =================================================================

                IF bPuckLockerEnabled THEN

                    sMachineMessage :=
                        'Waiting for puck locker to lock new puck';

                ELSE

                    sMachineMessage :=
                        'Operator exchange completing';

                END_IF


            // =================================================================
            E_OperatorExchangeState.WaitingForPartLoading:
            // =================================================================

                IF GVL_MASTER.stSensors.bPartPresent_NEST THEN

                    sMachineMessage :=
                        'New part loaded - ready to index';

                ELSE

                    sMachineMessage :=
                        'Load new part into operator nest';

                END_IF


            // =================================================================
            E_OperatorExchangeState.ExchangeComplete:
            // =================================================================

                sMachineMessage :=
                    'Operator exchange complete - press two-hand buttons to index';


            // =================================================================
            E_OperatorExchangeState.WaitingForTableIndexComplete:
            // =================================================================

                // Normally table movement is caught by the higher-priority
                // bNestInMotion condition. This message covers the transition
                // immediately before or after physical movement.
                sMachineMessage :=
                    'Table index in progress';


            // =================================================================
            ELSE
            // =================================================================

                sMachineMessage := '';

        END_CASE

    END_IF

END_IF


// -----------------------------------------------------------------------------
// Publish current machine instruction.
// -----------------------------------------------------------------------------
GVL_MASTER.sMachineMessage :=
    sMachineMessage;


// -----------------------------------------------------------------------------
// Temporary direct connection to DataGrid row zero.
// -----------------------------------------------------------------------------
GVL_MASTER.astActiveEvents[0].sEventTex :=
    sMachineMessage;

GVL_MASTER.astActiveEvents[0].sType :=
    'Message';

GVL_MASTER.astActiveEvents[0].sSolution :=
    '';

GVL_MASTER.astActiveEvents[0].abType :=
    3;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_UpdateOperatorInstruction" Id="{9003e453-721d-4c1e-a060-193bc77fe83e}" FolderPath="Nest_Table\">
      <Declaration><![CDATA[METHOD PRIVATE M_UpdateOperatorInstruction
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_UpdateOperatorNestTracking" Id="{d4e87f72-d62a-4a59-bdf7-747a3fa48afb}" FolderPath="Nest_Table\">
      <Declaration><![CDATA[METHOD PRIVATE M_UpdateOperatorNestTracking
VAR
	iOperatorNestIndex 	: INT;
    iNest               : INT;
    bPartPresent        : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Pulses are valid for one PLC scan only.
// Clear all previous events before evaluating the current operator nest.
FOR iNest := 1 TO 4 DO

    GVL_MASTER.astNestTracking[iNest].bPartRemovedPulse := FALSE;
    GVL_MASTER.astNestTracking[iNest].bPartLoadedPulse := FALSE;

END_FOR

// Track the operator sensor while the table is safely stationary.
// IDLE is required for the initial loading sequence.
// TESTING is required for the normal unload/reload sequence.
IF (
        eNestState <> E_NestState.IDLE
        AND eNestState <> E_NestState.TESTING
        AND eNestState <> E_NestState.WAIT_OPERATOR_EXCHANGE
   )
   OR GVL_MASTER.stNestTable.bNestInMotion
   OR NOT GVL_MASTER.stNestTable.bNestReadySensor
   OR NOT GVL_MASTER.stNestTable.bNestLockedSensor
   OR eOperatorNestPosition = E_NestPosition.Unknown THEN

    RETURN;

END_IF

// E_NestPosition corresponds to indexes 1..4.
iOperatorNestIndex := TO_INT(eOperatorNestPosition);

IF (iOperatorNestIndex < 1) OR (iOperatorNestIndex > 4) THEN
    RETURN;
END_IF

// The physical sensor represents the nest currently accessible
// to the operator.
bPartPresent := GVL_MASTER.stSensors.bPartPresent_NEST;

// ============================================================================
// PART REMOVAL CONTROL WITHOUT PUCK LOCKER
// ============================================================================

// Evaluate the part sensor only when a different nest has arrived
// at the operator position.
//
// A part already present when the nest arrives is considered a processed
// part and must be removed before the table can index again.
IF GVL_HMI.stPuckLocker.eMode = E_PuckLockerMode.Disabled THEN

    IF eOperatorNestPosition <> eLastOperatorNestPositionNoLocker THEN

        eLastOperatorNestPositionNoLocker := eOperatorNestPosition;

        bPartRemovalRequiredNoLocker := bPartPresent;

    END_IF

ELSE

    // This memory is not used when the Puck Locker is enabled.
    bPartRemovalRequiredNoLocker := FALSE;

    // Keep the current position synchronized so that changing modes does
    // not create a false new-position detection.
    eLastOperatorNestPositionNoLocker := eOperatorNestPosition;

END_IF

// Detect processed part removal.
GVL_MASTER.astNestTracking[iOperatorNestIndex].bPartRemovedPulse := GVL_MASTER.astNestTracking[iOperatorNestIndex].bPreviousSensor AND NOT bPartPresent;

// Once the part that arrived with the nest has been physically removed,
// allow the next index.
//
// Loading another part afterwards must not reactivate this requirement.
IF GVL_HMI.stPuckLocker.eMode = E_PuckLockerMode.Disabled
   AND bPartRemovalRequiredNoLocker
   AND GVL_MASTER.astNestTracking[iOperatorNestIndex].bPartRemovedPulse THEN

    bPartRemovalRequiredNoLocker := FALSE;

END_IF

// Detect new part loading.
GVL_MASTER.astNestTracking[iOperatorNestIndex].bPartLoadedPulse := NOT GVL_MASTER.astNestTracking[iOperatorNestIndex].bPreviousSensor AND bPartPresent;

// Store the current occupancy status.
GVL_MASTER.astNestTracking[iOperatorNestIndex].bPartLoaded := bPartPresent;

// Save the current sensor state for the next scan.
GVL_MASTER.astNestTracking[iOperatorNestIndex].bPreviousSensor := bPartPresent;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_UpdatePuckLockerPartRemovalStatus" Id="{f9bf3ed2-647f-49ac-acef-7d7719e93b2e}" FolderPath="Pick_Locker\">
      <Declaration><![CDATA[METHOD PRIVATE M_UpdatePuckLockerPartRemovalStatus
VAR
	iOperatorNestIndex : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Keep the removal confirmation active until the Puck Locker
// acknowledges it by leaving the Locked state.
//
// Do not forward the one-scan physical sensor pulse directly.
GVL_MASTER.stPuckLocker.bPartRemovedFromNest := bPendingOperatorResultPass AND bPartRemovedConfirmedForExchange;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_UpdatePuckLockerPermissives" Id="{a5082c5a-ff24-4e5c-a334-ef2912094065}" FolderPath="Pick_Locker\">
      <Declaration><![CDATA[METHOD PRIVATE M_UpdatePuckLockerPermissives
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Puck Locker is considered permissive when disabled,
// or when enabled without any latched locker fault.
GVL_MASTER.stPuckLocker.bMachinePermissive :=
    (GVL_HMI.stPuckLocker.eMode = E_PuckLockerMode.Disabled)
    OR
    (
        NOT GVL_MASTER.stPuckLocker.bUnexpectedRemovalFault
        AND NOT GVL_MASTER.stPuckLocker.bPuckSensorMismatch
        AND GVL_MASTER.stPuckLocker.eState
            <> E_PuckLockerState.UnexpectedPuckRemovalFault
    );


// The table can index only after the complete operator-exchange
// sequence has finished.
//
// PASS:
// Part removed from nest -> exchange complete.
//
// FAIL:
// Part removed from nest -> reject sensor confirmed
// -> exchange complete.
GVL_MASTER.stPuckLocker.bIndexPermissive :=
    GVL_MASTER.stPuckLocker.bMachinePermissive
    AND bOperatorExchangeComplete;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_UpdateStatisticsAndHistory" Id="{00ee633c-8762-44a1-a124-fd33218f5608}">
      <Declaration><![CDATA[METHOD M_UpdateStatisticsAndHistory
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// =========================================================
// LOCAL SYSTEM TIME
// =========================================================

// Update the local system time cyclically.
fbLocalSystemTime(
    bEnable := TRUE,
    dwCycle := 1
);


// =========================================================
// DATA HISTORY INDEX VALIDATION
// =========================================================

IF (GVL_HMI.iDataHistoryWriteIndex < 1)
   OR (GVL_HMI.iDataHistoryWriteIndex > 2000) THEN

    GVL_HMI.iDataHistoryWriteIndex := 1;

END_IF


// =========================================================
// DETECT COMPLETED KISTLER TEST
// =========================================================

rtKistlerResultDone(
    CLK := stKistler_Status.bDone
);


// Do not write new history entries while the history is
// being cleared.
IF rtKistlerResultDone.Q
   AND NOT bDataHistoryResetActive THEN

    // =====================================================
    // STATISTICS
    // =====================================================

    IF stKistler_Status.bPartOK THEN

        GVL_HMI.udiKistlerTotalTested :=
            GVL_HMI.udiKistlerTotalTested + 1;

        GVL_HMI.udiKistlerTotalPass :=
            GVL_HMI.udiKistlerTotalPass + 1;

    ELSIF stKistler_Status.bPartNOK THEN

        GVL_HMI.udiKistlerTotalTested :=
            GVL_HMI.udiKistlerTotalTested + 1;

        GVL_HMI.udiKistlerTotalFail :=
            GVL_HMI.udiKistlerTotalFail + 1;

    END_IF


    // =====================================================
    // SAFE NEST POSITION MAPPING
    // =====================================================

    CASE eCurrentNestPos OF

        E_NestPosition.Position_1:
            iDataHistoryNestIndex := 1;

        E_NestPosition.Position_2:
            iDataHistoryNestIndex := 2;

        E_NestPosition.Position_3:
            iDataHistoryNestIndex := 3;

        E_NestPosition.Position_4:
            iDataHistoryNestIndex := 4;

    ELSE

        iDataHistoryNestIndex := 0;

    END_CASE


    // =====================================================
    // STORE DATA HISTORY ENTRY
    // =====================================================

    IF (iDataHistoryNestIndex >= 1)
       AND (iDataHistoryNestIndex <= 4) THEN

        // Nest.
        GVL_HMI.aDataHistoryHMI[
            GVL_HMI.iDataHistoryWriteIndex
        ].iNestIndex :=
            iDataHistoryNestIndex;


        // Result.
        IF stKistler_Status.bPartOK THEN

            GVL_HMI.aDataHistoryHMI[
                GVL_HMI.iDataHistoryWriteIndex
            ].sResult := 'PASS';

        ELSIF stKistler_Status.bPartNOK THEN

            GVL_HMI.aDataHistoryHMI[
                GVL_HMI.iDataHistoryWriteIndex
            ].sResult := 'FAIL';

        ELSE

            GVL_HMI.aDataHistoryHMI[
                GVL_HMI.iDataHistoryWriteIndex
            ].sResult := '';

        END_IF


        // Force.
        GVL_HMI.aDataHistoryHMI[
            GVL_HMI.iDataHistoryWriteIndex
        ].rForce :=
            GVL_HMI.aKistlerNestResult[
                iDataHistoryNestIndex
            ].rForce;


        // Distance.
        GVL_HMI.aDataHistoryHMI[
            GVL_HMI.iDataHistoryWriteIndex
        ].rDistance :=
            GVL_HMI.aKistlerNestResult[
                iDataHistoryNestIndex
            ].rDistance;


        // Date and time.
        GVL_HMI.aDataHistoryHMI[
            GVL_HMI.iDataHistoryWriteIndex
        ].dtTimeStamp :=
            SYSTEMTIME_TO_DT(
                fbLocalSystemTime.systemTime
            );


        // Move to the next history position.
        GVL_HMI.iDataHistoryWriteIndex :=
            GVL_HMI.iDataHistoryWriteIndex + 1;


        // Circular history.
        IF GVL_HMI.iDataHistoryWriteIndex > 2000 THEN

            GVL_HMI.iDataHistoryWriteIndex := 1;

        END_IF

    END_IF

END_IF


// =========================================================
// HMI STATISTICS MAPPING
// =========================================================

GVL_HMI.aStatisticsHMI[1].udiTotalTested :=
    GVL_HMI.udiKistlerTotalTested;

GVL_HMI.aStatisticsHMI[1].udiGoodParts :=
    GVL_HMI.udiKistlerTotalPass;

GVL_HMI.aStatisticsHMI[1].udiBadParts :=
    GVL_HMI.udiKistlerTotalFail;


// Calculate efficiency.
IF GVL_HMI.aStatisticsHMI[1].udiTotalTested > 0 THEN

    GVL_HMI.aStatisticsHMI[1].rEfficiency :=
        UDINT_TO_REAL(
            GVL_HMI.aStatisticsHMI[1].udiGoodParts
        )
        * 100.0
        /
        UDINT_TO_REAL(
            GVL_HMI.aStatisticsHMI[1].udiTotalTested
        );

ELSE

    GVL_HMI.aStatisticsHMI[1].rEfficiency := 0.0;

END_IF


// =========================================================
// START STATISTICS AND HISTORY RESET
// =========================================================

IF GVL_HMI.aStatisticsHMI[1].bReset
   AND NOT bDataHistoryResetActive THEN

    // Reset statistics.
    GVL_HMI.udiKistlerTotalTested := 0;
    GVL_HMI.udiKistlerTotalPass := 0;
    GVL_HMI.udiKistlerTotalFail := 0;

    // Start history clearing.
    iDataHistoryResetIndex := 1;
    bDataHistoryResetActive := TRUE;

    // Clear the HMI request.
    GVL_HMI.aStatisticsHMI[1].bReset := FALSE;

END_IF


// =========================================================
// CLEAR ONE HISTORY ENTRY PER PLC CYCLE
// =========================================================

// Clearing one entry per scan avoids processing all 2000
// structures in a single PLC cycle.
IF bDataHistoryResetActive THEN

    GVL_HMI.aDataHistoryHMI[
        iDataHistoryResetIndex
    ].iNestIndex := 0;

    GVL_HMI.aDataHistoryHMI[
        iDataHistoryResetIndex
    ].sResult := '';

    GVL_HMI.aDataHistoryHMI[
        iDataHistoryResetIndex
    ].rDistance := 0.0;

    GVL_HMI.aDataHistoryHMI[
        iDataHistoryResetIndex
    ].rForce := 0.0;

    GVL_HMI.aDataHistoryHMI[
        iDataHistoryResetIndex
    ].dtTimeStamp :=
        DT#1970-01-01-00:00:00;


    IF iDataHistoryResetIndex < 2000 THEN

        iDataHistoryResetIndex :=
            iDataHistoryResetIndex + 1;

    ELSE

        // History clearing completed.
        GVL_HMI.iDataHistoryWriteIndex := 1;

        iDataHistoryResetIndex := 1;
        bDataHistoryResetActive := FALSE;

    END_IF

END_IF]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>