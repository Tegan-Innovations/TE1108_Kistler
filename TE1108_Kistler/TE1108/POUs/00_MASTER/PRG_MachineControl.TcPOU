<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="PRG_MachineControl" Id="{73cce6c0-0336-454e-b089-fed285c9fc85}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM PRG_MachineControl
VAR
    // =========================================================
    // TIMERS & TRIGGERS
    // =========================================================
	tonSys_Init           : TON := (PT := T#8S);    // Initialization pulse timer
    tonSys_InitTimeout    : TON := (PT := T#12S);   // Initialization timeout fault timer
    tonFirstAutoCycle     : TON := (PT := T#500MS); // Auto cycle start settling timer
	tonStoppingDelay	  : TON                   ; // Time to finalize process 
    tonSafety             : TON := (PT := T#10S);   // Safety interlock debounce timer
	tonSimulation		  : ARRAY[1..4] OF TON; //timer for simulations  
    
    rtFirstAutoCycle      : R_TRIG; // Detects entry into Auto Cycle
    fbResetTrigger        : F_TRIG; // Detects HMI Reset button release
	fbStopTrigger         : F_TRIG;// Detects phisical button input
	bButtonStop           : BOOL; // Logic signal (pulses TRUE for 1 cycle when pressed)
	         
    
    // =========================================================
    // PROCESS CYCLE CONTROL
    // =========================================================
	bStartProcessCondition : BOOL;   // OK to Start checklist condition flag
    bKistlerReady          : BOOL;   // Press healthy and ready feedback flag
    i                      : INT;    // Loop index counter
    sMachineMessage        : STRING; // Diagnostics and status message string
	
	// =================================================================
    // NEST TABLE INTERNAL CONTROL VARIABLES
    // =================================================================
	eNestState           : E_NestState := E_NestState.IDLE;
	bSequenceToggle      : BOOL := FALSE;                   // Toggle flag for manual bench testing
	eCurrentNestPos 	 : E_NestPosition := E_NestPosition.UNKNOWN;
	
    // HMI PARAMETERS & SAFETY TIMERS
    rHmiTwoHandPresetTime : REAL := 250.0; // Time preset from HMI in milliseconds (e.g., 1500.0 ms = 1.5s)
    tTwoHandTargetTime    : TIME;           // Converted time to be used by the PLC timer
    tTwoHandHoldTimer     : TON;            // Timer to verify if operator held the buttons long enough
	
	// Timers for pneumatic steps control without sensors
	tSupportRetractDelay : TON;  // Time for elevator cylinder to retract down
	tRotatingTableDelay  : TON;  // Simulated time for index table to complete rotation
	tPortB_ResetDelay    : TON;  // Pulse time for Port B air relief / mechanism reset
	tSupportExtendDelay  : TON;  // Time for elevator cylinder to extend back up

	
	//==========================================================
	//KISTLER COMMAND INTERFACE 
	//==========================================================
	stKistler_CMD          : ST_Kistler_CMD;    // Commands sent to Kistler press
    stKistler_Status       : ST_Kistler_Status; // Feedbacks read from Kistler press

	//==========================================================
	//LEDS COMMAND INTERFACE 
	//==========================================================

    // Status memory for each individual LED mode
    eMode_LED_Start    : E_LEDs_Mode := E_LEDs_Mode.OFF;
    eMode_LED_Reset    : E_LEDs_Mode := E_LEDs_Mode.OFF;
	eMode_LED_Pass 	   : E_LEDs_Mode := E_LEDs_Mode.OFF;
    eMode_LED_fail     : E_LEDs_Mode := E_LEDs_Mode.OFF;
    // Hardware digital outputs mapped to the physical LEDs
    q_bLED_Start      AT%Q*    : BOOL; 
    q_bLED_Reset      AT%Q*    : BOOL;
	q_bLED_Pass       AT%Q*    : BOOL;
	q_bLED_Fail       AT%Q*    : BOOL;
    
	
    // =========================================================
    // PERSISTENT DATA & LOGGING
    // =========================================================
    //fbWritePersistent      : FB_WritePersistentData;
	bWriteTrigger          : BOOL; // Test and simulation sequence trigger
END_VAR

]]></Declaration>
    <Implementation>
      <ST><![CDATA[// // =================================================================================
// // SIMULATION: AUTOMATIC HMI BUTTON RELEASE (PULSE SIMULATION)
// // =================================================================================
// // If the HMI buttons are forced TRUE, turn them FALSE on the very next scan cycle
// tonSimulation[1] (IN:= GVL_MASTER.bButtonStart, PT:= T#1S);
// IF tonSimulation[1].Q AND GVL_MASTER.bButtonStart THEN
//     GVL_MASTER.bButtonStart := FALSE;
// END_IF
// 
// tonSimulation[2] (IN:= GVL_MASTER.bButtonReset, PT:= T#1S);
// IF tonSimulation[2].Q THEN
//     GVL_MASTER.bButtonReset := FALSE;
// END_IF
// 
// tonSimulation[3] (IN:= GVL_MASTER.bButtonStop, PT:= T#1S);
// IF tonSimulation[3].Q THEN
//     GVL_MASTER.bButtonStop := FALSE;
// END_IF




// =========================================================
// 1. PRE-CONDITION LOGIC
// =========================================================
M_PreExecution();

bStartProcessCondition := GVL_MASTER.stMachineStatus.bSafety AND GVL_MASTER.i_bButtonEmergencyStop AND
						  NOT GVL_MASTER.stMachineStatus.bFault AND 
						  bKistlerReady;
						  
						  	  
IF (NOT GVL_MASTER.stMachineStatus.bSafety OR NOT GVL_MASTER.i_bButtonEmergencyStop)AND 
   GVL_MASTER.stMachineStatus.eMachineState <> E_MachineState.FAULT THEN
    GVL_MASTER.stMachineStatus.eMachineState := E_MachineState.FAULT;
END_IF;


// // =========================================================
// 2. MAIN STATE MACHINE (CASE)
// =========================================================


CASE GVL_Master.stMachineStatus.eMachineState OF


    E_MachineState.SYSTEM_POWER_UP:
	    GVL_Master.stMachineStatus.eMachineState := E_MachineState.STOPPING;
		
    E_MachineState.FAULT:
 		eMode_LED_Start := E_LEDs_Mode.OFF;
        eMode_LED_Reset := E_LEDs_Mode.FLASHING; // Reset button must flash
		eMode_LED_Fail := E_LEDs_Mode.ON;
		eMode_LED_PASS := E_LEDs_Mode.OFF;
		
        IF  GVL_MASTER.stMachineStatus.bSafety AND GVL_MASTER.i_bButtonEmergencyStop AND GVL_Master.i_bButtonReset THEN
            GVL_Master.stMachineStatus.eMachineState := E_MachineState.STOPPING;
        END_IF
		
	E_MachineState.STOPPING:
		eMode_LED_PASS := E_LEDs_Mode.OFF;
		eMode_LED_Fail := E_LEDs_Mode.OFF;
        rtFirstAutoCycle(CLK := FALSE);
        tonStoppingDelay(IN := GVL_Master.stMachineStatus.bStopping, PT := T#2S);
		IF tonStoppingDelay.Q THEN
			tonStoppingDelay(IN := FALSE);
        	GVL_Master.stMachineStatus.eMachineState := E_MachineState.STOPPED;
		END_IF
	   
	E_MachineState.STOPPED:
		eMode_LED_Reset := E_LEDs_Mode.FLASHING; // Start button must flash
        eMode_LED_Start := E_LEDs_Mode.OFF;
		eMode_LED_PASS := E_LEDs_Mode.OFF;
		eMode_LED_Fail := E_LEDs_Mode.OFF;
		
        IF GVL_Master.i_bButtonReset AND bStartProcessCondition THEN
            GVL_Master.stMachineStatus.eMachineState := E_MachineState.SYSTEM_INITIALISING;
        END_IF

		
	E_MachineState.SYSTEM_INITIALISING:
	
		tonSys_Init (IN := GVL_MASTER.stMachineStatus.bInitialising);
		tonSys_InitTimeout (IN := GVL_MASTER.stMachineStatus.bInitialising);
		
		IF tonSys_Init.Q AND GVL_IO.stSafety.bSafetyOK AND bStartProcessCondition THEN
			GVL_MASTER.stMachineStatus.eMachineState := E_MachineState.SYSTEM_READY_TO_START;
			
		ELSIF tonSys_InitTimeout.Q AND NOT GVL_IO.stSafety.bSafetyOK THEN
			GVL_MASTER.stMachineStatus.eMachineState := E_MachineState.FAULT;
		
		ELSIF NOT GVL_Master.i_bButtonStop THEN
            GVL_Master.stMachineStatus.eMachineState := E_MachineState.STOPPING;
 		END_IF
// 		
	E_MachineState.SYSTEM_READY_TO_START:
	    
		eMode_LED_Start := E_LEDs_Mode.FLASHING; // Start button must flash
        eMode_LED_Reset := E_LEDs_Mode.OFF;
		eMode_LED_PASS := E_LEDs_Mode.OFF;
		eMode_LED_Fail := E_LEDs_Mode.OFF;
		
		IF NOT GVL_Master.i_bButtonStop THEN
            GVL_Master.stMachineStatus.eMachineState := E_MachineState.STOPPING;
        ELSIF GVL_MASTER.i_bButtonStart AND bStartProcessCondition THEN
            GVL_Master.stMachineStatus.eMachineState := E_MachineState.SYSTEM_AUTO_CYCLE;
		ELSIF  NOT GVL_IO.stSafety.bSafetyOK THEN
			GVL_Master.stMachineStatus.eMachineState := E_MachineState.FAULT;
        END_IF	
 
	E_MachineState.SYSTEM_AUTO_CYCLE:
	 
		eMode_LED_PASS := E_LEDs_Mode.ON;
		eMode_LED_Fail := E_LEDs_Mode.OFF;
        rtFirstAutoCycle(CLK := TRUE);
        tonFirstAutoCycle(IN := rtFirstAutoCycle.Q);
        
        IF NOT GVL_Master.i_bButtonStop THEN
            GVL_Master.stMachineStatus.eMachineState := E_MachineState.STOPPING;
        ELSIF GVL_Master.stMachineStatus.bFault OR NOT bStartProcessCondition OR NOT GVL_IO.stSafety.bSafetyOK THEN
            GVL_Master.stMachineStatus.eMachineState := E_MachineState.FAULT;
        END_IF
		
		
		
    E_MachineState.MANUAL_MODE:
		eMode_LED_Start := E_LEDs_Mode.OFF; // Start button must flash
        eMode_LED_Reset := E_LEDs_Mode.OFF;
		eMode_LED_PASS := E_LEDs_Mode.OFF;
		eMode_LED_Fail := E_LEDs_Mode.OFF;
   		
		IF  NOT GVL_IO.stSafety.bSafetyOK THEN
			GVL_Master.stMachineStatus.eMachineState := E_MachineState.FAULT;
        END_IF	

END_CASE

// =========================================================
// 3. GLOBAL FLAG MAPPING
// =========================================================
GVL_Master.stMachineStatus.bSystemPowerUp := (GVL_Master.stMachineStatus.eMachineState = E_MachineState.SYSTEM_POWER_UP);
GVL_Master.stMachineStatus.bInitialising  := (GVL_Master.stMachineStatus.eMachineState = E_MachineState.SYSTEM_INITIALISING);
GVL_Master.stMachineStatus.bStopped       := (GVL_Master.stMachineStatus.eMachineState = E_MachineState.STOPPED);
GVL_Master.stMachineStatus.bStopping      := (GVL_Master.stMachineStatus.eMachineState = E_MachineState.STOPPING);
GVL_Master.stMachineStatus.bAutoCycle     := (GVL_Master.stMachineStatus.eMachineState = E_MachineState.SYSTEM_AUTO_CYCLE);
GVL_Master.stMachineStatus.bFault         := (GVL_Master.stMachineStatus.eMachineState = E_MachineState.FAULT);
GVL_Master.stMachineStatus.bReadyToStart  := (GVL_Master.stMachineStatus.eMachineState = E_MachineState.SYSTEM_READY_TO_START);
GVL_Master.stMachineStatus.bManualMode    := (GVL_Master.stMachineStatus.eMachineState = E_MachineState.MANUAL_MODE);



// 5. METHOD POST-EXECUTION ROUTINE
// =================================================================================
// Pass the freshly calculated machine state into the Kistler hardware controller
M_KistlerControl(eCurrentState := GVL_MASTER.stMachineStatus.eMachineState);

// Map Kistler hardware feedbacks and update panel/HMI indicators
M_StatusMapping();
M_LEDsButtons();
M_NestTableControl();


]]></ST>
    </Implementation>
    <Method Name="M_GetCurrentPosition" Id="{5ad458d2-2562-4615-8d3c-a8c74f1cf84a}">
      <Declaration><![CDATA[METHOD M_GetCurrentPosition : E_NestPosition
VAR_INST
	iBinaryValue : BYTE;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// 1. Pack the 3 boolean sensors into a single numeric value (Byte) to simplify binary calculation
// Sensor_3 (Bit 2) | Sensor_2 (Bit 1) | Sensor_1 (Bit 0)
iBinaryValue.0 := GVL_MASTER.stNestTable.bNestPos_1_Sensor;
iBinaryValue.1 := GVL_MASTER.stNestTable.bNestPos_2_Sensor;
iBinaryValue.2 := GVL_MASTER.stNestTable.bNestPos_3_Sensor;

// 2. Evaluate the resulting decimal value from the binary combination and return the matching ENUM
CASE iBinaryValue OF
    1: M_GetCurrentPosition := E_NestPosition.POSITION_1; // Binary 001
    2: M_GetCurrentPosition := E_NestPosition.POSITION_2; // Binary 010
    3: M_GetCurrentPosition := E_NestPosition.POSITION_3; // Binary 011
    4: M_GetCurrentPosition := E_NestPosition.POSITION_4; // Binary 100
ELSE
    // Default fallback: If 000 or any unmapped pattern occurs (e.g., 111), the table might be misaligned or in motion
    M_GetCurrentPosition := E_NestPosition.UNKNOWN; 
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_KistlerControl" Id="{142f0c7b-5ff7-4bb2-a407-a7b85664501f}">
      <Declaration><![CDATA[METHOD PRIVATE M_KistlerControl : BOOL
VAR_INPUT
	eCurrentState : E_MachineState;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// =================================================================================
// KISTLER DYNAMIC COMMAND MAPPING
// =================================================================================
// If the system is stopping or in a fault condition, trigger the abort command
stKistler_CMD.bAbort := (eCurrentState = E_MachineState.STOPPING OR eCurrentState = E_MachineState.FAULT);

// Enable the press only when it is not in stopping or fault states
stKistler_CMD.bEnable := (eCurrentState <> E_MachineState.STOPPING AND eCurrentState <> E_MachineState.FAULT);

// Activate manual override operations only when the machine is in manual mode
stKistler_CMD.bManualMode := (eCurrentState = E_MachineState.MANUAL_MODE);

// =================================================================================
// COMPONENT RESET MANAGEMENT
// =================================================================================
// Toggle the hardware reset command based on the HMI/Panel button falling edge
fbResetTrigger(CLK := GVL_MASTER.i_bButtonReset);

	IF fbResetTrigger.Q THEN
		stKistler_CMD.bReset := TRUE;
	ELSE
		stKistler_CMD.bReset := FALSE;
	END_IF

// =================================================================================
// METHOD EXECUTION FEEDBACK (Return True)
// =================================================================================
// Returning TRUE confirms that the Kistler component commands were successfully processed

M_KistlerControl := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_LEDsButtons" Id="{a6680c49-408d-47a5-bfa3-499d1bfac7ad}">
      <Declaration><![CDATA[METHOD M_LEDsButtons : BOOL
VAR_INST
    // Static-like variables inside the method (Instantiated with the PRG)
    fbBlinker         : TON;
    bBlinkerPulse     : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// =================================================================
// 1. INTERNAL BLINKER GENERATOR
// =================================================================
fbBlinker(IN := NOT fbBlinker.Q, PT := T#500MS);
IF fbBlinker.Q THEN
    bBlinkerPulse := NOT bBlinkerPulse;
END_IF;

// =================================================================
// 2. PROCESS START LED HARDWARE OUTPUT
// =================================================================
CASE PRG_MachineControl.eMode_LED_Start OF
    E_LEDs_Mode.ON:
        PRG_MachineControl.q_bLED_Start := TRUE;
        
    E_LEDs_Mode.FLASHING:
        PRG_MachineControl.q_bLED_Start := bBlinkerPulse;
        
    E_LEDs_Mode.OFF:
        PRG_MachineControl.q_bLED_Start := FALSE;
END_CASE;

// =================================================================
// 3. PROCESS RESET LED HARDWARE OUTPUT
// =================================================================
CASE PRG_MachineControl.eMode_LED_Reset OF
    E_LEDs_Mode.ON:
        PRG_MachineControl.q_bLED_Reset := TRUE;
        
    E_LEDs_Mode.FLASHING:
        PRG_MachineControl.q_bLED_Reset := bBlinkerPulse;
        
    E_LEDs_Mode.OFF:
        PRG_MachineControl.q_bLED_Reset := FALSE;
END_CASE;
// =================================================================
// 4. PROCESS LED PASS HARDWARE OUTPUT
// =================================================================
CASE PRG_MachineControl.eMode_LED_Pass OF
    E_LEDs_Mode.ON:
        PRG_MachineControl.q_bLED_Pass := TRUE;
        
    E_LEDs_Mode.FLASHING:
        PRG_MachineControl.q_bLED_Pass := bBlinkerPulse;
        
    E_LEDs_Mode.OFF:
        PRG_MachineControl.q_bLED_Pass := FALSE;
END_CASE;

// =================================================================
// 4. PROCESS LED FAIL HARDWARE OUTPUT
// =================================================================
CASE PRG_MachineControl.eMode_LED_Fail OF
    E_LEDs_Mode.ON:
        PRG_MachineControl.q_bLED_Fail := TRUE;
        
    E_LEDs_Mode.FLASHING:
        PRG_MachineControl.q_bLED_Fail := bBlinkerPulse;
        
    E_LEDs_Mode.OFF:
        PRG_MachineControl.q_bLED_Fail := FALSE;
END_CASE;



M_LEDsButtons := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_NestTableControl" Id="{73045679-2a70-4e2a-a7bb-96539b2fce6a}">
      <Declaration><![CDATA[METHOD M_NestTableControl
VAR_INST
    rTrigTwoHands : R_TRIG; // Edge trigger to detect single press of the two-hand safety signal
	
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// =================================================================
// 1. EMERGENCY RESET AND GLOBAL INTERLOCK PROCESSING
// =================================================================
// Global asynchronous reset: Forces the system to IDLE and drops all outputs immediately
IF GVL_MASTER.i_bButtonReset OR NOT GVL_MASTER.i_bButtonStop THEN
    eNestState                              := E_NestState.IDLE;
    bSequenceToggle                         := FALSE; // Always restart from rotation step after reset
    GVL_MASTER.stNestTable.bNestStartCycle  := FALSE;
    GVL_MASTER.stNestTable.bNestInMotion    := FALSE;
    GVL_MASTER.stNestTable.qNestRotatePortA := FALSE;
    GVL_MASTER.stNestTable.qNestRotatePortB := FALSE;
    GVL_MASTER.stNestTable.qSupportExtend   := FALSE;
    GVL_MASTER.stNestTable.qSupportRetract  := TRUE;  // Safe home posture for elevator
    RETURN; // Abort remaining logic execution for this cycle
END_IF

// Global Safety Interlock: Force fault state immediately if air/safety is lost
IF NOT GVL_IO.stSafety.bSafetyOK THEN
    eNestState := E_NestState.FAULT;
END_IF

eCurrentNestPos := M_GetCurrentPosition();

// =================================================================
// 2. INPUT SIGNAL PROCESSING (TRIGGERS)
// =================================================================
// Evaluate positive edge of the safety-certified two-hand control
rTrigTwoHands(CLK := GVL_IO.stSafety.bTwoHandsSafe);
tTwoHandTargetTime := REAL_TO_TIME(rHmiTwoHandPresetTime);   // Convert the HMI float milliseconds value into PLC TIME data type
tTwoHandHoldTimer(IN := GVL_IO.stSafety.bTwoHandsSafe, PT := tTwoHandTargetTime); // Execute the verification timer tied to the physical two-hand safety input

// Trigger processing to allow automated cycle start from IDLE state
IF rTrigTwoHands.Q AND GVL_MASTER.bStations_Home AND GVL_IO.stSafety.bSafetyOK AND (eNestState = E_NestState.IDLE) THEN
     IF GVL_MASTER.stMachineStatus.bAutoCycle THEN
         GVL_MASTER.stNestTable.bNestInMotion := TRUE;
         eNestState                           := E_NestState.ROTATING_TABLE; // Start the automated cycle directly at rotation step
     END_IF
END_IF

// =================================================================
// 3. TIMERS EXECUTION (CYCLIC COUPLING TO MAIN PROGRAM INSTANCES)
// =================================================================
// Enchained timers execution pattern to generate an automated timeline for the TESTING state
tRotatingTableDelay(IN  := (eNestState = E_NestState.ROTATING_TABLE), PT := T#1S200MS);
tPortB_ResetDelay(IN    := (eNestState = E_NestState.STOP_TABLE), PT := T#1S);

// TESTING TIMELINE: 
// 1. Initial 100ms settling delay starts when entering TESTING state
tSupportRetractDelay(IN := (eNestState = E_NestState.TESTING), PT := T#100MS);
// 2. 2-Second lift holding duration executes after the initial pause finishes
tSupportExtendDelay(IN  := (eNestState = E_NestState.TESTING) AND tSupportRetractDelay.Q, PT := T#2S);

// =================================================================
// 4. NEST TABLE STATE MACHINE CONTROL (WITH INTERNAL INTERLOCKS)
// =================================================================
CASE GVL_Master.stMachineStatus.eMachineState OF    
    
    E_MachineState.SYSTEM_AUTO_CYCLE:
        
        CASE eNestState OF
        
            E_NestState.IDLE: 
                // Keep pneumatic rotation outputs off while waiting in standby
                GVL_MASTER.stNestTable.qNestRotatePortA    := FALSE;
                GVL_MASTER.stNestTable.qNestRotatePortB    := FALSE;
                GVL_MASTER.stNestTable.bNestInMotion       := FALSE;
                
                // Default standby posture: Keep elevator safely retracted/down
                GVL_MASTER.stNestTable.qSupportExtend      := FALSE;
                GVL_MASTER.stNestTable.qSupportRetract     := TRUE;
                
                // Initiate automated cycle via safety validation and two-hand control edge trigger
                IF GVL_IO.stSafety.bSafetyOK AND rTrigTwoHands.Q AND GVL_MASTER.stNestTable.bNestReadySensor AND GVL_MASTER.stNestTable.bNestLockedSensor THEN
                    eNestState                             := E_NestState.ROTATING_TABLE; // Move to State 2
                END_IF
        
            E_NestState.ROTATING_TABLE: // State 2: ROTATING TABLE
			
				GVL_MASTER.stNestTable.bNestInMotion   := TRUE;
                // Internal safety interlock: Abort if hand is released before the HMI verification timer expires
                IF NOT GVL_IO.stSafety.bTwoHandsSafe AND NOT tTwoHandHoldTimer.Q THEN
                    GVL_MASTER.stNestTable.qNestRotatePortA := FALSE; // Instantly cut advance air supply
                    GVL_MASTER.stNestTable.qNestRotatePortB := FALSE; // Avoid violent pneumatic counter-pressure mid-flight
                    eNestState                              := E_NestState.FAULT; // Abort to recovery state            
                ELSIF GVL_MASTER.stNestTable.bSupportRetracted THEN
                    GVL_MASTER.stNestTable.qNestRotatePortA := TRUE;  // Pressurize rotation advance chamber
                    GVL_MASTER.stNestTable.qNestRotatePortB := FALSE;

                    // Transition to stopping sequence once the physical rotation timer has elapsed
                    IF tRotatingTableDelay.Q AND GVL_MASTER.stNestTable.bNestCompletedSensor THEN
                        eNestState := E_NestState.STOP_TABLE; // Move to State 3
                    END_IF
                END_IF
        
            E_NestState.STOP_TABLE: // State 3: STOP TABLE
                GVL_MASTER.stNestTable.qNestRotatePortA := FALSE; // Cut advance air supply from Port A
                GVL_MASTER.stNestTable.qNestRotatePortB := TRUE;  // Pressurize Port B to relieve backpressure and reset mechanism
                    
                // Transition to lift testing once mechanism exhausting pulse is completed
                IF tPortB_ResetDelay.Q AND GVL_MASTER.stNestTable.bNestReadySensor 
					AND GVL_MASTER.stNestTable.bNestLockedSensor THEN
					
					GVL_MASTER.stNestTable.bNestInMotion   := FALSE;
                    GVL_MASTER.stNestTable.qNestRotatePortB := FALSE; 
                    eNestState                              := E_NestState.TESTING;  
                END_IF
        
            E_NestState.TESTING: // State 4: TESTING (Elevator Lift Sequence)
                // Safety verification: Ensure rotation valves are fully de-energized before raising the elevator
                IF GVL_MASTER.stNestTable.bNestReadySensor AND GVL_MASTER.stNestTable.bNestLockedSensor 
					AND NOT GVL_MASTER.stNestTable.bNestInMotion AND eCurrentNestPos<>E_NestPosition.Unknown THEN
                    
                    // PHASE 1: Initial stabilization pause (First 100ms)
                    IF NOT tSupportRetractDelay.Q THEN
                        GVL_MASTER.stNestTable.qSupportRetract := TRUE;
                        GVL_MASTER.stNestTable.qSupportExtend  := FALSE;
                        
                    // PHASE 2: Actuate and hold the elevator up (During the 2-second hold test)
                    ELSIF NOT tSupportExtendDelay.Q THEN
                        GVL_MASTER.stNestTable.qSupportRetract := FALSE;
                        GVL_MASTER.stNestTable.qSupportExtend  := TRUE; 
                        
                    // PHASE 3: Test time finished! Back the initial process
                    ELSE
                        GVL_MASTER.stNestTable.bNestInMotion   := FALSE; // Mark current automated cycle as successful
                        eNestState                             := E_NestState.IDLE; // Safely return to standby
                    END_IF
                ELSE
                    // Safe fallback: Generate critical fault if rotation outputs are active unexpectedly
                    eNestState := E_NestState.FAULT; 
                END_IF
        
            E_NestState.FAULT: // State 99: FAULT STATE (Emergency Stop or Air Loss)
                GVL_MASTER.stNestTable.qNestRotatePortA     := FALSE;
                GVL_MASTER.stNestTable.qNestRotatePortB     := TRUE;
                GVL_MASTER.stNestTable.bNestInMotion   		:= TRUE;
                // Failsafe posture: Force elevator down to relieve all mechanical stress
                GVL_MASTER.stNestTable.qSupportExtend       := FALSE;
                GVL_MASTER.stNestTable.qSupportRetract      := TRUE;
				//GVL_Master.stMachineStatus.eMachineState := E_MachineState.FAULT;
				IF rTrigTwoHands.CLK THEN
                 	GVL_MASTER.stNestTable.qNestRotatePortA     := TRUE;
                 	GVL_MASTER.stNestTable.qNestRotatePortB     := FALSE;
					GVL_MASTER.stNestTable.bNestInMotion   		:= FALSE;
                // Automatically clear fault and recover to standby when hardware safety is restored
                ELSIF GVL_IO.stSafety.bSafetyOK AND NOT GVL_Master.stMachineStatus.bFault 
					  AND  GVL_MASTER.stNestTable.bNestReadySensor AND eCurrentNestPos<>E_NestPosition.Unknown THEN
                    //eNestState := E_NestState.IDLE;
					eNestState := E_NestState.STOP_TABLE;
                END_IF
				

                
        END_CASE

    // =================================================================
    // FAULT 
    // =================================================================
	
	E_MachineState.FAULT:
	
	 // Keep pneumatic rotation outputs off while waiting in standby
    	GVL_MASTER.stNestTable.qNestRotatePortA    := FALSE;
        GVL_MASTER.stNestTable.qNestRotatePortB    := FALSE;
        GVL_MASTER.stNestTable.bNestInMotion       := FALSE;
                
        // Default standby posture: Keep elevator safely retracted/down
        GVL_MASTER.stNestTable.qSupportExtend      := FALSE;
        GVL_MASTER.stNestTable.qSupportRetract     := TRUE;
	
	    IF GVL_IO.stSafety.bSafetyOK AND NOT GVL_Master.stMachineStatus.bFault THEN
        	eNestState := E_NestState.IDLE;
        END_IF

	
	
    // =================================================================
    // MANUAL MODE 
    // =================================================================
    // E_MachineState.MANUAL_MODE:
    //     CASE eNestState OF
    //     
    //         E_NestState.IDLE: 
    //             GVL_MASTER.stNestTable.qNestRotatePortA    := FALSE;
    //             GVL_MASTER.stNestTable.qNestRotatePortB    := FALSE;
    //             GVL_MASTER.stNestTable.bNestInMotion       := FALSE;
    //             GVL_MASTER.stNestTable.qSupportExtend      := FALSE;
    //             GVL_MASTER.stNestTable.qSupportRetract     := TRUE;
    //     
    //         E_NestState.RETRACT_SUPPORT:
    //             IF NOT GVL_MASTER.stMachineStatus.bManualMode THEN
    //                 eNestState := E_NestState.IDLE;
    //             ELSE
    //                 GVL_MASTER.stNestTable.qSupportExtend  := FALSE;
    //                 GVL_MASTER.stNestTable.qSupportRetract := TRUE; 
    //                 IF tSupportRetractDelay.Q THEN
    //                     eNestState := E_NestState.ROTATING_TABLE; 
    //                 END_IF
    //             END_IF
    //     
    //         E_NestState.ROTATING_TABLE:
    //             IF NOT GVL_MASTER.stMachineStatus.bManualMode THEN
    //                 eNestState := E_NestState.IDLE;
    //             ELSIF NOT GVL_IO.stSafety.bTwoHandsSafe AND NOT tTwoHandHoldTimer.Q THEN
    //                 GVL_MASTER.stNestTable.qNestRotatePortA := FALSE; 
    //                 GVL_MASTER.stNestTable.qNestRotatePortB := FALSE;
    //                 eNestState                              := E_NestState.WRONG_POSITION; 
    //             ELSE
    //                 GVL_MASTER.stNestTable.qNestRotatePortA := TRUE;  
    //                 GVL_MASTER.stNestTable.qNestRotatePortB := FALSE;
    //                 IF tRotatingTableDelay.Q THEN
    //                     eNestState := E_NestState.STOP_TABLE; 
    //                 END_IF
    //             END_IF
    //     
    //         E_NestState.STOP_TABLE:
    //             IF NOT GVL_MASTER.stMachineStatus.bManualMode THEN
    //                 eNestState := E_NestState.IDLE;
    //             ELSE
    //                 GVL_MASTER.stNestTable.qNestRotatePortA := FALSE; 
    //                 GVL_MASTER.stNestTable.qNestRotatePortB := TRUE;  
    //                 IF tPortB_ResetDelay.Q THEN
    //                     GVL_MASTER.stNestTable.qNestRotatePortB := FALSE; 
    //                     bSequenceToggle                         := TRUE; 
    //                     eNestState                              := E_NestState.IDLE; 
    //                 END_IF
    //             END_IF
    //     
    //         E_NestState.EXTEND_SUPPORT:
    //             IF NOT GVL_MASTER.stMachineStatus.bManualMode THEN
    //                 eNestState := E_NestState.IDLE;
    //             ELSE
    //                 GVL_MASTER.stNestTable.qSupportRetract     := FALSE;
    //                 GVL_MASTER.stNestTable.qSupportExtend      := TRUE; 
    //                 IF tSupportExtendDelay.Q THEN
    //                     GVL_MASTER.stNestTable.qSupportExtend  := FALSE;
    //                     GVL_MASTER.stNestTable.qSupportRetract := TRUE; 
    //                     bSequenceToggle                        := FALSE; 
    //                     eNestState                             := E_NestState.IDLE; 
    //                 END_IF
    //             END_IF
    //             
    //     END_CASE
    
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_PreExecution" Id="{d5c5735d-f733-481f-9f83-00134f7ccc98}">
      <Declaration><![CDATA[METHOD PRIVATE M_PreExecution : BOOL
VAR

END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// =================================================================================
// SYSTEM TIMERS
// =================================================================================
// Update initialization and safety timers on every PLC scan cycle
tonSys_Init(IN := GVL_MASTER.stMachineStatus.bInitialising);
tonSys_InitTimeout(IN := GVL_MASTER.stMachineStatus.bInitialising);

// TwinSAFE circuit stabilization timer (10 seconds)
tonSafety(IN := (GVL_MASTER.stMachineStatus.eMachineState = E_MachineState.SAFETY), PT := T#10S);


fbStopTrigger(CLK := GVL_Master.i_bButtonStop);
bButtonStop := fbStopTrigger.Q;
// =================================================================================
// HMI MESSAGE CLEARING
// =================================================================================
// Clear old system messages if the machine is not actively in production
// Uses the proper ENUM namespace from your MASTER folder
IF GVL_MASTER.stMachineStatus.eMachineState <> E_MachineState.SYSTEM_AUTO_CYCLE THEN
    sMachineMessage := '';            
END_IF


// =================================================================================
// CRITICAL FAULT INTERLOCK (Watchdog)
// =================================================================================
// If Kistler hardware is NOT ready, force the state machine to FAULT immediately
// Exception: Do not override if the system is currently in SAFETY or POWER_UP
IF NOT GVL_MASTER.bKistlerSystemReady 
    AND GVL_MASTER.stMachineStatus.eMachineState <> E_MachineState.SAFETY 
    AND GVL_MASTER.stMachineStatus.eMachineState <> E_MachineState.SYSTEM_POWER_UP THEN
    
    GVL_MASTER.stMachineStatus.eMachineState := E_MachineState.FAULT;
END_IF


// =================================================================================
// START LEDs BUTTON OFF
// =================================================================================
eMode_LED_Start := E_LEDs_Mode.OFF;
eMode_LED_Reset := E_LEDs_Mode.OFF;

// =================================================================================
// METHOD EXECUTION FEEDBACK (Return True)
// =================================================================================
// Returning TRUE confirms the pre-execution routine completed successfully
M_PreExecution := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_ProcessCycle" Id="{e01c53ef-c471-4f56-958b-74875adab0b2}">
      <Declaration><![CDATA[METHOD M_ProcessCycle
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_StatusMapping" Id="{e76387c3-2b6b-4ab8-8e2c-031286cbd112}">
      <Declaration><![CDATA[METHOD PRIVATE M_StatusMapping : BOOL
VAR_INPUT



END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
// =================================================================================
// KISTLER TO GLOBAL STATUS MAPPING
// =================================================================================
// Link the software/hardware safety loop to the machine status structure
GVL_MASTER.stMachineStatus.bSafety := GVL_IO.stSafety.bSystemSafeOK;

// Map the local Kistler hardware ready flag to our main control variable
bKistlerReady := stKistler_Status.bReady;

// Update the global machine fault status if the Kistler press enters an error state
IF stKistler_Status.bError THEN
	GVL_MASTER.stMachineStatus.bFault := TRUE;
END_IF

// =================================================================================
// HMI / PANEL LAMP SIGNALLING MANAGEMENT
// =================================================================================
// Control the Start Button Lamp feedback based on machine state
IF GVL_MASTER.stMachineStatus.eMachineState = E_MachineState.STOPPED AND bKistlerReady THEN
    GVL_MASTER.bStartButtonLamp := GVL_MASTER.bBlink_1Hz; // Uses standard 1Hz global clock bit
ELSIF GVL_MASTER.stMachineStatus.eMachineState = E_MachineState.SYSTEM_AUTO_CYCLE THEN
    GVL_MASTER.bStartButtonLamp := TRUE;
ELSE
    GVL_MASTER.bStartButtonLamp := FALSE;
END_IF
// =================================================================================
// METHOD EXECUTION FEEDBACK (Return True)
// =================================================================================
// Returning TRUE confirms that the status mapping routine executed successfully
M_StatusMapping := TRUE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>