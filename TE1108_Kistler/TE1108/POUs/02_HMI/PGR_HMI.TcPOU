<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="PGR_HMI" Id="{8c3348d2-2e4f-488f-b8d2-fe29da512452}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM PGR_HMI
VAR
    // =========================================================================
    // SYSTEM & SYSTEM TIME MANAGEMENT
    // =========================================================================
    fbLocalTime         : FB_LocalSystemTime; // Fetches the local NT system time
    sTimeReal           : STRING;             // Formatted real-time string (HH:MM:SS)
    sDateReal           : STRING;             // Formatted real-date string (YYYY-MM-DD)
    sCurrentTimeStr     : STRING;             // General purpose timestamp string

    // =========================================================================
    // HMI BLINK & VISUAL FLASHING LOGIC
    // =========================================================================
    bFlash              : BOOL;               // Toggling bit for HMI flashing elements
    fbBlinkTimer        : TON;                // Timer driving the flashing pulse
    bBlinkTimer_Q_Old   : BOOL;               // Edge detection auxiliary bit for the timer

    // =========================================================================
    // IPC POWER CONTROL (REBOOT & SHUTDOWN)
    // =========================================================================
   // ePowerCmd           : E_PLC_Power := E_PLC_Power.Idle; // Command received from HMI
    fbReboot            : NT_Reboot;          // Operating system reboot execution block
    fbShutdown          : NT_Shutdown;        // Operating system shutdown execution block
	fbKillEdge 			: NT_StartProcess;    // close HMI
    tonRebootDelay      : TON;                // 30-second delay timer before rebooting
    bTriggerReboot      : BOOL;               // Internal trigger for fbReboot
    bTriggerShutdown    : BOOL;               // Internal trigger for fbShutdown
	bTriggerExitHMI     : BOOL;               // Internal trigger for fbShutdown
	bErrorOut : BOOL;
	nErrIDOut : UDINT;
	tonPowerDelay       : TON;     // Timer unificado de 60 segundos para Reboot/Shutdown
	iCountdownValue     : INT;     // Valor regressivo (60 a 0) enviado para a IHM
	

    // =========================================================================
    // TESTING & ALARM SIMULATION
    // =========================================================================
    bTriggerTestAlarm   : BOOL;               // Force TRUE online to simulate a HMI alarm
    fbTestAlarmTrigger  : R_TRIG;             // Rising edge detector for the test alarm
    bResetTest          : BOOL;               // Reset command for test sequences

    // =========================================================================
    // BUFFER / TABLE ARRAYS INDEXES
    // =========================================================================
    i                   : DINT;               // Generic loop index iterator
    n                   : DINT;               // Specific table data index pointer
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =================================================================
// RUN GENERATOR CLOCK IN MAIN PROGRAM BODY
// =================================================================
fbBlinkTimer(IN := NOT fbBlinkTimer.Q, PT := T#500MS);

IF fbBlinkTimer.Q AND NOT bBlinkTimer_Q_Old THEN
	GVL_MASTER.bBlink_1Hz := NOT GVL_MASTER.bBlink_1Hz;
END_IF
bBlinkTimer_Q_Old := fbBlinkTimer.Q;

// =================================================================
// REFRESH LOCAL SYSTEM TIME & FORMAT STRINGS (O que faltava aqui!)
// =================================================================
fbLocalTime(bEnable := TRUE); // Executa o bloco para ler a hora do Windows

IF fbLocalTime.bValid THEN
	
	// --- FORMATAÇÃO DA HORA (sTimeReal) ---
	IF fbLocalTime.systemTime.wHour < 10 THEN
		sTimeReal := CONCAT('0', WORD_TO_STRING(fbLocalTime.systemTime.wHour));
	ELSE
		sTimeReal := WORD_TO_STRING(fbLocalTime.systemTime.wHour);
	END_IF
	
	sTimeReal := CONCAT(sTimeReal, ':');
	
	IF fbLocalTime.systemTime.wMinute < 10 THEN
		sTimeReal := CONCAT(sTimeReal, CONCAT('0', WORD_TO_STRING(fbLocalTime.systemTime.wMinute)));
	ELSE
		sTimeReal := CONCAT(sTimeReal, WORD_TO_STRING(fbLocalTime.systemTime.wMinute));
	END_IF
	
	// --- FORMATAÇÃO DA DATA (sCurrentTimeStr) ---
	IF fbLocalTime.systemTime.wDay < 10 THEN
		sCurrentTimeStr := CONCAT('0', WORD_TO_STRING(fbLocalTime.systemTime.wDay));
	ELSE
		sCurrentTimeStr := WORD_TO_STRING(fbLocalTime.systemTime.wDay);
	END_IF
	
	sCurrentTimeStr := CONCAT(sCurrentTimeStr, '/');
	
	IF fbLocalTime.systemTime.wMonth < 10 THEN
		sCurrentTimeStr := CONCAT(sCurrentTimeStr, CONCAT('0', WORD_TO_STRING(fbLocalTime.systemTime.wMonth)));
	ELSE
		sCurrentTimeStr := CONCAT(sCurrentTimeStr, WORD_TO_STRING(fbLocalTime.systemTime.wMonth));
	END_IF
	
	sCurrentTimeStr := CONCAT(sCurrentTimeStr, '/');
	sCurrentTimeStr := CONCAT(sCurrentTimeStr, WORD_TO_STRING(fbLocalTime.systemTime.wYear));

END_IF

// =================================================================
// ALARM TRIGGER TEST BLOCK (EDGE DETECTION)
// =================================================================
fbTestAlarmTrigger(CLK := bTriggerTestAlarm);

IF fbTestAlarmTrigger.Q THEN
	// Agora as strings sTimeReal e sCurrentTimeStr já possuem valor real!
	M_AddLogToHistory(
		sTime		:= sTimeReal,
		sType 		:= E_Alarms.FAULT,
		sDate		:= sCurrentTimeStr, 
		abType		:= E_Alarms.FAULT,
		nEventId	:= 3001,
		sMessage	:= 'Error feio'
	);
		M_AddLogToHistory(
		sTime		:= sTimeReal,
		sType 		:= E_Alarms.Cycle_Stop_Fault,
		sDate		:= sCurrentTimeStr, 
		abType		:= E_Alarms.FAULT,
		nEventId	:= 3001,
		sMessage	:= 'Error feio'
	);
		M_AddLogToHistory(
		sTime		:= sTimeReal,
		sType 		:= E_Alarms.Cycle_Stop_Request,
		sDate		:= sCurrentTimeStr, 
		abType		:= 2,
		nEventId	:= 3001,
		sMessage	:= 'Error feio'
		
		);
		M_AddLogToHistory(
		sTime		:= sTimeReal,
		sType 		:= E_Alarms.MESSAGE,
		sDate		:= sCurrentTimeStr, 
		abType		:= 3,
		nEventId	:= 3001,
		sMessage	:= 'Error feio'
	);
END_IF

// =================================================================
// NOW CALL THE METHOD TO PROCESS STRINGS AND HMI COLORS
// =================================================================
M_StatusHMI();
M_PLC_Power();]]></ST>
    </Implementation>
    <Method Name="M_AddLogToHistory" Id="{4a7a2891-da8e-4224-86d0-f95767bff40e}">
      <Declaration><![CDATA[METHOD M_AddLogToHistory
VAR_INPUT
	sTime		: STRING(255);
	sType		: E_Alarms;
	sDate		: STRING(255);
	abType		: DINT;	
	nEventId	: INT;
	sMessage	: STRING(255);
END_VAR
VAR
	i           : INT; // Loop index variable for shifting
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// 1. Cascade existing array rows downward to create an empty slot at index [1]
FOR i := 100 TO 2 BY -1 DO
	GVL_HMI.arrAlarmHistory[i] := GVL_HMI.arrAlarmHistory[i - 1];
END_FOR

// 2. Inject the newest event block directly into the primary top row
GVL_HMI.arrAlarmHistory[1].sTime     := sTime;
GVL_HMI.arrAlarmHistory[1].sType     := sType;
GVL_HMI.arrAlarmHistory[1].sDate     := sDate;
GVL_HMI.arrAlarmHistory[1].abType    := abType;
GVL_HMI.arrAlarmHistory[1].nEventId  := nEventId;
GVL_HMI.arrAlarmHistory[1].sMessage  := sMessage;
// 
// // 3. Drive high-priority alert strings and colors onto the main overhead header banner
// IF eSeverity >= E_Alarms.ERROR THEN
// 	GVL_HMI.StatusHMI.sMachineStatusText := sMessage;      // Texto central do Banner
// 	GVL_HMI.StatusHMI.sBannerBckColor   := '#FF0000';     // Fundo Vermelho para Erros/Críticos
// 	GVL_HMI.StatusHMI.sBannerTextColor   := '#FFFFFF';     // Texto Branco para dar contraste
// ELSIF eSeverity = E_Alarms.WARNING THEN
// 	GVL_HMI.StatusHMI.sMachineStatusText := sMessage;
// 	GVL_HMI.StatusHMI.sBannerBckColor   := '#FF8C00';     // Fundo Laranja para Avisos
// 	GVL_HMI.StatusHMI.sBannerTextColor   := '#FFFFFF';
// END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_PLC_Power" Id="{d4177770-942e-42eb-bf27-e25710b83a0d}">
      <Declaration><![CDATA[METHOD M_PLC_Power
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// =========================================================================
// 1. TIMER CONFIGURATION (Dynamic PT based on Command)
// =========================================================================
// Define the preset time (PT) dynamically depending on the selected action
IF GVL_HMI.ePowerCmd = E_PLC_Power.Reboot THEN
    tonPowerDelay.PT := T#15S;
ELSIF GVL_HMI.ePowerCmd = E_PLC_Power.Shutdown THEN
    tonPowerDelay.PT := T#60S;
END_IF

// Call the timer block first so it updates its Elapsed Time (.ET)
tonPowerDelay(
    IN := (GVL_HMI.ePowerCmd = E_PLC_Power.Reboot OR GVL_HMI.ePowerCmd = E_PLC_Power.Shutdown)
);

// Calculate countdown value for HMI visualization after the timer execution
IF tonPowerDelay.IN THEN
    IF GVL_HMI.ePowerCmd = E_PLC_Power.Shutdown THEN
        iCountdownValue := DINT_TO_INT(60 - (TIME_TO_DINT(tonPowerDelay.ET) / 1000));
    ELSIF GVL_HMI.ePowerCmd = E_PLC_Power.Reboot THEN
        iCountdownValue := DINT_TO_INT(15 - (TIME_TO_DINT(tonPowerDelay.ET) / 1000));
    END_IF
ELSE 
    iCountdownValue := 60; // Default state idle value
END_IF
// =========================================================================
// 2. STATE MACHINE WITH CANCEL FUNCTIONALITY
// =========================================================================
CASE GVL_HMI.ePowerCmd OF
    
    E_PLC_Power.Idle:
        bTriggerReboot   := FALSE;
        bTriggerShutdown := FALSE;

    E_PLC_Power.Reboot:
        // Triggers the reboot block ONLY after the 60 seconds expire
        IF tonPowerDelay.Q THEN
            bTriggerReboot := TRUE;
        END_IF

    E_PLC_Power.Shutdown:
        // Triggers the shutdown block ONLY after the 60 seconds expire
        IF tonPowerDelay.Q THEN
            bTriggerShutdown := TRUE;
        END_IF
// 	E_PLC_Power.ExitHMI:
//             bTriggerExitHMI := TRUE;


    E_PLC_Power.Cancel:
        // Safe abortion: clears all triggers and forces state back to Idle immediately
        bTriggerReboot    := FALSE;
        bTriggerShutdown  := FALSE;
        GVL_HMI.ePowerCmd := E_PLC_Power.Idle;

END_CASE

// =========================================================================
// 3. HARDWARE & OS BLOCK EXECUTION (ADS COMMANDS)
// =========================================================================
fbReboot(
    NETID := '',
    START := bTriggerReboot,
    TMOUT := DEFAULT_ADS_TIMEOUT
);

fbShutdown(
    NETID := '',
    START := bTriggerShutdown,
    TMOUT := DEFAULT_ADS_TIMEOUT
);

// fbKillEdge(
//     NETID:= '',
//     PATHSTR:= 'C:\Windows\System32\taskkill.exe',
//     COMNDLINE:= '/F /IM msedge.exe /T', // <--- Corrigido para msedge.exe com "e"
//     START:= (GVL_HMI.ePowerCmd = E_PLC_Power.ExitHMI),
//     TMOUT:= DEFAULT_ADS_TIMEOUT
// );
// =========================================================================
// 4. CLEAN & SAFE RESET
// =========================================================================
IF fbReboot.BUSY OR fbReboot.ERR THEN
    bTriggerReboot    := FALSE;
    GVL_HMI.ePowerCmd := E_PLC_Power.Idle;
END_IF

IF fbShutdown.BUSY OR fbShutdown.ERR THEN
    bTriggerShutdown  := FALSE;
    GVL_HMI.ePowerCmd := E_PLC_Power.Idle;
END_IF

// IF fbKillEdge.BUSY OR fbKillEdge.ERR THEN
// 	bTriggerExitHMI  := FALSE;
//     GVL_HMI.ePowerCmd := E_PLC_Power.Idle;
// END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_StatusHMI" Id="{6ed5e17f-430e-4297-ba97-996934b423b4}">
      <Declaration><![CDATA[METHOD M_StatusHMI : BOOL
VAR
// sGreen				:STRING := '{"color":"rgba(0, 180, 0, 1)"}';	
// sREd				:STRING := '{"color":"rgba(255, 0, 0, 1)"}';    
// sWhite				:STRING := '{"color":"rgba(255, 255, 255, 1)"}';
// sBlack				:STRING := '{"color":"rgba(0, 0, 0, 1)"}';
// sGrey				:STRING := '{"color":"rgba(128, 128, 128, 1)"}';
// sYellow				:STRING := '{"color":"rgba(255, 255, 0, 1)"}';
// sTransparent		:STRING := '{"color":"rgba(0, 0, 0, 0)"}'; 

END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
bFlash := GVL_MASTER.bBlink_1Hz;



CASE GVL_MASTER.stMachineStatus.eMachineState OF

    E_MachineState.SYSTEM_INITIALISING:
        GVL_HMI.StatusHMI.sMachineStatusText := 'SYSTEM INITIALIZING';        
        GVL_HMI.StatusHMI.sBannerBckColor    := GVL_HMI.sYELLOW; 
        GVL_HMI.StatusHMI.sBannerTextColor   := GVL_HMI.sBLACK;

    E_MachineState.SYSTEM_READY_TO_START:
        GVL_HMI.StatusHMI.sMachineStatusText := 'SYSTEM READY TO START';        
        IF bFlash THEN
            GVL_HMI.StatusHMI.sBannerBckColor  := GVL_HMI.sGREEN;
            GVL_HMI.StatusHMI.sBannerTextColor := GVL_HMI.sWHITE;
        ELSE    
            GVL_HMI.StatusHMI.sBannerBckColor  := GVL_HMI.sWHITE;
            GVL_HMI.StatusHMI.sBannerTextColor := GVL_HMI.sGREEN;
        END_IF

    E_MachineState.SYSTEM_AUTO_CYCLE:
        GVL_HMI.StatusHMI.sMachineStatusText := 'SYSTEM AUTO CYCLE';        
        GVL_HMI.StatusHMI.sBannerBckColor    := GVL_HMI.sGREEN;
        GVL_HMI.StatusHMI.sBannerTextColor   := GVL_HMI.sWHITE; 

    E_MachineState.STOPPING:
        GVL_HMI.StatusHMI.sMachineStatusText := 'STOPPING';        
        IF bFlash THEN    
            GVL_HMI.StatusHMI.sBannerBckColor  := GVL_HMI.sGREY;
            GVL_HMI.StatusHMI.sBannerTextColor := GVL_HMI.sWHITE;    
        ELSE    
            GVL_HMI.StatusHMI.sBannerBckColor  := GVL_HMI.sTRANSP;
            GVL_HMI.StatusHMI.sBannerTextColor := GVL_HMI.sBLACK;     
        END_IF

    E_MachineState.STOPPED:
        GVL_HMI.StatusHMI.sMachineStatusText := 'CYCLE STOPPED';        
        GVL_HMI.StatusHMI.sBannerBckColor    := GVL_HMI.sGREY;
        GVL_HMI.StatusHMI.sBannerTextColor   := GVL_HMI.sWHITE;    

    E_MachineState.FAULT:
        GVL_HMI.StatusHMI.sMachineStatusText := 'IMMEDIATE FAULT';        
        IF bFlash THEN    
            GVL_HMI.StatusHMI.sBannerBckColor  := GVL_HMI.sREDFail;
            GVL_HMI.StatusHMI.sBannerTextColor := GVL_HMI.sWHITE;   
        ELSE    
            GVL_HMI.StatusHMI.sBannerBckColor  := GVL_HMI.sWHITE;
            GVL_HMI.StatusHMI.sBannerTextColor := GVL_HMI.sREDFail;
        END_IF
	E_MachineState.MANUAL_MODE:
        GVL_HMI.StatusHMI.sMachineStatusText := 'MANUAL MODE';        
        GVL_HMI.StatusHMI.sBannerBckColor  := GVL_HMI.sBLUEInProgress;
        GVL_HMI.StatusHMI.sBannerTextColor := GVL_HMI.sWHITE;   


END_CASE


M_StatusHMI := TRUE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>