<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="PGR_HMI" Id="{8c3348d2-2e4f-488f-b8d2-fe29da512452}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM PGR_HMI
VAR
	bResetTest			: BOOL;
	i					: DINT;
	n					: DINT; // TABLE INDEX
	
	bFlash				: BOOL;
	fbBlinkTimer		: TON; 
	bBlinkTimer_Q_Old	: BOOL; 
	
	sCurrentTimeStr		: STRING; // Static timestamp for testing
	

	bTriggerTestAlarm	: BOOL;    // Force esta variável para TRUE online para simular o alarme
	fbTestAlarmTrigger	: R_TRIG; 
	fbLocalTime 		: FB_LocalSystemTime;
	sTimeReal           : STRING;
    sDateReal           : STRING;

END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =================================================================
// RUN GENERATOR CLOCK IN MAIN PROGRAM BODY
// =================================================================
fbBlinkTimer(IN := NOT fbBlinkTimer.Q, PT := T#500MS);

IF fbBlinkTimer.Q AND NOT bBlinkTimer_Q_Old THEN
	GVL_MASTER.bBlink_1Hz := NOT GVL_MASTER.bBlink_1Hz;
END_IF
bBlinkTimer_Q_Old := fbBlinkTimer.Q;

// =================================================================
// REFRESH LOCAL SYSTEM TIME & FORMAT STRINGS (O que faltava aqui!)
// =================================================================
fbLocalTime(bEnable := TRUE); // Executa o bloco para ler a hora do Windows

IF fbLocalTime.bValid THEN
	
	// --- FORMATAÇÃO DA HORA (sTimeReal) ---
	IF fbLocalTime.systemTime.wHour < 10 THEN
		sTimeReal := CONCAT('0', WORD_TO_STRING(fbLocalTime.systemTime.wHour));
	ELSE
		sTimeReal := WORD_TO_STRING(fbLocalTime.systemTime.wHour);
	END_IF
	
	sTimeReal := CONCAT(sTimeReal, ':');
	
	IF fbLocalTime.systemTime.wMinute < 10 THEN
		sTimeReal := CONCAT(sTimeReal, CONCAT('0', WORD_TO_STRING(fbLocalTime.systemTime.wMinute)));
	ELSE
		sTimeReal := CONCAT(sTimeReal, WORD_TO_STRING(fbLocalTime.systemTime.wMinute));
	END_IF
	
	// --- FORMATAÇÃO DA DATA (sCurrentTimeStr) ---
	IF fbLocalTime.systemTime.wDay < 10 THEN
		sCurrentTimeStr := CONCAT('0', WORD_TO_STRING(fbLocalTime.systemTime.wDay));
	ELSE
		sCurrentTimeStr := WORD_TO_STRING(fbLocalTime.systemTime.wDay);
	END_IF
	
	sCurrentTimeStr := CONCAT(sCurrentTimeStr, '/');
	
	IF fbLocalTime.systemTime.wMonth < 10 THEN
		sCurrentTimeStr := CONCAT(sCurrentTimeStr, CONCAT('0', WORD_TO_STRING(fbLocalTime.systemTime.wMonth)));
	ELSE
		sCurrentTimeStr := CONCAT(sCurrentTimeStr, WORD_TO_STRING(fbLocalTime.systemTime.wMonth));
	END_IF
	
	sCurrentTimeStr := CONCAT(sCurrentTimeStr, '/');
	sCurrentTimeStr := CONCAT(sCurrentTimeStr, WORD_TO_STRING(fbLocalTime.systemTime.wYear));

END_IF

// =================================================================
// ALARM TRIGGER TEST BLOCK (EDGE DETECTION)
// =================================================================
fbTestAlarmTrigger(CLK := bTriggerTestAlarm);

IF fbTestAlarmTrigger.Q THEN
	// Agora as strings sTimeReal e sCurrentTimeStr já possuem valor real!
	M_AddLogToHistory(
		sTime		:= sTimeReal,
		sType 		:= E_Alarms.FAULT,
		sDate		:= sCurrentTimeStr, 
		abType		:= E_Alarms.FAULT,
		nEventId	:= 3001,
		sMessage	:= 'Error feio'
	);
		M_AddLogToHistory(
		sTime		:= sTimeReal,
		sType 		:= E_Alarms.Cycle_Stop_Fault,
		sDate		:= sCurrentTimeStr, 
		abType		:= E_Alarms.FAULT,
		nEventId	:= 3001,
		sMessage	:= 'Error feio'
	);
		M_AddLogToHistory(
		sTime		:= sTimeReal,
		sType 		:= E_Alarms.Cycle_Stop_Request,
		sDate		:= sCurrentTimeStr, 
		abType		:= 2,
		nEventId	:= 3001,
		sMessage	:= 'Error feio'
		
		);
		M_AddLogToHistory(
		sTime		:= sTimeReal,
		sType 		:= E_Alarms.MESSAGE,
		sDate		:= sCurrentTimeStr, 
		abType		:= 3,
		nEventId	:= 3001,
		sMessage	:= 'Error feio'
	);
END_IF

// =================================================================
// NOW CALL THE METHOD TO PROCESS STRINGS AND HMI COLORS
// =================================================================
M_StatusHMI();]]></ST>
    </Implementation>
    <Method Name="M_AddLogToHistory" Id="{4a7a2891-da8e-4224-86d0-f95767bff40e}">
      <Declaration><![CDATA[METHOD M_AddLogToHistory
VAR_INPUT
	sTime		: STRING(255);
	sType		: E_Alarms;
	sDate		: STRING(255);
	abType		: DINT;	
	nEventId	: INT;
	sMessage	: STRING(255);
END_VAR
VAR
	i           : INT; // Loop index variable for shifting
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// 1. Cascade existing array rows downward to create an empty slot at index [1]
FOR i := 100 TO 2 BY -1 DO
	GVL_HMI.arrAlarmHistory[i] := GVL_HMI.arrAlarmHistory[i - 1];
END_FOR

// 2. Inject the newest event block directly into the primary top row
GVL_HMI.arrAlarmHistory[1].sTime     := sTime;
GVL_HMI.arrAlarmHistory[1].sType     := sType;
GVL_HMI.arrAlarmHistory[1].sDate     := sDate;
GVL_HMI.arrAlarmHistory[1].abType    := abType;
GVL_HMI.arrAlarmHistory[1].nEventId  := nEventId;
GVL_HMI.arrAlarmHistory[1].sMessage  := sMessage;
// 
// // 3. Drive high-priority alert strings and colors onto the main overhead header banner
// IF eSeverity >= E_Alarms.ERROR THEN
// 	GVL_HMI.StatusHMI.sMachineStatusText := sMessage;      // Texto central do Banner
// 	GVL_HMI.StatusHMI.sBannerBckColor   := '#FF0000';     // Fundo Vermelho para Erros/Críticos
// 	GVL_HMI.StatusHMI.sBannerTextColor   := '#FFFFFF';     // Texto Branco para dar contraste
// ELSIF eSeverity = E_Alarms.WARNING THEN
// 	GVL_HMI.StatusHMI.sMachineStatusText := sMessage;
// 	GVL_HMI.StatusHMI.sBannerBckColor   := '#FF8C00';     // Fundo Laranja para Avisos
// 	GVL_HMI.StatusHMI.sBannerTextColor   := '#FFFFFF';
// END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_StatusHMI" Id="{6ed5e17f-430e-4297-ba97-996934b423b4}">
      <Declaration><![CDATA[METHOD M_StatusHMI : BOOL
VAR
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
bFlash := GVL_MASTER.bBlink_1Hz;



CASE GVL_MASTER.stMachineStatus.eMachineState OF

    E_MachineState.SYSTEM_INITIALISING:
        GVL_HMI.StatusHMI.sMachineStatusText := 'SYSTEM INITIALIZING';        
        GVL_HMI.StatusHMI.sBannerBckColor    := '{"color":"rgba(255, 255, 0, 1)"}';   // Solid Yellow
        GVL_HMI.StatusHMI.sBannerTextColor   := '{"color":"rgba(0, 0, 0, 1)"}';       // Solid Black

    E_MachineState.SYSTEM_READY_TO_START:
        GVL_HMI.StatusHMI.sMachineStatusText := 'SYSTEM READY TO START';        
        IF bFlash THEN
            GVL_HMI.StatusHMI.sBannerBckColor  := '{"color":"rgba(0, 255, 0, 1)"}';   // Solid Green
            GVL_HMI.StatusHMI.sBannerTextColor := '{"color":"rgba(255, 255, 255, 1)"}'; // Solid White
        ELSE    
            GVL_HMI.StatusHMI.sBannerBckColor  := '{"color":"rgba(0, 0, 0, 0)"}';     // 100% TRANSPARENT
            GVL_HMI.StatusHMI.sBannerTextColor := '{"color":"rgba(0, 180, 0, 1)"}';   // Darker Green for readability
        END_IF

    E_MachineState.SYSTEM_AUTO_CYCLE:
        GVL_HMI.StatusHMI.sMachineStatusText := 'SYSTEM AUTO CYCLE';        
        GVL_HMI.StatusHMI.sBannerBckColor    := '{"color":"rgba(0, 255, 0, 1)"}';     // Solid Green
        GVL_HMI.StatusHMI.sBannerTextColor   := '{"color":"rgba(255, 255, 255, 1)"}';   // Solid White  

    E_MachineState.STOPPING:
        GVL_HMI.StatusHMI.sMachineStatusText := 'STOPPING';        
        IF bFlash THEN    
            GVL_HMI.StatusHMI.sBannerBckColor  := '{"color":"rgba(0, 0, 0, 1)"}';       // Solid Black
            GVL_HMI.StatusHMI.sBannerTextColor := '{"color":"rgba(255, 255, 255, 1)"}'; // Solid White    
        ELSE    
            GVL_HMI.StatusHMI.sBannerBckColor  := '{"color":"rgba(0, 0, 0, 0)"}';     // 100% TRANSPARENT
            GVL_HMI.StatusHMI.sBannerTextColor := '{"color":"rgba(0, 0, 0, 1)"}';       // Solid Black    
        END_IF

    E_MachineState.STOPPED:
        GVL_HMI.StatusHMI.sMachineStatusText := 'CYCLE STOPPED';        
        GVL_HMI.StatusHMI.sBannerBckColor    := '{"color":"rgba(128, 128, 128, 1)"}'; // Solid Industrial Grey
        GVL_HMI.StatusHMI.sBannerTextColor   := '{"color":"rgba(255, 255, 255, 1)"}'; // Solid White    

    E_MachineState.FAULT:
        GVL_HMI.StatusHMI.sMachineStatusText := 'IMMEDIATE FAULT';        
        IF bFlash THEN    
            GVL_HMI.StatusHMI.sBannerBckColor  := '{"color":"rgba(255, 0, 0, 1)"}';     // Solid Red
            GVL_HMI.StatusHMI.sBannerTextColor := '{"color":"rgba(255, 255, 255, 1)"}'; // Solid White    
        ELSE    
            GVL_HMI.StatusHMI.sBannerBckColor  := '{"color":"rgba(0, 0, 0, 0)"}';     // 100% TRANSPARENT
            GVL_HMI.StatusHMI.sBannerTextColor := '{"color":"rgba(255, 0, 0, 1)"}';     // Solid Red Text over screen background
        END_IF

END_CASE


M_StatusHMI := TRUE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>