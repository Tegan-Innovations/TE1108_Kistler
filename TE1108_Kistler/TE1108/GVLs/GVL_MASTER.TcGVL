<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <GVL Name="GVL_MASTER" Id="{051e26cb-59b3-4cfe-9e1f-b522d5330f72}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL
    // =================================================================================
    // MACHINE STATUS
    // =================================================================================
    stMachineStatus         		  : ST_MachineStatus; // Main machine state and flags structure

    // =================================================================================
    // HMI COMMANDS & SIGNALS
    // =================================================================================
    i_bButtonStart           AT%I*    : BOOL; //  Auto Cycle start button
    i_bButtonStop            AT%I*    : BOOL; //  cycle stop button
    i_bButtonReset           AT%I*    : BOOL; //  fault reset button
    i_bButtonEmergencyStop   AT%I*    : BOOL; //  software E-stop button
    
    bStartButtonLamp        		  : BOOL; // Physical start button lamp output
    bResetButtonLamp        		  : BOOL; // Physical reset button lamp output
    
    bBlink_1Hz              		  : BOOL; // 1Hz system clock flash bit
	
	// =================================================================
    // FESTO NEST TABLE INSTANCE
    // =================================================================
    stNestTable             		  : ST_NestTable;
	bStations_Home          		  : BOOL :=TRUE; // Interlock: All station tooling retracted
	
 
    // =================================================================================
    // INTERLOCKS & SAFETY
    // =================================================================================
    
    bAirSupply_Ok          		AT%I*	  : BOOL; // Main air supply pressure switch feedback
    
    // =================================================================================
    // HARDWARE STATUS
    // =================================================================================
    bKistlerSystemReady    			  : BOOL :=TRUE; // Kistler system global ready feedback
	
	 // =================================================================================
    // PROCESS VARIABLES 
    // =================================================================================
	eProcessCycleState 				  : E_ProcessCycle_State;
	stProcess 						  : ST_Process;
	bProcessBusy					  :BOOL;
	
	stSensors   					  : ST_Sensors;
	stActuators 					  : ST_Actuators;
	
	test 							  :INT;

	
	
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>