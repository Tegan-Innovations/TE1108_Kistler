<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <GVL Name="GVL_HMI" Id="{c67b6703-6204-460f-ac9e-cc67d35591bd}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL
	// HMI Status Banner structure for dynamic text and color mapping
	StatusHMI : ST_StatusBanner;
	arrAlarmHistory : ARRAY[1..100] OF ST_AlarmHistory;
	ePowerCmd : E_PLC_Power := E_PLC_Power.Idle;
	aKistlerNestResult : ARRAY[1..4] OF ST_HMIKistlerResult;
	
	// Data source used by the Statistics HMI DataGrid.
	aStatisticsHMI 							: ARRAY[1..1] OF ST_StatisticsHMI;

	
// =================================================================
//                         HMI COMMANDS 
// =================================================================
	
	i_bHMIManualModeRequest 			: BOOL := FALSE;
    i_bHMIIndexerManualEnable 			: BOOL := FALSE;
    i_bHMIKistlerManualEnable 			: BOOL := FALSE;

	iNestRotationAngle 					: INT;
	iNestPositionTesting 				: INT;
	rKistlerLiveDistance 				: REAL;
	rKistlerLiveForce    				: REAL;
	bShowRejectPopup 					: BOOL;
	
	bEnableSettings						: BOOL;
	bSetSettings						: BOOL := FALSE;
	bEnableManual						: BOOL;
	
	bHMIAlive							: BOOL;		
	bOutHMI 							: BOOL;
	bMainScreenActive 					: BOOL := FALSE; 
	
END_VAR	

VAR_GLOBAL CONSTANT
// =================================================================
//                         HMI COLORS 
// =================================================================

    sWHITE                              :   STRING(40)  := '{"color":"rgba(255,255,255,255)"}';
    sBLACK                              :   STRING(40)  := '{"color":"rgba(0,0,0,1)"}';
    sYELLOW                             :   STRING(40)  := '{"color":"rgba(255,255,0,1)"}';
    sGREEN                             	:   STRING(40)  := '{"color":"rgba(70,166,63,1)"}';
	sLGREEN                             :   STRING(40)  := '{"color":"rgba(58,211,20,1)"}';
    sORANGE                             :   STRING(40)  := '{"color":"rgba(255,153,51,1)"}';
    sNYPROORANGE                        :   STRING(40)  := '{"color":"rgba(255,140,0,1)"}';
    sRED                                :   STRING(40)  := '{"color":"rgba(255,0,0,1)"}';
	sLRED                               :   STRING(40)  := '{"color":"rgba(233,53,44,1)"}';
    sBLUE                               :   STRING(40)  := '{"color":"rgba(0,0,255,1)"}';
	sLBLUE                              :   STRING(40)  := '{"color":"rgba(0,162,232,1)"}';
    sGREY                               :   STRING(40)  := '{"color":"rgba(164,158,158,1)"}';
    sScreenGREY                         :   STRING(40)  := '{"color":"rgba(225,225,225,1)"}';
    sDARKGREY                           :   STRING(40)  := '{"color":"rgba(50,50,50,1)"}';
    sPURPLE                             :   STRING(40)  := '{"color":"rgba(128,0,128,1)"}';
    sVIOLET                             :   STRING(40)  := '{"color":"rgba(204,153,255,1)"}';
    sTRANSP                             :   STRING(40)  := '{"color":"rgba(255,255,255,0)"}';
    sGREENPass                          :   STRING(40)  := '{"color":"rgba(0,153,51,1)"}';
    sREDFail                            :   STRING(40)  := '{"color":"rgba(244,68,68,255)"}';
    sBLUEInProgress                     :   STRING(40)  := '{"color":"rgba(54,100,221,1)"}';
	sGREENISHTEAColor					:	STRING(40)  := '{"color":"rgba(60,192,134,255)"}'	;		

	nBLACK								: 	DWORD 	:= 	16#FF000000;	 // format: TTRRGGBB where T -> 00 = full transparency and FF = full opaque
	nWHITE								: 	DWORD 	:= 	16#FFFFFFFF;
	nYELLOW								: 	DWORD 	:= 	16#FFFFFF00; 
	nGREEN								: 	DWORD 	:= 	16#FF008A00;
	nLIGHTGREEN                         :   DWORD   :=  16#FF98FB89;
	nORANGE								: 	DWORD 	:= 	16#FFFFA500;
	nNYPROORANGE						:	DWORD	:=	16#FFF05322;
	nRED								: 	DWORD 	:= 	16#FFFF0000;
	nBLUE								: 	DWORD 	:= 	16#FF0000FF;
	nLIGHTBLUE                          :   DWORD   :=  16#FF08ADF4;
	nGREY								: 	DWORD 	:= 	16#FFA9A9A9;	
	nDARKGREY							:	DWORD	:=	16#FF808080;
	nPURPLE								:	DWORD	:=	16#FF800080;
	nVIOLET								:	DWORD	:=	16#FFEE82EE;
	nTRANSP								:	DWORD	:=	16#00FFFFFF;	// full transparent WHITE

// =================================================================
//                         SYSTEM INFO 
// =================================================================

	sSoftwareVersion					: STRING := ' v1.0.0-rc.2 ';
	sSoftwareDate						: STRING := '14/08/2026';
	sTC3Version							: STRING := ' v3.1.4026.22, Runtime v3.1.4026.22 ';
	sHMIVersion							: STRING := ' 14.13';
	sSystemName							: STRING := ' Kistler Machine ';
	sProjectID							: STRING := ' TE 1108' ;
	sAplication                     	: STRING := ' ';
	sHMIServer                			: STRING := ' 14.13 ';

END_VAR

	
VAR_GLOBAL PERSISTENT RETAIN

    stPuckLocker : ST_PuckLockerHMI := (
        eMode    := E_PuckLockerMode.Enabled,
        bEnabled := TRUE
    );
	
	aNestEnabled 						: ARRAY[1..4] OF BOOL :=
	[
		TRUE,
		TRUE,
		TRUE,
		TRUE
	];
	
	bSkipButton							: BOOL := FALSE;;
// =================================================================
// KISTLER STATISTICS
// =================================================================

udiKistlerTotalTested 					: UDINT := 0; // Total number of valid tests completed by the Kistler.
udiKistlerTotalPass 					: UDINT := 0;// Total number of parts classified as OK by the Kistler.
udiKistlerTotalFail 					: UDINT := 0;// Total number of parts classified as NOK by the Kistler.
bResetKistlerStatistics 				: BOOL := FALSE;// HMI command to reset the statistics.
iDataHistoryWriteIndex 					: INT := 1;
aDataHistoryHMI 						: ARRAY[1..2000] OF ST_DataHistoryHMI;


// =================================================================
// CSV DATA LOGGING
// =================================================================

// Stable copy of the completed Kistler test.
// The CSV logger will use this record instead of reading
// directly from the circular Data History buffer.
stCSVDataPending 						: ST_DataHistoryHMI;


// Request to save a new Data History record to CSV.
bCSVWriteRequest 						: BOOL := FALSE;


// CSV logger status.
bCSVBusy 				: BOOL := FALSE;
bCSVDone 				: BOOL := FALSE;
bCSVError 				: BOOL := FALSE;
nCSVErrorId 			: UDINT := 0;

END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>