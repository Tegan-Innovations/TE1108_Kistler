<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="ST_StatisticsHMI" Id="{9269f7df-e3d8-41e1-bf48-f4293c87343c}">
    <Declaration><![CDATA[TYPE ST_StatisticsHMI :
STRUCT

    
    udiTotalTested 				: UDINT;  // Total number of valid Kistler tests.
    udiGoodParts 				: UDINT;  // Total number of parts classified as OK.
    udiBadParts 				: UDINT; // Total number of parts classified as NOK.   
    rEfficiency 				: REAL; // Percentage of good parts.
    bReset 						: BOOL; // HMI command to reset all statistics.

END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>