<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="ST_EL1918" Id="{302ffd9b-15fa-4c1e-a32c-56ea245aa4ad}">
    <Declaration><![CDATA[TYPE ST_EL1918 :
STRUCT
    sTerminalName       	: STRING(80) := 'EL1889 | 8-Channel Digital Input 24V DC';
    
    // Physical hardware channels (Inputs 1 to 8)
    iEL1918_Ch1                		AT %I*			: 	BOOL;	// EL1918 channel 1
	iEL1918_Ch2                   	AT %I*			: 	BOOL;	// EL1918 channel 2
	iEL1918_Ch3        				AT %I*	 		: 	BOOL;	// EL1918 channel 3
	iEL1918_Ch4   					AT %I*	 		: 	BOOL;	// EL1918 channel 4
	iEL1918_Ch5         			AT %I*	 		: 	BOOL;	// EL1918 channel 5 		     			
	iEL1918_Ch6 					AT %I*			: 	BOOL;	// EL1918 channel 6
	iEL1918_Ch7               		AT %I*          :   BOOL;   // EL1918 channel 7 
    iEL1918_Ch8          			AT %I*          :   BOOL;   // EL1918 channel 8
    
    // Hardware status and diagnostic signals
    bError              	: BOOL; // TRUE if terminal detects a fault or communication error
    bReady              	: BOOL; // TRUE if terminal is operational and communicating properly
	
	stTerminalInfo			: 	ST_Terminal_Info;;
	
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>