<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="ST_EL2809_B" Id="{aa0ff1e0-ea4c-4014-b2bb-f382571aef12}">
    <Declaration><![CDATA[TYPE ST_EL2809_B :
STRUCT
    sTerminalName       	: STRING(80) := 'EL2809 | Channel Digital Output';
    
    // TwinSAFE physical hardware channels (Safe Outputs 1 to 4)
    iEL2809_Ch1        AT %Q*			: 	BOOL;	// EL1918 channel 1
	iEL2809_Ch2        AT %Q*			: 	BOOL;	// EL1918 channel 2
	iEL2809_Ch3        AT %Q*	 		: 	BOOL;	// EL1918 channel 3
	iEL2809_Ch4   	   AT %Q*	 		: 	BOOL;	// EL1918 channel 4
	iEL2809_Ch5        AT %Q*			: 	BOOL;	// EL1918 channel 5
	iEL2809_Ch6        AT %Q*			: 	BOOL;	// EL1918 channel 6
	iEL2809_Ch7        AT %Q*	 		: 	BOOL;	// EL1918 channel 7
	iEL2809_Ch8   	   AT %Q*	 		: 	BOOL;	// EL1918 channel 8
	iEL2809_Ch9        AT %Q*			: 	BOOL;	// EL1918 channel 9
	iEL2809_Ch10       AT %Q*			: 	BOOL;	// EL1918 channel 10
	iEL2809_Ch11       AT %Q*	 		: 	BOOL;	// EL1918 channel 11
	iEL2809_Ch12  	   AT %Q*	 		: 	BOOL;	// EL1918 channel 12
	iEL2809_Ch13       AT %Q*			: 	BOOL;	// EL1918 channel 13
	iEL2809_Ch14       AT %Q*			: 	BOOL;	// EL1918 channel 14
	iEL2809_Ch15       AT %Q*	 		: 	BOOL;	// EL1918 channel 15
	iEL2809_Ch16  	   AT %Q*	 		: 	BOOL;	// EL1918 channel 16
    
    // Hardware status and diagnostic signals
    bError              	: BOOL; // TRUE if a fault is detected (short-circuit, overload, or FSoE error)
    bReady              	: BOOL; // TRUE if terminal is active and TwinSAFE communication is OK
	
	stTerminalInfo			: 	ST_Terminal_Info;
	
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>